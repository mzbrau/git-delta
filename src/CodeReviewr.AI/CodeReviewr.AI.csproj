<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>CodeReviewr.AI</RootNamespace>
    <AssemblyName>CodeReviewr.AI</AssemblyName>
    <!-- GHCP001: GitHub.Copilot.Rpc.PermissionDecision is marked evaluation-only by the SDK; this
         is the SDK's own sanctioned way to return a permission decision from OnPermissionRequest. -->
    <NoWarn>$(NoWarn);GHCP001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CodeReviewr.AI.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodeReviewr.Core\CodeReviewr.Core.csproj" />
    <ProjectReference Include="..\CodeReviewr.Git\CodeReviewr.Git.csproj" />
    <ProjectReference Include="..\CodeReviewr.Diff\CodeReviewr.Diff.csproj" />
    <ProjectReference Include="..\CodeReviewr.GitHub\CodeReviewr.GitHub.csproj" />
    <ProjectReference Include="..\CodeReviewr.Review\CodeReviewr.Review.csproj" />
    <ProjectReference Include="..\CodeReviewr.Persistence\CodeReviewr.Persistence.csproj" />
    <PackageReference Include="GitHub.Copilot.SDK" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Prompts\**\*.md" />
  </ItemGroup>
</Project>
