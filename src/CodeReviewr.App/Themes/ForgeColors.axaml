<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <!-- Dark (Forge Control) -->
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="ForgeBackgroundColor">#0b1326</Color>
      <Color x:Key="ForgeSurfaceDimColor">#0b1326</Color>
      <Color x:Key="ForgeSurfaceBrightColor">#31394d</Color>
      <Color x:Key="ForgeSurfaceContainerLowestColor">#060e20</Color>
      <Color x:Key="ForgeSurfaceContainerLowColor">#131b2e</Color>
      <Color x:Key="ForgeSurfaceContainerColor">#171f33</Color>
      <Color x:Key="ForgeSurfaceContainerHighColor">#222a3d</Color>
      <Color x:Key="ForgeSurfaceContainerHighestColor">#2d3449</Color>
      <Color x:Key="ForgeSurfaceVariantColor">#2d3449</Color>
      <Color x:Key="ForgeOnSurfaceColor">#dae2fd</Color>
      <Color x:Key="ForgeOnSurfaceVariantColor">#c2c6d6</Color>
      <Color x:Key="ForgeOutlineColor">#8c909f</Color>
      <Color x:Key="ForgeOutlineVariantColor">#424754</Color>
      <Color x:Key="ForgePrimaryColor">#adc6ff</Color>
      <Color x:Key="ForgeOnPrimaryColor">#002e6a</Color>
      <Color x:Key="ForgePrimaryContainerColor">#4d8eff</Color>
      <Color x:Key="ForgeOnPrimaryContainerColor">#00285d</Color>
      <Color x:Key="ForgeSecondaryColor">#b7c8e1</Color>
      <Color x:Key="ForgeSecondaryContainerColor">#3a4a5f</Color>
      <Color x:Key="ForgeOnSecondaryContainerColor">#a9bad3</Color>
      <Color x:Key="ForgeErrorColor">#ffb4ab</Color>
      <Color x:Key="ForgeStatusAddedColor">#4ade80</Color>
      <Color x:Key="ForgeStatusDeletedColor">#f87171</Color>
      <Color x:Key="ForgeStatusModifiedColor">#fb923c</Color>
      <Color x:Key="ForgeStatusUntrackedColor">#c2c6d6</Color>
      <Color x:Key="ForgeDiffAddedFillColor">#2622c55e</Color>
      <Color x:Key="ForgeDiffRemovedFillColor">#26ef4444</Color>
      <Color x:Key="ForgeDiffSelectionFillColor">#40334866</Color>
      <Color x:Key="ForgeDiffHeaderFillColor">#282d3449</Color>
      <Color x:Key="ForgeDiffCollapsedFillColor">#148c909f</Color>
      <Color x:Key="ForgeDiffAddedTextColor">#bbf7d0</Color>
      <Color x:Key="ForgeDiffRemovedTextColor">#fecaca</Color>
      <Color x:Key="ForgeDiffGutterTextColor">#4Dc2c6d6</Color>
      <Color x:Key="ForgeBannerColor">#5c3b00</Color>
      <Color x:Key="ForgeSettingsScrimColor">#99060e20</Color>
      <Color x:Key="ForgeMinimapTrackColor">#1A8c909f</Color>
      <Color x:Key="ForgeMinimapViewportColor">#668c909f</Color>

      <SolidColorBrush x:Key="ForgeBackgroundBrush" Color="{StaticResource ForgeBackgroundColor}" />
      <SolidColorBrush x:Key="ForgeSurfaceContainerLowestBrush" Color="{StaticResource ForgeSurfaceContainerLowestColor}" />
      <SolidColorBrush x:Key="ForgeSurfaceContainerLowBrush" Color="{StaticResource ForgeSurfaceContainerLowColor}" />
      <SolidColorBrush x:Key="ForgeSurfaceContainerBrush" Color="{StaticResource ForgeSurfaceContainerColor}" />
      <SolidColorBrush x:Key="ForgeSurfaceContainerHighBrush" Color="{StaticResource ForgeSurfaceContainerHighColor}" />
      <SolidColorBrush x:Key="ForgeSurfaceContainerHighestBrush" Color="{StaticResource ForgeSurfaceContainerHighestColor}" />
      <SolidColorBrush x:Key="ForgeSurfaceVariantBrush" Color="{StaticResource ForgeSurfaceVariantColor}" />
      <SolidColorBrush x:Key="ForgeOnSurfaceBrush" Color="{StaticResource ForgeOnSurfaceColor}" />
      <SolidColorBrush x:Key="ForgeOnSurfaceVariantBrush" Color="{StaticResource ForgeOnSurfaceVariantColor}" />
      <SolidColorBrush x:Key="ForgeOutlineBrush" Color="{StaticResource ForgeOutlineColor}" />
      <SolidColorBrush x:Key="ForgeOutlineVariantBrush" Color="{StaticResource ForgeOutlineVariantColor}" />
      <SolidColorBrush x:Key="ForgePrimaryBrush" Color="{StaticResource ForgePrimaryColor}" />
      <SolidColorBrush x:Key="ForgeOnPrimaryBrush" Color="{StaticResource ForgeOnPrimaryColor}" />
      <SolidColorBrush x:Key="ForgePrimaryContainerBrush" Color="{StaticResource ForgePrimaryContainerColor}" />
      <SolidColorBrush x:Key="ForgeSecondaryContainerBrush" Color="{StaticResource ForgeSecondaryContainerColor}" />
      <SolidColorBrush x:Key="ForgeOnSecondaryContainerBrush" Color="{StaticResource ForgeOnSecondaryContainerColor}" />
      <SolidColorBrush x:Key="ForgeErrorBrush" Color="{StaticResource ForgeErrorColor}" />
      <SolidColorBrush x:Key="ForgeStatusAddedBrush" Color="{StaticResource ForgeStatusAddedColor}" />
      <SolidColorBrush x:Key="ForgeStatusDeletedBrush" Color="{StaticResource ForgeStatusDeletedColor}" />
      <SolidColorBrush x:Key="ForgeStatusModifiedBrush" Color="{StaticResource ForgeStatusModifiedColor}" />
      <SolidColorBrush x:Key="ForgeStatusUntrackedBrush" Color="{StaticResource ForgeStatusUntrackedColor}" />
      <SolidColorBrush x:Key="ForgeDiffAddedFillBrush" Color="{StaticResource ForgeDiffAddedFillColor}" />
      <SolidColorBrush x:Key="ForgeDiffRemovedFillBrush" Color="{StaticResource ForgeDiffRemovedFillColor}" />
      <SolidColorBrush x:Key="ForgeDiffSelectionFillBrush" Color="{StaticResource ForgeDiffSelectionFillColor}" />
      <SolidColorBrush x:Key="ForgeDiffHeaderFillBrush" Color="{StaticResource ForgeDiffHeaderFillColor}" />
      <SolidColorBrush x:Key="ForgeDiffCollapsedFillBrush" Color="{StaticResource ForgeDiffCollapsedFillColor}" />
      <SolidColorBrush x:Key="ForgeDiffAddedTextBrush" Color="{StaticResource ForgeDiffAddedTextColor}" />
      <SolidColorBrush x:Key="ForgeDiffRemovedTextBrush" Color="{StaticResource ForgeDiffRemovedTextColor}" />
      <SolidColorBrush x:Key="ForgeDiffGutterTextBrush" Color="{StaticResource ForgeDiffGutterTextColor}" />
      <SolidColorBrush x:Key="ForgeBannerBrush" Color="{StaticResource ForgeBannerColor}" />
      <SolidColorBrush x:Key="ForgeSettingsScrimBrush" Color="{StaticResource ForgeSettingsScrimColor}" />
      <SolidColorBrush x:Key="ForgeMinimapTrackBrush" Color="{StaticResource ForgeMinimapTrackColor}" />
      <SolidColorBrush x:Key="ForgeMinimapViewportBrush" Color="{StaticResource ForgeMinimapViewportColor}" />
      <SolidColorBrush x:Key="ForgeStatusAddedBadgeBgBrush" Color="#1A4ade80" />
      <SolidColorBrush x:Key="ForgeStatusDeletedBadgeBgBrush" Color="#1Af87171" />
      <SolidColorBrush x:Key="ForgeStatusModifiedBadgeBgBrush" Color="#1Afb923c" />
      <SolidColorBrush x:Key="ForgeStatusUntrackedBadgeBgBrush" Color="#2d3449" />
    </ResourceDictionary>

    <!-- Light -->
    <ResourceDictionary x:Key="Light">
      <Color x:Key="ForgeBackgroundColor">#f4f6fb</Color>
      <Color x:Key="ForgeSurfaceDimColor">#e8ecf4</Color>
      <Color x:Key="ForgeSurfaceBrightColor">#ffffff</Color>
      <Color x:Key="ForgeSurfaceContainerLowestColor">#ffffff</Color>
      <Color x:Key="ForgeSurfaceContainerLowColor">#eef1f8</Color>
      <Color x:Key="ForgeSurfaceContainerColor">#e4e9f2</Color>
      <Color x:Key="ForgeSurfaceContainerHighColor">#d8dee9</Color>
      <Color x:Key="ForgeSurfaceContainerHighestColor">#cdd3e0</Color>
      <Color x:Key="ForgeSurfaceVariantColor">#d8dee9</Color>
      <Color x:Key="ForgeOnSurfaceColor">#1a2336</Color>
      <Color x:Key="ForgeOnSurfaceVariantColor">#4a5568</Color>
      <Color x:Key="ForgeOutlineColor">#6b7385</Color>
      <Color x:Key="ForgeOutlineVariantColor">#c5cbd8</Color>
      <Color x:Key="ForgePrimaryColor">#2657c9</Color>
      <Color x:Key="ForgeOnPrimaryColor">#ffffff</Color>
      <Color x:Key="ForgePrimaryContainerColor">#4d8eff</Color>
      <Color x:Key="ForgeOnPrimaryContainerColor">#001a44</Color>
      <Color x:Key="ForgeSecondaryColor">#4a5d75</Color>
      <Color x:Key="ForgeSecondaryContainerColor">#d5e3f5</Color>
      <Color x:Key="ForgeOnSecondaryContainerColor">#2a3a4f</Color>
      <Color x:Key="ForgeErrorColor">#b3261e</Color>
      <Color x:Key="ForgeStatusAddedColor">#15803d</Color>
      <Color x:Key="ForgeStatusDeletedColor">#dc2626</Color>
      <Color x:Key="ForgeStatusModifiedColor">#c2410c</Color>
      <Color x:Key="ForgeStatusUntrackedColor">#64748b</Color>
      <Color x:Key="ForgeDiffAddedFillColor">#3322c55e</Color>
      <Color x:Key="ForgeDiffRemovedFillColor">#33ef4444</Color>
      <Color x:Key="ForgeDiffSelectionFillColor">#332657c9</Color>
      <Color x:Key="ForgeDiffHeaderFillColor">#22c5cbd8</Color>
      <Color x:Key="ForgeDiffCollapsedFillColor">#148c909f</Color>
      <Color x:Key="ForgeDiffAddedTextColor">#14532d</Color>
      <Color x:Key="ForgeDiffRemovedTextColor">#7f1d1d</Color>
      <Color x:Key="ForgeDiffGutterTextColor">#806b7385</Color>
      <Color x:Key="ForgeBannerColor">#fff3cd</Color>
      <Color x:Key="ForgeSettingsScrimColor">#660b1326</Color>
      <Color x:Key="ForgeMinimapTrackColor">#1A6b7385</Color>
      <Color x:Key="ForgeMinimapViewportColor">#666b7385</Color>

      <SolidColorBrush x:Key="ForgeBackgroundBrush" Color="{StaticResource ForgeBackgroundColor}" />
      <SolidColorBrush x:Key="ForgeSurfaceContainerLowestBrush" Color="{StaticResource ForgeSurfaceContainerLowestColor}" />
      <SolidColorBrush x:Key="ForgeSurfaceContainerLowBrush" Color="{StaticResource ForgeSurfaceContainerLowColor}" />
      <SolidColorBrush x:Key="ForgeSurfaceContainerBrush" Color="{StaticResource ForgeSurfaceContainerColor}" />
      <SolidColorBrush x:Key="ForgeSurfaceContainerHighBrush" Color="{StaticResource ForgeSurfaceContainerHighColor}" />
      <SolidColorBrush x:Key="ForgeSurfaceContainerHighestBrush" Color="{StaticResource ForgeSurfaceContainerHighestColor}" />
      <SolidColorBrush x:Key="ForgeSurfaceVariantBrush" Color="{StaticResource ForgeSurfaceVariantColor}" />
      <SolidColorBrush x:Key="ForgeOnSurfaceBrush" Color="{StaticResource ForgeOnSurfaceColor}" />
      <SolidColorBrush x:Key="ForgeOnSurfaceVariantBrush" Color="{StaticResource ForgeOnSurfaceVariantColor}" />
      <SolidColorBrush x:Key="ForgeOutlineBrush" Color="{StaticResource ForgeOutlineColor}" />
      <SolidColorBrush x:Key="ForgeOutlineVariantBrush" Color="{StaticResource ForgeOutlineVariantColor}" />
      <SolidColorBrush x:Key="ForgePrimaryBrush" Color="{StaticResource ForgePrimaryColor}" />
      <SolidColorBrush x:Key="ForgeOnPrimaryBrush" Color="{StaticResource ForgeOnPrimaryColor}" />
      <SolidColorBrush x:Key="ForgePrimaryContainerBrush" Color="{StaticResource ForgePrimaryContainerColor}" />
      <SolidColorBrush x:Key="ForgeSecondaryContainerBrush" Color="{StaticResource ForgeSecondaryContainerColor}" />
      <SolidColorBrush x:Key="ForgeOnSecondaryContainerBrush" Color="{StaticResource ForgeOnSecondaryContainerColor}" />
      <SolidColorBrush x:Key="ForgeErrorBrush" Color="{StaticResource ForgeErrorColor}" />
      <SolidColorBrush x:Key="ForgeStatusAddedBrush" Color="{StaticResource ForgeStatusAddedColor}" />
      <SolidColorBrush x:Key="ForgeStatusDeletedBrush" Color="{StaticResource ForgeStatusDeletedColor}" />
      <SolidColorBrush x:Key="ForgeStatusModifiedBrush" Color="{StaticResource ForgeStatusModifiedColor}" />
      <SolidColorBrush x:Key="ForgeStatusUntrackedBrush" Color="{StaticResource ForgeStatusUntrackedColor}" />
      <SolidColorBrush x:Key="ForgeDiffAddedFillBrush" Color="{StaticResource ForgeDiffAddedFillColor}" />
      <SolidColorBrush x:Key="ForgeDiffRemovedFillBrush" Color="{StaticResource ForgeDiffRemovedFillColor}" />
      <SolidColorBrush x:Key="ForgeDiffSelectionFillBrush" Color="{StaticResource ForgeDiffSelectionFillColor}" />
      <SolidColorBrush x:Key="ForgeDiffHeaderFillBrush" Color="{StaticResource ForgeDiffHeaderFillColor}" />
      <SolidColorBrush x:Key="ForgeDiffCollapsedFillBrush" Color="{StaticResource ForgeDiffCollapsedFillColor}" />
      <SolidColorBrush x:Key="ForgeDiffAddedTextBrush" Color="{StaticResource ForgeDiffAddedTextColor}" />
      <SolidColorBrush x:Key="ForgeDiffRemovedTextBrush" Color="{StaticResource ForgeDiffRemovedTextColor}" />
      <SolidColorBrush x:Key="ForgeDiffGutterTextBrush" Color="{StaticResource ForgeDiffGutterTextColor}" />
      <SolidColorBrush x:Key="ForgeBannerBrush" Color="{StaticResource ForgeBannerColor}" />
      <SolidColorBrush x:Key="ForgeSettingsScrimBrush" Color="{StaticResource ForgeSettingsScrimColor}" />
      <SolidColorBrush x:Key="ForgeMinimapTrackBrush" Color="{StaticResource ForgeMinimapTrackColor}" />
      <SolidColorBrush x:Key="ForgeMinimapViewportBrush" Color="{StaticResource ForgeMinimapViewportColor}" />
      <SolidColorBrush x:Key="ForgeStatusAddedBadgeBgBrush" Color="#1A15803d" />
      <SolidColorBrush x:Key="ForgeStatusDeletedBadgeBgBrush" Color="#1Adc2626" />
      <SolidColorBrush x:Key="ForgeStatusModifiedBadgeBgBrush" Color="#1Ac2410c" />
      <SolidColorBrush x:Key="ForgeStatusUntrackedBadgeBgBrush" Color="#d8dee9" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
