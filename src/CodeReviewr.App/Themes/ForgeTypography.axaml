<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="ForgeUiFont">Inter, sans-serif</FontFamily>
  <FontFamily x:Key="ForgeCodeFont">avares://CodeReviewr.App/Assets/Fonts/#JetBrains Mono</FontFamily>

  <x:Double x:Key="ForgeUiFontSize">13</x:Double>
  <x:Double x:Key="ForgeUiSmFontSize">11</x:Double>
  <x:Double x:Key="ForgeCodeFontSize">12</x:Double>
  <x:Double x:Key="ForgeBadgeFontSize">10</x:Double>
  <x:Double x:Key="ForgeSidebarHeaderFontSize">10</x:Double>
  <x:Double x:Key="ForgeSidebarHeaderLetterSpacing">0.8</x:Double>
</ResourceDictionary>
