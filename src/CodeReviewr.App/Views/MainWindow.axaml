<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CodeReviewr.App.ViewModels"
        xmlns:controls="using:CodeReviewr.App.Controls"
        xmlns:conv="using:CodeReviewr.App.Converters"
        xmlns:core="using:CodeReviewr.Core"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:svc="using:CodeReviewr.App.Services"
        x:Class="CodeReviewr.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="RootWindow"
        Title="Code Reviewr"
        Icon="/Assets/logo.png"
        Width="1280" Height="800"
        Background="{DynamicResource ForgeBackgroundBrush}">

  <Panel>
    <!-- Empty repository state -->
    <Border IsVisible="{Binding WorkingCopy.HasRepository, Converter={x:Static conv:ForgeConverters.InvertBool}}"
            Background="{DynamicResource ForgeBackgroundBrush}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" MaxWidth="420">
        <Image Source="/Assets/logo.png" Width="64" Height="64" HorizontalAlignment="Center" />
        <TextBlock Text="Code Reviewr" FontSize="28" FontWeight="Bold"
                   Foreground="{DynamicResource ForgePrimaryBrush}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Open a local Git repository to review changes."
                   Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}"
                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
        <Button Classes="Primary" Content="Open Repository…" Click="OnOpenRepository" Width="220"
                HorizontalAlignment="Center" />
        <StackPanel Spacing="4" IsVisible="{Binding HasRecentRepositories}" Margin="0,12,0,0">
          <TextBlock Text="RECENT" Classes="PanelHeader" Opacity="0.7" Margin="0,0,0,4" />
          <ItemsControl ItemsSource="{Binding RecentRepositories}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="Ghost" Content="{Binding}" Tag="{Binding}" Click="OnRecentClick"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        FontFamily="{DynamicResource ForgeCodeFont}" FontSize="12" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Main workspace -->
    <DockPanel IsVisible="{Binding WorkingCopy.HasRepository}">
      <!-- Top bar -->
      <Border DockPanel.Dock="Top" Height="48" Padding="8,0"
              Background="{DynamicResource ForgeBackgroundBrush}"
              BorderBrush="{DynamicResource ForgeOutlineVariantBrush}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Image Source="/Assets/logo.png" Width="22" Height="22" Margin="4,0,4,0"
                   VerticalAlignment="Center" />
            <TextBlock Text="Code Reviewr" FontWeight="SemiBold" FontSize="13"
                       Foreground="{DynamicResource ForgePrimaryBrush}"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Classes="Ghost" Command="{Binding WorkingCopy.PushCommand}"
                    IsEnabled="{Binding WorkingCopy.IsRemoteBusy, Converter={x:Static conv:ForgeConverters.InvertBool}}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <ProgressBar Width="16" Height="16" IsIndeterminate="True"
                             IsVisible="{Binding WorkingCopy.IsPushing}" />
                <icons:MaterialIcon Kind="Upload" Width="16" Height="16"
                                    IsVisible="{Binding WorkingCopy.IsPushing, Converter={x:Static conv:ForgeConverters.InvertBool}}" />
                <TextBlock Text="Push" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="Ghost" Command="{Binding WorkingCopy.PullCommand}"
                    IsEnabled="{Binding WorkingCopy.IsRemoteBusy, Converter={x:Static conv:ForgeConverters.InvertBool}}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <ProgressBar Width="16" Height="16" IsIndeterminate="True"
                             IsVisible="{Binding WorkingCopy.IsPulling}" />
                <icons:MaterialIcon Kind="Download" Width="16" Height="16"
                                    IsVisible="{Binding WorkingCopy.IsPulling, Converter={x:Static conv:ForgeConverters.InvertBool}}" />
                <TextBlock Text="Pull" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="Ghost" Command="{Binding WorkingCopy.FetchCommand}"
                    IsEnabled="{Binding WorkingCopy.IsRemoteBusy, Converter={x:Static conv:ForgeConverters.InvertBool}}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <ProgressBar Width="16" Height="16" IsIndeterminate="True"
                             IsVisible="{Binding WorkingCopy.IsFetching}" />
                <icons:MaterialIcon Kind="Sync" Width="16" Height="16"
                                    IsVisible="{Binding WorkingCopy.IsFetching, Converter={x:Static conv:ForgeConverters.InvertBool}}" />
                <TextBlock Text="Fetch" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Border Width="1" Height="16" Background="{DynamicResource ForgeOutlineVariantBrush}" Margin="8,0" />
            <Button Classes="Ghost" Command="{Binding WorkingCopy.StashAllChangesCommand}"
                    IsEnabled="{Binding WorkingCopy.IsRemoteBusy, Converter={x:Static conv:ForgeConverters.InvertBool}}"
                    ToolTip.Tip="Stash all changes including untracked files">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <ProgressBar Width="16" Height="16" IsIndeterminate="True"
                             IsVisible="{Binding WorkingCopy.IsStashing}" />
                <icons:MaterialIcon Kind="Archive" Width="16" Height="16"
                                    IsVisible="{Binding WorkingCopy.IsStashing, Converter={x:Static conv:ForgeConverters.InvertBool}}" />
                <TextBlock Text="Stash" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="Ghost" Command="{Binding WorkingCopy.ViewRemoteCommand}"
                    ToolTip.Tip="Open remote in browser">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <icons:MaterialIcon Kind="Web" Width="16" Height="16" />
                <TextBlock Text="View Remote" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="Ghost" Command="{Binding WorkingCopy.RevealRepositoryInFileManagerCommand}"
                    ToolTip.Tip="{Binding WorkingCopy.RevealInFileManagerLabel}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <icons:MaterialIcon Kind="FolderOpen" Width="16" Height="16" />
                <TextBlock Text="{Binding WorkingCopy.RevealInFileManagerLabel}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Border Width="1" Height="16" Background="{DynamicResource ForgeOutlineVariantBrush}" Margin="8,0" />
            <Button Classes="Ghost">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <icons:MaterialIcon Kind="SourceBranch" Width="16" Height="16" />
                <TextBlock Text="{Binding WorkingCopy.CurrentBranch}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
          <Button Grid.Column="1" Classes="IconOnly" Command="{Binding OpenSettingsCommand}"
                  VerticalAlignment="Center" ToolTip.Tip="Settings">
            <icons:MaterialIcon Kind="Settings" Width="18" Height="18" />
          </Button>
        </Grid>
      </Border>

      <!-- Status bar -->
      <Border DockPanel.Dock="Bottom" Height="24" Padding="12,0"
              Background="{DynamicResource ForgeSurfaceContainerBrush}"
              BorderBrush="{DynamicResource ForgeOutlineVariantBrush}"
              BorderThickness="0,1,0,0">
        <TextBlock Text="{Binding StatusText}" FontSize="10"
                   Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}"
                   VerticalAlignment="Center" />
      </Border>

      <!-- Git command console -->
      <Border DockPanel.Dock="Bottom"
              Background="{DynamicResource ForgeSurfaceContainerLowestBrush}"
              BorderBrush="{DynamicResource ForgeOutlineVariantBrush}"
              BorderThickness="0,1,0,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Height="28" Padding="8,0"
                  Background="{DynamicResource ForgeSurfaceContainerBrush}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                <Button Classes="Link" Content="Clear" Command="{Binding GitConsole.ClearCommand}" FontSize="11" />
                <Button Classes="Ghost" Padding="4" Command="{Binding GitConsole.ToggleExpandedCommand}">
                  <icons:MaterialIcon Kind="{Binding GitConsole.IsExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                      Width="14" Height="14" />
                </Button>
              </StackPanel>
              <Button Classes="Ghost" Padding="4,0" HorizontalAlignment="Left"
                      Command="{Binding GitConsole.ToggleExpandedCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <icons:MaterialIcon Kind="Console" Width="14" Height="14" />
                  <TextBlock Text="Git Output" FontSize="11" VerticalAlignment="Center"
                             Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                </StackPanel>
              </Button>
            </DockPanel>
          </Border>
          <Border Height="180" IsVisible="{Binding GitConsole.IsExpanded}" Padding="8,4">
            <ScrollViewer x:Name="GitConsoleScroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding GitConsole.Lines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GitConsoleLine">
                    <TextBlock Text="{Binding Text}"
                               FontFamily="{DynamicResource ForgeCodeFont}"
                               FontSize="11"
                               Foreground="{Binding Kind, Converter={x:Static conv:ForgeConverters.GitConsoleLineBrush}}"
                               TextWrapping="NoWrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </DockPanel>
      </Border>

      <!-- In-progress banner -->
      <Border DockPanel.Dock="Top" Padding="12,8"
              Background="{DynamicResource ForgeBannerBrush}"
              IsVisible="{Binding WorkingCopy.InProgressBanner, Converter={x:Static conv:ForgeConverters.IsNotNullOrEmpty}}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
            <Button Classes="Ghost" Content="Abort" Command="{Binding WorkingCopy.AbortInProgressCommand}" />
            <Button Classes="Ghost" Content="Continue" Command="{Binding WorkingCopy.ContinueInProgressCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding WorkingCopy.InProgressBanner}" VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <!-- Three columns: navigator | splitter | files | splitter | diff -->
      <Grid x:Name="MainColumns">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="260" MinWidth="36" />
          <ColumnDefinition Width="4" />
          <ColumnDefinition Width="300" MinWidth="180" />
          <ColumnDefinition Width="4" />
          <ColumnDefinition Width="*" MinWidth="200" />
        </Grid.ColumnDefinitions>

        <!-- Navigator (collapsed strip) -->
        <Border Grid.Column="0"
                Background="{DynamicResource ForgeSurfaceContainerLowestBrush}"
                BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,1,0"
                IsVisible="{Binding IsNavigatorCollapsed}">
          <Button Classes="Ghost" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                  Margin="0,8,0,0" Padding="4" Click="OnToggleNavigatorCollapsed"
                  ToolTip.Tip="Expand sidebar">
            <icons:MaterialIcon Kind="ChevronRight" Width="18" Height="18" />
          </Button>
        </Border>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource ForgeSurfaceContainerLowestBrush}"
                BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,1,0"
                IsVisible="{Binding IsNavigatorCollapsed, Converter={x:Static conv:ForgeConverters.InvertBool}}">
          <DockPanel>
            <Border DockPanel.Dock="Top" Padding="8,8"
                    BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1">
              <Button Classes="Ghost" HorizontalAlignment="Right" Padding="4"
                      Click="OnToggleNavigatorCollapsed" ToolTip.Tip="Collapse sidebar">
                <icons:MaterialIcon Kind="ChevronLeft" Width="16" Height="16" />
              </Button>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="8"
                    BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,1,0,0">
              <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                      Command="{Binding OpenSettingsCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <icons:MaterialIcon Kind="Settings" Width="16" Height="16" />
                  <TextBlock Text="Repository Settings" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Border>

            <ScrollViewer>
              <StackPanel Margin="0,8,0,8" Spacing="2">
                <!-- WORKSPACE -->
                <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="12,4" Click="OnToggleWorkspace">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="{Binding WorkingCopy.WorkspaceExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                        Width="14" Height="14" />
                    <icons:MaterialIcon Kind="Monitor" Width="14" Height="14" Opacity="0.7" />
                    <TextBlock Text="WORKSPACE" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                  </StackPanel>
                </Button>
                <StackPanel IsVisible="{Binding WorkingCopy.WorkspaceExpanded}" Spacing="1">
                  <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Padding="28,6,12,6" Command="{Binding WorkingCopy.SelectFileStatusCommand}">
                    <Button.Styles>
                      <Style Selector="Button">
                        <Setter Property="Background" Value="Transparent" />
                      </Style>
                      <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource ForgeSurfaceVariantBrush}" />
                      </Style>
                    </Button.Styles>
                    <DockPanel>
                      <Border DockPanel.Dock="Right" Classes="Chip" VerticalAlignment="Center"
                              IsVisible="{Binding WorkingCopy.WorkingCopyChangeCount, Converter={x:Static conv:ForgeConverters.IsPositive}}">
                        <TextBlock Text="{Binding WorkingCopy.WorkingCopyChangeCount}"
                                   FontFamily="{DynamicResource ForgeCodeFont}"
                                   FontSize="{DynamicResource ForgeBadgeFontSize}"
                                   VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <icons:MaterialIcon Kind="FileDocumentOutline" Width="16" Height="16" />
                        <TextBlock Text="File Status" VerticalAlignment="Center"
                                   FontWeight="{Binding WorkingCopy.IsFileStatusNavSelected, Converter={x:Static conv:ForgeConverters.SelectedFontWeight}}" />
                      </StackPanel>
                    </DockPanel>
                  </Button>
                  <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Padding="28,6,12,6" Command="{Binding WorkingCopy.SelectHistoryCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <icons:MaterialIcon Kind="History" Width="16" Height="16" />
                      <TextBlock Text="History" VerticalAlignment="Center"
                                 FontWeight="{Binding WorkingCopy.IsHistoryNavSelected, Converter={x:Static conv:ForgeConverters.SelectedFontWeight}}" />
                    </StackPanel>
                  </Button>
                </StackPanel>

                <!-- BRANCHES -->
                <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="12,4" Click="OnToggleBranches" Margin="0,8,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="{Binding WorkingCopy.BranchesExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                        Width="14" Height="14" />
                    <icons:MaterialIcon Kind="SourceBranch" Width="14" Height="14" Opacity="0.7" />
                    <TextBlock Text="BRANCHES" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                  </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding WorkingCopy.Branches}"
                              IsVisible="{Binding WorkingCopy.BranchesExpanded}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:BranchInfo">
                      <Border Padding="28,4,12,4">
                        <Border.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Check Out"
                                      Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).WorkingCopy.CheckoutBranchCommand}"
                                      CommandParameter="{Binding}" />
                          </ContextMenu>
                        </Border.ContextMenu>
                        <DockPanel>
                          <icons:MaterialIcon DockPanel.Dock="Left" Kind="Circle" Width="8" Height="8"
                                              Margin="0,0,8,0" VerticalAlignment="Center"
                                              Foreground="{DynamicResource ForgePrimaryBrush}"
                                              IsVisible="{Binding IsCurrent}" />
                          <icons:MaterialIcon DockPanel.Dock="Right" Kind="Check" Width="14" Height="14"
                                              Foreground="{DynamicResource ForgePrimaryBrush}"
                                              IsVisible="{Binding IsCurrent}" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <icons:MaterialIcon Kind="SourceBranch" Width="16" Height="16" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ForgeOnSurfaceBrush}" />
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- STASHES -->
                <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="12,4" Click="OnToggleStashes" Margin="0,8,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="{Binding WorkingCopy.StashesExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                        Width="14" Height="14" />
                    <icons:MaterialIcon Kind="Archive" Width="14" Height="14" Opacity="0.7" />
                    <TextBlock Text="STASHES" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                  </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding WorkingCopy.Stashes}"
                              IsVisible="{Binding WorkingCopy.StashesExpanded}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:StashInfo">
                      <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              Padding="28,4,12,4"
                              Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).WorkingCopy.SelectStashCommand}"
                              CommandParameter="{Binding}">
                        <Button.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Apply"
                                      Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).WorkingCopy.ApplyStashCommand}"
                                      CommandParameter="{Binding}" />
                            <MenuItem Header="Delete"
                                      Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).WorkingCopy.DeleteStashCommand}"
                                      CommandParameter="{Binding}" />
                          </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <icons:MaterialIcon Kind="Archive" Width="16" Height="16" />
                          <TextBlock Text="{Binding DisplayTitle}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" MaxWidth="180" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- PULL REQUESTS -->
                <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="12,4" Click="OnTogglePullRequests" Margin="0,8,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="{Binding WorkingCopy.PullRequestsExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                        Width="14" Height="14" />
                    <icons:MaterialIcon Kind="SourcePull" Width="14" Height="14" Opacity="0.7" />
                    <TextBlock Text="PULL REQUESTS" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                  </StackPanel>
                </Button>
                <StackPanel IsVisible="{Binding WorkingCopy.PullRequestsExpanded}" Spacing="1">
                  <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Padding="28,4,12,4" Click="OnTogglePrRequested">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <icons:MaterialIcon Kind="{Binding WorkingCopy.PrRequestedExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                          Width="12" Height="12" />
                      <TextBlock Text="Requested" FontSize="12" VerticalAlignment="Center" Opacity="0.85" />
                    </StackPanel>
                  </Button>
                  <TextBlock Text="No pull requests" FontSize="11" Opacity="0.45" Margin="48,2,12,6"
                             IsVisible="{Binding WorkingCopy.PrRequestedExpanded}" />
                  <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Padding="28,4,12,4" Click="OnTogglePrRaised">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <icons:MaterialIcon Kind="{Binding WorkingCopy.PrRaisedExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                          Width="12" Height="12" />
                      <TextBlock Text="Raised" FontSize="12" VerticalAlignment="Center" Opacity="0.85" />
                    </StackPanel>
                  </Button>
                  <TextBlock Text="No pull requests" FontSize="11" Opacity="0.45" Margin="48,2,12,6"
                             IsVisible="{Binding WorkingCopy.PrRaisedExpanded}" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns"
                      Background="{DynamicResource ForgeOutlineVariantBrush}"
                      DragCompleted="OnColumnSplitterDragCompleted" />

        <!-- File Status / Stash -->
        <Border Grid.Column="2" Background="{DynamicResource ForgeBackgroundBrush}"
                BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,1,0"
                ClipToBounds="True"
                IsVisible="{Binding WorkingCopy.IsHistoryMode, Converter={x:Static conv:ForgeConverters.InvertBool}}">
          <DockPanel>
            <Border DockPanel.Dock="Top" Height="40" Padding="16,0"
                    Background="{DynamicResource ForgeSurfaceContainerLowBrush}"
                    BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1">
              <TextBlock Text="{Binding WorkingCopy.FileListHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Border>

            <Border DockPanel.Dock="Top" Padding="8,6"
                    BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1"
                    IsVisible="{Binding WorkingCopy.IsHistoryMode, Converter={x:Static conv:ForgeConverters.InvertBool}}">
              <Grid>
                <TextBox Classes="Forge" Text="{Binding WorkingCopy.FileFilter}"
                         PlaceholderText="Filter files…" Padding="8,6,28,6" />
                <Button Classes="IconOnly" Width="22" Height="22" Padding="2"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                        Command="{Binding WorkingCopy.ClearFileFilterCommand}"
                        IsVisible="{Binding WorkingCopy.HasFileFilter}"
                        ToolTip.Tip="Clear filter">
                  <icons:MaterialIcon Kind="Close" Width="14" Height="14" />
                </Button>
              </Grid>
            </Border>

            <!-- Commit dock FIRST so fill gets remaining space -->
            <Border DockPanel.Dock="Bottom" Padding="12"
                    Background="{DynamicResource ForgeSurfaceContainerLowestBrush}"
                    BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,1,0,0"
                    IsVisible="{Binding WorkingCopy.ShowCommitDock}">
              <StackPanel Spacing="8">
                <TextBox Classes="Forge" AcceptsReturn="True" Height="80"
                         Text="{Binding WorkingCopy.CommitMessage}"
                         PlaceholderText="Commit message..." />
                <Button Classes="Primary" Content="{Binding WorkingCopy.CommitButtonLabel}"
                        Command="{Binding WorkingCopy.CommitCommand}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <CheckBox Content="Amend" IsChecked="{Binding WorkingCopy.AmendCommit}" FontSize="11" />
                  <CheckBox Content="--no-verify" IsChecked="{Binding WorkingCopy.NoVerify}" FontSize="11" />
                  <CheckBox Content="Push" IsChecked="{Binding WorkingCopy.PushAfterCommit}" FontSize="11" />
                </StackPanel>
                <TextBlock Text="{Binding WorkingCopy.HookOutput}" FontSize="10" Opacity="0.7"
                           TextWrapping="Wrap" IsVisible="{Binding WorkingCopy.HookOutput, Converter={x:Static conv:ForgeConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Border>

            <!-- Stash details dock (same slot as commit message on File Status) -->
            <Border DockPanel.Dock="Bottom" Padding="12"
                    Background="{DynamicResource ForgeSurfaceContainerLowestBrush}"
                    BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,1,0,0"
                    IsVisible="{Binding WorkingCopy.ShowStashDetailsDock}">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding WorkingCopy.SelectedStashMessage}"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
                <StackPanel Spacing="2" Margin="0,4,0,0">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="Ref" Width="56" FontSize="11"
                               Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                    <TextBlock Text="{Binding WorkingCopy.SelectedStashRef}" FontSize="11"
                               FontFamily="{DynamicResource ForgeCodeFont}" TextWrapping="Wrap" />
                  </DockPanel>
                  <DockPanel IsVisible="{Binding WorkingCopy.HasSelectedStashBranch}">
                    <TextBlock DockPanel.Dock="Left" Text="Branch" Width="56" FontSize="11"
                               Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                    <TextBlock Text="{Binding WorkingCopy.SelectedStashBranch}" FontSize="11"
                               TextWrapping="Wrap" />
                  </DockPanel>
                </StackPanel>
              </StackPanel>
            </Border>

            <ScrollViewer>
              <StackPanel Spacing="16" Margin="8,8,8,12">
                <!-- Stash files -->
                <StackPanel IsVisible="{Binding WorkingCopy.IsStashMode}">
                  <TextBlock Text="STASHED FILES" Classes="SectionLabel" Margin="8,0,8,4" />
                  <ListBox x:Name="StashFileList"
                           ItemsSource="{Binding WorkingCopy.StashFiles}"
                           SelectionMode="Single"
                           SelectionChanged="OnStashFileSelectionChanged"
                           ScrollViewer.VerticalScrollBarVisibility="Disabled"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:FileItemViewModel">
                        <Border Padding="8,4" CornerRadius="4">
                          <DockPanel>
                            <Border DockPanel.Dock="Right" CornerRadius="2" Padding="4,1" Margin="4,0,0,0"
                                    Background="{Binding Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBackground}}">
                              <TextBlock Text="{Binding StatusBadge}" FontSize="10" FontWeight="Bold"
                                         Foreground="{Binding Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBrush}}" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <icons:MaterialIcon Kind="FileDocument" Width="16" Height="16"
                                                  Foreground="{Binding Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBrush}}" />
                              <TextBlock Text="{Binding Name}" Classes="MonoPath" VerticalAlignment="Center" />
                            </StackPanel>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="32" />
                      </Style>
                    </ListBox.Styles>
                  </ListBox>
                </StackPanel>

                <!-- Staged -->
                <StackPanel IsVisible="{Binding WorkingCopy.IsFileStatusMode}">
                  <DockPanel Margin="8,0,8,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                      <Button Classes="Link" Content="Discard"
                              Command="{Binding WorkingCopy.DiscardSelectedFilesCommand}"
                              IsVisible="{Binding WorkingCopy.HasStagedSelection}" />
                      <Button Classes="Link" Content="Unstage Selected"
                              Command="{Binding WorkingCopy.UnstageSelectedCommand}"
                              IsVisible="{Binding WorkingCopy.HasStagedSelection}" />
                      <Button Classes="Link" Content="Unstage All"
                              Command="{Binding WorkingCopy.UnstageAllCommand}" />
                    </StackPanel>
                    <Button Classes="Ghost" Padding="0" HorizontalAlignment="Left" Click="OnToggleStaged">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="{Binding WorkingCopy.StagedExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                            Width="14" Height="14" />
                        <TextBlock Text="STAGED CHANGES" Classes="SectionLabel" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </DockPanel>
                  <ListBox x:Name="StagedFileList"
                           ItemsSource="{Binding WorkingCopy.StagedFiles}"
                           SelectionMode="Multiple"
                           SelectionChanged="OnFileSelectionChanged"
                           PointerPressed="OnFileListPointerPressed"
                           ScrollViewer.VerticalScrollBarVisibility="Disabled"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           IsVisible="{Binding WorkingCopy.StagedExpanded}">
                    <ListBox.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Unstage"
                                  Command="{Binding WorkingCopy.UnstageSelectedCommand}" />
                        <MenuItem Header="Discard"
                                  Command="{Binding WorkingCopy.DiscardSelectedFilesCommand}" />
                        <Separator />
                        <MenuItem Header="{Binding WorkingCopy.RevealInFileManagerLabel}"
                                  Command="{Binding WorkingCopy.RevealSelectedInFileManagerCommand}" />
                      </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:FileItemViewModel">
                        <Border Classes="FileRow" Padding="8,4" CornerRadius="4">
                          <DockPanel>
                            <Border DockPanel.Dock="Right" CornerRadius="2" Padding="4,1" Margin="4,0,0,0"
                                    Background="{Binding Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBackground}}">
                              <TextBlock Text="{Binding StatusBadge}" FontSize="10" FontWeight="Bold"
                                         Foreground="{Binding Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBrush}}" />
                            </Border>
                            <CheckBox IsChecked="True" Margin="0,0,8,0" VerticalAlignment="Center"
                                      Click="OnFileCheckClick" Tag="{Binding}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <icons:MaterialIcon Kind="FileDocument" Width="16" Height="16"
                                                  Foreground="{Binding Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBrush}}" />
                              <TextBlock Text="{Binding Name}" Classes="MonoPath" VerticalAlignment="Center" />
                            </StackPanel>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="32" />
                      </Style>
                    </ListBox.Styles>
                  </ListBox>
                </StackPanel>

                <!-- Unstaged -->
                <StackPanel IsVisible="{Binding WorkingCopy.IsFileStatusMode}">
                  <DockPanel Margin="8,0,8,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                      <Button Classes="Link" Content="Discard"
                              Command="{Binding WorkingCopy.DiscardSelectedFilesCommand}"
                              IsVisible="{Binding WorkingCopy.HasUnstagedSelection}" />
                      <Button Classes="Link" Content="Stage Selected"
                              Command="{Binding WorkingCopy.StageSelectedCommand}"
                              IsVisible="{Binding WorkingCopy.HasUnstagedSelection}" />
                      <Button Classes="Link" Content="Stage All"
                              Command="{Binding WorkingCopy.StageAllCommand}" />
                    </StackPanel>
                    <Button Classes="Ghost" Padding="0" HorizontalAlignment="Left" Click="OnToggleUnstaged">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="{Binding WorkingCopy.UnstagedExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                            Width="14" Height="14" />
                        <TextBlock Text="UNSTAGED CHANGES" Classes="SectionLabel" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </DockPanel>
                  <ListBox x:Name="UnstagedFileList"
                           ItemsSource="{Binding WorkingCopy.UnstagedFiles}"
                           SelectionMode="Multiple"
                           SelectionChanged="OnFileSelectionChanged"
                           PointerPressed="OnFileListPointerPressed"
                           ScrollViewer.VerticalScrollBarVisibility="Disabled"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           IsVisible="{Binding WorkingCopy.UnstagedExpanded}">
                    <ListBox.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Stage"
                                  Command="{Binding WorkingCopy.StageSelectedCommand}" />
                        <MenuItem Header="Discard"
                                  Command="{Binding WorkingCopy.DiscardSelectedFilesCommand}" />
                        <Separator />
                        <MenuItem Header="{Binding WorkingCopy.RevealInFileManagerLabel}"
                                  Command="{Binding WorkingCopy.RevealSelectedInFileManagerCommand}" />
                      </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:FileItemViewModel">
                        <Border Padding="8,4" CornerRadius="4">
                          <DockPanel>
                            <Border DockPanel.Dock="Right" CornerRadius="2" Padding="4,1" Margin="4,0,0,0"
                                    Background="{Binding Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBackground}}">
                              <TextBlock Text="{Binding StatusBadge}" FontSize="10" FontWeight="Bold"
                                         Foreground="{Binding Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBrush}}" />
                            </Border>
                            <CheckBox IsChecked="False" Margin="0,0,8,0" VerticalAlignment="Center"
                                      Click="OnFileCheckClick" Tag="{Binding}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <icons:MaterialIcon Kind="FileDocument" Width="16" Height="16"
                                                  Foreground="{Binding Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBrush}}" />
                              <TextBlock Text="{Binding Name}" Classes="MonoPath" VerticalAlignment="Center" />
                            </StackPanel>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="32" />
                      </Style>
                    </ListBox.Styles>
                  </ListBox>
                </StackPanel>

                <!-- Conflicted -->
                <StackPanel IsVisible="{Binding WorkingCopy.IsFileStatusMode}">
                  <StackPanel IsVisible="{Binding WorkingCopy.HasConflictedFiles}">
                  <TextBlock Text="CONFLICTED" Classes="SectionLabel" Margin="8,0,8,4"
                             Foreground="{DynamicResource ForgeErrorBrush}" />
                  <ListBox x:Name="ConflictedFileList"
                           ItemsSource="{Binding WorkingCopy.ConflictedFiles}"
                           SelectionMode="Multiple"
                           SelectionChanged="OnFileSelectionChanged"
                           PointerPressed="OnFileListPointerPressed"
                           ScrollViewer.VerticalScrollBarVisibility="Disabled"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="{Binding WorkingCopy.RevealInFileManagerLabel}"
                                  Command="{Binding WorkingCopy.RevealSelectedInFileManagerCommand}" />
                      </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:FileItemViewModel">
                        <Border Padding="8,4">
                          <DockPanel>
                            <Border DockPanel.Dock="Right" CornerRadius="2" Padding="4,1"
                                    Background="{DynamicResource ForgeStatusDeletedBadgeBgBrush}">
                              <TextBlock Text="C" FontSize="10" FontWeight="Bold"
                                         Foreground="{DynamicResource ForgeErrorBrush}" />
                            </Border>
                            <TextBlock Text="{Binding Name}" Classes="MonoPath"
                                       Foreground="{DynamicResource ForgeErrorBrush}" />
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="3" Width="4" ResizeDirection="Columns"
                      Background="{DynamicResource ForgeOutlineVariantBrush}"
                      DragCompleted="OnColumnSplitterDragCompleted"
                      IsVisible="{Binding WorkingCopy.IsHistoryMode, Converter={x:Static conv:ForgeConverters.InvertBool}}" />

        <!-- Diff pane (File Status / Stash) -->
        <DockPanel Grid.Column="4" Background="{DynamicResource ForgeSurfaceContainerLowestBrush}"
                   IsVisible="{Binding WorkingCopy.IsHistoryMode, Converter={x:Static conv:ForgeConverters.InvertBool}}">
          <Border DockPanel.Dock="Top" Height="40" Padding="12,0"
                  Background="{DynamicResource ForgeSurfaceContainerLowBrush}"
                  BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <CheckBox Content="Ignore whitespace"
                          IsChecked="{Binding WorkingCopy.IgnoreWhitespace}"
                          FontSize="11" VerticalAlignment="Center" />
                <ToggleButton Content="{Binding WorkingCopy.FullFileToggleLabel}"
                              IsChecked="{Binding WorkingCopy.ShowFullFile}"
                              FontSize="11" Padding="8,4" />
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                            IsEnabled="{Binding WorkingCopy.ShowFullFile, Converter={x:Static conv:ForgeConverters.InvertBool}}">
                  <TextBlock Text="Context" FontSize="11" VerticalAlignment="Center"
                             Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                  <ComboBox ItemsSource="{Binding WorkingCopy.ContextLineOptions}"
                            SelectedIndex="{Binding WorkingCopy.ContextLinesIndex}"
                            MinWidth="56" FontSize="11" />
                </StackPanel>
                <ComboBox SelectedItem="{Binding WorkingCopy.ViewMode}" MinWidth="120">
                  <core:DiffViewMode>SideBySide</core:DiffViewMode>
                  <core:DiffViewMode>Unified</core:DiffViewMode>
                </ComboBox>
                <Button Classes="Link" Content="Discard"
                        Command="{Binding WorkingCopy.DiscardSelectedFilesCommand}"
                        IsVisible="{Binding WorkingCopy.CanDiscardSelection}"
                        FontSize="11" VerticalAlignment="Center" />
                <Button Classes="IconOnly">
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="Combined review"
                                Command="{Binding WorkingCopy.ToggleCombinedReviewCommand}" />
                      <MenuItem Header="Stage hunk" Command="{Binding WorkingCopy.StageHunkCommand}" />
                      <MenuItem Header="Unstage hunk" Command="{Binding WorkingCopy.UnstageHunkCommand}" />
                      <MenuItem Header="Discard hunk" Command="{Binding WorkingCopy.DiscardHunkCommand}" />
                      <Separator />
                      <MenuItem Header="Discard file(s)"
                                Command="{Binding WorkingCopy.DiscardSelectedFilesCommand}" />
                      <MenuItem Header="{Binding WorkingCopy.RevealInFileManagerLabel}"
                                Command="{Binding WorkingCopy.RevealSelectedInFileManagerCommand}" />
                    </MenuFlyout>
                  </Button.Flyout>
                  <icons:MaterialIcon Kind="DotsHorizontal" Width="18" Height="18" />
                </Button>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                          IsVisible="{Binding WorkingCopy.SelectedFile, Converter={x:Static conv:ForgeConverters.IsNotNull}}">
                <icons:MaterialIcon Kind="FileDocument" Width="18" Height="18"
                                    Foreground="{DynamicResource ForgeStatusAddedBrush}" />
                <TextBlock Text="{Binding WorkingCopy.SelectedFile.Name}" FontWeight="SemiBold"
                           ToolTip.Tip="{Binding WorkingCopy.SelectedFileAbsolutePath}" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                  <TextBlock Text="{Binding WorkingCopy.SelectedAddedLines, Converter={x:Static conv:ForgeConverters.PlusPrefix}}"
                             FontSize="10" Foreground="{DynamicResource ForgeStatusAddedBrush}" />
                  <TextBlock Text="{Binding WorkingCopy.SelectedRemovedLines, Converter={x:Static conv:ForgeConverters.MinusPrefix}}"
                             FontSize="10" Foreground="{DynamicResource ForgeStatusDeletedBrush}" />
                </StackPanel>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border DockPanel.Dock="Top"
                  IsVisible="{Binding WorkingCopy.ViewMode, Converter={x:Static conv:ForgeConverters.IsSideBySide}}"
                  Height="24" Background="{DynamicResource ForgeSurfaceContainerBrush}"
                  BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,*">
              <TextBlock Grid.Column="0" Text="PREVIOUS VERSION" FontSize="10" FontWeight="Bold"
                         Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}"
                         VerticalAlignment="Center" Margin="12,0" />
              <Border Grid.Column="1" BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="1,0,0,0">
                <TextBlock Text="NEW VERSION" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource ForgePrimaryBrush}"
                           VerticalAlignment="Center" Margin="12,0" />
              </Border>
            </Grid>
          </Border>

          <Border DockPanel.Dock="Bottom" Height="24" Padding="16,0"
                  Background="{DynamicResource ForgeSurfaceContainerBrush}"
                  BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource ForgeStatusAddedBrush}" />
              <TextBlock Text="{Binding WorkingCopy.DiffFooterText}" FontSize="10"
                         Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
            </StackPanel>
          </Border>

          <Panel ClipToBounds="True">
            <controls:DiffViewer Rows="{Binding WorkingCopy.DiffRows}"
                                 ViewMode="{Binding WorkingCopy.ViewMode}"
                                 EmptyMessage="{Binding WorkingCopy.DiffEmptyMessage}"
                                 CanStageLines="{Binding WorkingCopy.CanStageLines}"
                                 CanUnstageLines="{Binding WorkingCopy.CanUnstageLines}"
                                 CanDiscardLines="{Binding WorkingCopy.CanDiscardLines}"
                                 RowHeight="20"
                                 IsVisible="{Binding WorkingCopy.IsImagePreview, Converter={x:Static conv:ForgeConverters.InvertBool}}" />

            <!-- Changed image: before | after -->
            <Grid IsVisible="{Binding WorkingCopy.HasImageBefore}"
                  ColumnDefinitions="*,4,*"
                  Background="{DynamicResource ForgeSurfaceContainerLowestBrush}">
              <DockPanel Grid.Column="0" Margin="12">
                <TextBlock DockPanel.Dock="Top" Text="Before" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" Margin="0,0,0,8" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <Image Source="{Binding WorkingCopy.ImageBefore}" Stretch="Uniform"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         MaxWidth="1200" MaxHeight="1200" />
                </ScrollViewer>
              </DockPanel>
              <Border Grid.Column="1" Background="{DynamicResource ForgeOutlineVariantBrush}" />
              <DockPanel Grid.Column="2" Margin="12">
                <TextBlock DockPanel.Dock="Top" Text="After" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" Margin="0,0,0,8" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <Image Source="{Binding WorkingCopy.ImageAfter}" Stretch="Uniform"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         MaxWidth="1200" MaxHeight="1200" />
                </ScrollViewer>
              </DockPanel>
            </Grid>

            <!-- Single image (added / untracked / no before) -->
            <ScrollViewer IsVisible="{Binding WorkingCopy.IsSingleImagePreview}"
                          Background="{DynamicResource ForgeSurfaceContainerLowestBrush}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Padding="12">
              <Image Source="{Binding WorkingCopy.ImageAfter}" Stretch="Uniform"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     MaxWidth="1200" MaxHeight="1200" />
            </ScrollViewer>

            <Border Background="#80060e20"
                    IsVisible="{Binding WorkingCopy.IsLoadingDiff}">
              <ProgressBar Width="36" Height="36" IsIndeterminate="True"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding WorkingCopy.DiffOverlayMessage}"
                       IsVisible="{Binding WorkingCopy.DiffOverlayMessage, Converter={x:Static conv:ForgeConverters.IsNotNullOrEmpty}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
          </Panel>
        </DockPanel>

        <!-- History mode: commit list on top; files + details + diff below -->
        <Grid Grid.Column="2" Grid.ColumnSpan="3"
              IsVisible="{Binding WorkingCopy.IsHistoryMode}"
              RowDefinitions="*,4,*"
              Background="{DynamicResource ForgeBackgroundBrush}">

          <!-- Commit list -->
          <DockPanel Grid.Row="0" MinHeight="160">
            <Border DockPanel.Dock="Top" Height="40" Padding="16,0"
                    Background="{DynamicResource ForgeSurfaceContainerLowBrush}"
                    BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1">
              <TextBlock Text="History" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Border>

            <Border DockPanel.Dock="Top" Padding="8,6"
                    BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1">
              <Grid>
                <TextBox Classes="Forge" Text="{Binding WorkingCopy.HistorySearchText}"
                         PlaceholderText="Search commits…" Padding="8,6,28,6" />
                <Button Classes="IconOnly" Width="22" Height="22" Padding="2"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                        Command="{Binding WorkingCopy.ClearHistorySearchCommand}"
                        IsVisible="{Binding WorkingCopy.HasHistorySearch}"
                        ToolTip.Tip="Clear search">
                  <icons:MaterialIcon Kind="Close" Width="14" Height="14" />
                </Button>
              </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="8,6"
                    BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,1,0,0"
                    IsVisible="{Binding WorkingCopy.HasMoreHistory}">
              <Button Classes="Ghost" Content="Load more"
                      Command="{Binding WorkingCopy.LoadMoreHistoryCommand}"
                      HorizontalAlignment="Center"
                      IsEnabled="{Binding WorkingCopy.IsHistoryLoading, Converter={x:Static conv:ForgeConverters.InvertBool}}" />
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="8"
                    IsVisible="{Binding WorkingCopy.IsHistoryLoading}">
              <ProgressBar Height="3" IsIndeterminate="True" />
            </Border>

            <!-- Column headers -->
            <Border DockPanel.Dock="Top" Padding="12,6"
                    Background="{DynamicResource ForgeSurfaceContainerBrush}"
                    BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,90,140,120">
                <TextBlock Grid.Column="0" Text="Description" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                <TextBlock Grid.Column="1" Text="Commit" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                <TextBlock Grid.Column="2" Text="Author" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                <TextBlock Grid.Column="3" Text="Date" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
              </Grid>
            </Border>

            <ListBox x:Name="HistoryCommitList"
                     ItemsSource="{Binding WorkingCopy.HistoryCommits}"
                     SelectionMode="Single"
                     SelectionChanged="OnHistoryCommitSelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:CommitInfo">
                  <Border Padding="12,6">
                    <Grid ColumnDefinitions="*,90,140,120">
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <ItemsControl ItemsSource="{Binding Decorations}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <Border Background="{DynamicResource ForgePrimaryContainerBrush}"
                                      CornerRadius="3" Padding="5,1">
                                <TextBlock Text="{Binding}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForgeOnSurfaceBrush}" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding ShortOid}"
                                 FontFamily="{DynamicResource ForgeCodeFont}" FontSize="12"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                      <TextBlock Grid.Column="2" Text="{Binding AuthorName}" TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3"
                                 Text="{Binding AuthorDate, Converter={x:Static conv:ForgeConverters.CommitDateDisplay}}"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" FontSize="12" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="MinHeight" Value="32" />
                </Style>
              </ListBox.Styles>
            </ListBox>
          </DockPanel>

          <GridSplitter Grid.Row="1" Height="4" ResizeDirection="Rows"
                        Background="{DynamicResource ForgeOutlineVariantBrush}" />

          <!-- Files + details | Diff -->
          <Grid Grid.Row="2" ColumnDefinitions="300,4,*" MinHeight="180">
            <Border Grid.Column="0" Background="{DynamicResource ForgeBackgroundBrush}"
                    BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,1,0"
                    ClipToBounds="True">
              <DockPanel>
                <Border DockPanel.Dock="Top" Height="40" Padding="16,0"
                        Background="{DynamicResource ForgeSurfaceContainerLowBrush}"
                        BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1">
                  <TextBlock Text="Files" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Border>

                <Border DockPanel.Dock="Top" Padding="8,6"
                        BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1">
                  <Grid>
                    <TextBox Classes="Forge" Text="{Binding WorkingCopy.HistoryFileFilter}"
                             PlaceholderText="Filter files…" Padding="8,6,28,6" />
                    <Button Classes="IconOnly" Width="22" Height="22" Padding="2"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                            Command="{Binding WorkingCopy.ClearHistoryFileFilterCommand}"
                            IsVisible="{Binding WorkingCopy.HasHistoryFileFilter}"
                            ToolTip.Tip="Clear filter">
                      <icons:MaterialIcon Kind="Close" Width="14" Height="14" />
                    </Button>
                  </Grid>
                </Border>

                <!-- Commit details dock (same slot as commit message on File Status) -->
                <Border DockPanel.Dock="Bottom" Padding="12"
                        Background="{DynamicResource ForgeSurfaceContainerLowestBrush}"
                        BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,1,0,0"
                        IsVisible="{Binding WorkingCopy.ShowCommitDetailsDock}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding WorkingCopy.SelectedCommitSubject}"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding WorkingCopy.SelectedCommitBody}"
                               FontSize="12" Opacity="0.8" TextWrapping="Wrap"
                               IsVisible="{Binding WorkingCopy.HasSelectedCommitBody}" />
                    <StackPanel Spacing="2" Margin="0,4,0,0">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Commit" Width="56" FontSize="11"
                                   Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                        <TextBlock Text="{Binding WorkingCopy.SelectedCommitOid}" FontSize="11"
                                   FontFamily="{DynamicResource ForgeCodeFont}" TextWrapping="Wrap" />
                      </DockPanel>
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Author" Width="56" FontSize="11"
                                   Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                        <TextBlock Text="{Binding WorkingCopy.SelectedCommitAuthor}" FontSize="11"
                                   TextWrapping="Wrap" />
                      </DockPanel>
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Date" Width="56" FontSize="11"
                                   Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                        <TextBlock Text="{Binding WorkingCopy.SelectedCommitDate}" FontSize="11"
                                   TextWrapping="Wrap" />
                      </DockPanel>
                      <DockPanel IsVisible="{Binding WorkingCopy.SelectedCommitDecorations, Converter={x:Static conv:ForgeConverters.IsNotNullOrEmpty}}">
                        <TextBlock DockPanel.Dock="Left" Text="Labels" Width="56" FontSize="11"
                                   Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                        <TextBlock Text="{Binding WorkingCopy.SelectedCommitDecorations}" FontSize="11"
                                   TextWrapping="Wrap" />
                      </DockPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <ListBox x:Name="HistoryFileList"
                         ItemsSource="{Binding WorkingCopy.HistoryFiles}"
                         SelectionMode="Single"
                         SelectionChanged="OnHistoryFileSelectionChanged"
                         Margin="8,8,8,12">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileItemViewModel">
                      <Border Padding="8,4" CornerRadius="4">
                        <DockPanel>
                          <Border DockPanel.Dock="Right" CornerRadius="2" Padding="4,1" Margin="4,0,0,0"
                                  Background="{Binding Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBackground}}">
                            <TextBlock Text="{Binding StatusBadge}" FontSize="10" FontWeight="Bold"
                                       Foreground="{Binding Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBrush}}" />
                          </Border>
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:MaterialIcon Kind="FileDocument" Width="16" Height="16"
                                                Foreground="{Binding Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBrush}}" />
                            <TextBlock Text="{Binding Name}" Classes="MonoPath" VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding Path.Value}" />
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="Padding" Value="0" />
                      <Setter Property="MinHeight" Value="32" />
                    </Style>
                  </ListBox.Styles>
                </ListBox>
              </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns"
                          Background="{DynamicResource ForgeOutlineVariantBrush}" />

            <!-- Diff (same bindings as File Status pane) -->
            <DockPanel Grid.Column="2" Background="{DynamicResource ForgeSurfaceContainerLowestBrush}">
              <Border DockPanel.Dock="Top" Height="40" Padding="12,0"
                      Background="{DynamicResource ForgeSurfaceContainerLowBrush}"
                      BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <CheckBox Content="Ignore whitespace"
                              IsChecked="{Binding WorkingCopy.IgnoreWhitespace}"
                              FontSize="11" VerticalAlignment="Center" />
                    <ToggleButton Content="{Binding WorkingCopy.FullFileToggleLabel}"
                                  IsChecked="{Binding WorkingCopy.ShowFullFile}"
                                  FontSize="11" Padding="8,4" />
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                IsEnabled="{Binding WorkingCopy.ShowFullFile, Converter={x:Static conv:ForgeConverters.InvertBool}}">
                      <TextBlock Text="Context" FontSize="11" VerticalAlignment="Center"
                                 Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                      <ComboBox ItemsSource="{Binding WorkingCopy.ContextLineOptions}"
                                SelectedIndex="{Binding WorkingCopy.ContextLinesIndex}"
                                MinWidth="56" FontSize="11" />
                    </StackPanel>
                    <ComboBox SelectedItem="{Binding WorkingCopy.ViewMode}" MinWidth="120">
                      <core:DiffViewMode>SideBySide</core:DiffViewMode>
                      <core:DiffViewMode>Unified</core:DiffViewMode>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                              IsVisible="{Binding WorkingCopy.SelectedFile, Converter={x:Static conv:ForgeConverters.IsNotNull}}">
                    <icons:MaterialIcon Kind="FileDocument" Width="18" Height="18"
                                        Foreground="{DynamicResource ForgeStatusAddedBrush}" />
                    <TextBlock Text="{Binding WorkingCopy.SelectedFile.Name}" FontWeight="SemiBold"
                               ToolTip.Tip="{Binding WorkingCopy.SelectedFileAbsolutePath}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                      <TextBlock Text="{Binding WorkingCopy.SelectedAddedLines, Converter={x:Static conv:ForgeConverters.PlusPrefix}}"
                                 FontSize="10" Foreground="{DynamicResource ForgeStatusAddedBrush}" />
                      <TextBlock Text="{Binding WorkingCopy.SelectedRemovedLines, Converter={x:Static conv:ForgeConverters.MinusPrefix}}"
                                 FontSize="10" Foreground="{DynamicResource ForgeStatusDeletedBrush}" />
                    </StackPanel>
                  </StackPanel>
                </DockPanel>
              </Border>

              <Border DockPanel.Dock="Top"
                      IsVisible="{Binding WorkingCopy.ViewMode, Converter={x:Static conv:ForgeConverters.IsSideBySide}}"
                      Height="24" Background="{DynamicResource ForgeSurfaceContainerBrush}"
                      BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,*">
                  <TextBlock Grid.Column="0" Text="PREVIOUS VERSION" FontSize="10" FontWeight="Bold"
                             Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}"
                             VerticalAlignment="Center" Margin="12,0" />
                  <Border Grid.Column="1" BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="1,0,0,0">
                    <TextBlock Text="NEW VERSION" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource ForgePrimaryBrush}"
                               VerticalAlignment="Center" Margin="12,0" />
                  </Border>
                </Grid>
              </Border>

              <Border DockPanel.Dock="Bottom" Height="24" Padding="16,0"
                      Background="{DynamicResource ForgeSurfaceContainerBrush}"
                      BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Ellipse Width="8" Height="8" Fill="{DynamicResource ForgeStatusAddedBrush}" />
                  <TextBlock Text="{Binding WorkingCopy.DiffFooterText}" FontSize="10"
                             Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                </StackPanel>
              </Border>

              <Panel ClipToBounds="True">
                <controls:DiffViewer Rows="{Binding WorkingCopy.DiffRows}"
                                     ViewMode="{Binding WorkingCopy.ViewMode}"
                                     EmptyMessage="{Binding WorkingCopy.DiffEmptyMessage}"
                                     CanStageLines="False"
                                     CanUnstageLines="False"
                                     CanDiscardLines="False"
                                     RowHeight="20" />
                <Border Background="#80060e20"
                        IsVisible="{Binding WorkingCopy.IsLoadingDiff}">
                  <ProgressBar Width="36" Height="36" IsIndeterminate="True"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding WorkingCopy.DiffOverlayMessage}"
                           IsVisible="{Binding WorkingCopy.DiffOverlayMessage, Converter={x:Static conv:ForgeConverters.IsNotNullOrEmpty}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="14" Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
              </Panel>
            </DockPanel>
          </Grid>
        </Grid>
      </Grid>
    </DockPanel>

    <!-- Notifications overlay (does not affect layout) -->
    <ItemsControl ItemsSource="{Binding Notifications.Notifications}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="12,0,12,36" MaxWidth="360" ZIndex="100">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="svc:AppNotification">
          <Border Background="{DynamicResource ForgeSurfaceContainerHighBrush}"
                  BorderBrush="{DynamicResource ForgeOutlineVariantBrush}"
                  BorderThickness="1" Padding="12,8" Margin="0,0,0,4" CornerRadius="4">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="Link"
                      Content="{Binding ActionLabel}"
                      IsVisible="{Binding ActionLabel, Converter={x:Static conv:ForgeConverters.IsNotNullOrEmpty}}"
                      Click="OnNotificationAction" Tag="{Binding}" Margin="8,0,0,0" />
              <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                         Foreground="{DynamicResource ForgeOnSurfaceBrush}" FontSize="12" />
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Settings overlay -->
    <Border IsVisible="{Binding ShowSettings}" Background="{DynamicResource ForgeSettingsScrimBrush}" ZIndex="200">
      <Border Width="440" HorizontalAlignment="Right" Background="{DynamicResource ForgeSurfaceContainerLowBrush}"
              BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="1,0,0,0">
        <DockPanel Margin="20">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Classes="IconOnly" Command="{Binding CloseSettingsCommand}">
              <icons:MaterialIcon Kind="Close" Width="18" Height="18" />
            </Button>
            <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <StackPanel Spacing="16">
            <StackPanel Spacing="4">
              <TextBlock Text="THEME" Classes="PanelHeader" Opacity="0.7" />
              <ComboBox SelectedItem="{Binding Theme}" HorizontalAlignment="Stretch">
                <x:String>System</x:String>
                <x:String>Light</x:String>
                <x:String>Dark</x:String>
              </ComboBox>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="DEFAULT DIFF MODE" Classes="PanelHeader" Opacity="0.7" />
              <ComboBox SelectedItem="{Binding DefaultDiffMode}" HorizontalAlignment="Stretch">
                <core:DiffViewMode>SideBySide</core:DiffViewMode>
                <core:DiffViewMode>Unified</core:DiffViewMode>
              </ComboBox>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="DIFF OPTIONS" Classes="PanelHeader" Opacity="0.7" />
              <CheckBox Content="Ignore whitespace changes"
                        IsChecked="{Binding WorkingCopy.IgnoreWhitespace}" />
              <StackPanel Orientation="Horizontal" Spacing="8"
                          IsEnabled="{Binding WorkingCopy.ShowFullFile, Converter={x:Static conv:ForgeConverters.InvertBool}}">
                <TextBlock Text="Context lines" VerticalAlignment="Center" FontSize="12" />
                <ComboBox ItemsSource="{Binding WorkingCopy.ContextLineOptions}"
                          SelectedIndex="{Binding WorkingCopy.ContextLinesIndex}"
                          MinWidth="72" />
              </StackPanel>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="GIT" Classes="PanelHeader" Opacity="0.7" />
              <TextBlock Text="{Binding Diagnostics.GitPath, StringFormat=Path: {0}}" FontSize="12"
                         FontFamily="{DynamicResource ForgeCodeFont}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Diagnostics.GitVersion, StringFormat=Version: {0}}" FontSize="12" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="DIAGNOSTICS" Classes="PanelHeader" Opacity="0.7" />
              <TextBlock Text="{Binding Diagnostics.Summary}" FontSize="11" TextWrapping="Wrap"
                         Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
              <ItemsControl ItemsSource="{Binding Diagnostics.LastTimings}" MaxHeight="160">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="10"
                               FontFamily="{DynamicResource ForgeCodeFont}"
                               Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <Button Classes="Ghost" Content="Open Repository…" Click="OnOpenRepository"
                    HorizontalAlignment="Left" />
          </StackPanel>
        </DockPanel>
      </Border>
    </Border>
  </Panel>
</Window>
