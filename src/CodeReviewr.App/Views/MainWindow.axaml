<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CodeReviewr.App.ViewModels"
        xmlns:controls="using:CodeReviewr.App.Controls"
        xmlns:conv="using:CodeReviewr.App.Converters"
        xmlns:core="using:CodeReviewr.Core"
        xmlns:ai="using:CodeReviewr.Core.AI"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:svc="using:CodeReviewr.App.Services"
        xmlns:gh="using:CodeReviewr.GitHub"
        xmlns:review="using:CodeReviewr.Review"
        x:Class="CodeReviewr.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="RootWindow"
        Title="Code Reviewr"
        Icon="/Assets/logo.png"
        Width="1280" Height="800"
        Background="{DynamicResource ForgeBackgroundBrush}">

  <Panel>
    <!-- Empty repository state -->
    <Border IsVisible="{Binding WorkingCopy.HasRepository, Converter={x:Static conv:ForgeConverters.InvertBool}}"
            Background="{DynamicResource ForgeBackgroundBrush}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" MaxWidth="420">
        <Image Source="/Assets/logo.png" Width="64" Height="64" HorizontalAlignment="Center" />
        <TextBlock Text="Code Reviewr" FontSize="28" FontWeight="Bold"
                   Foreground="{DynamicResource ForgePrimaryBrush}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Open a local Git repository to review changes."
                   Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}"
                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
        <Button Classes="Primary" Content="Open Repository…" Click="OnOpenRepository" Width="220"
                HorizontalAlignment="Center" />
        <StackPanel Spacing="4" IsVisible="{Binding HasRecentRepositories}" Margin="0,12,0,0">
          <TextBlock Text="RECENT" Classes="PanelHeader" Opacity="0.7" Margin="0,0,0,4" />
          <ItemsControl ItemsSource="{Binding RecentRepositories}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="Ghost" Content="{Binding}" Tag="{Binding}" Click="OnRecentClick"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        FontFamily="{DynamicResource ForgeCodeFont}" FontSize="12" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Main workspace -->
    <DockPanel IsVisible="{Binding WorkingCopy.HasRepository}">
      <!-- Top bar -->
      <Border DockPanel.Dock="Top" Height="44" Padding="8,0"
              Background="{DynamicResource ForgeSurfaceContainerLowestBrush}"
              BorderBrush="{DynamicResource ForgeOutlineVariantBrush}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Image Source="/Assets/logo.png" Width="22" Height="22" Margin="4,0,4,0"
                   VerticalAlignment="Center" />
            <TextBlock Text="Code Reviewr" FontWeight="SemiBold" FontSize="13"
                       Foreground="{DynamicResource ForgePrimaryBrush}"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Classes="Ghost" Command="{Binding WorkingCopy.PushCommand}"
                    IsEnabled="{Binding WorkingCopy.IsRemoteBusy, Converter={x:Static conv:ForgeConverters.InvertBool}}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <ProgressBar Width="16" Height="16" IsIndeterminate="True"
                             IsVisible="{Binding WorkingCopy.IsPushing}" />
                <icons:MaterialIcon Kind="Upload" Width="16" Height="16"
                                    IsVisible="{Binding WorkingCopy.IsPushing, Converter={x:Static conv:ForgeConverters.InvertBool}}" />
                <TextBlock Text="Push" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="Ghost" Command="{Binding WorkingCopy.PullCommand}"
                    IsEnabled="{Binding WorkingCopy.IsRemoteBusy, Converter={x:Static conv:ForgeConverters.InvertBool}}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <ProgressBar Width="16" Height="16" IsIndeterminate="True"
                             IsVisible="{Binding WorkingCopy.IsPulling}" />
                <icons:MaterialIcon Kind="Download" Width="16" Height="16"
                                    IsVisible="{Binding WorkingCopy.IsPulling, Converter={x:Static conv:ForgeConverters.InvertBool}}" />
                <TextBlock Text="Pull" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="Ghost" Command="{Binding WorkingCopy.FetchCommand}"
                    IsEnabled="{Binding WorkingCopy.IsRemoteBusy, Converter={x:Static conv:ForgeConverters.InvertBool}}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <ProgressBar Width="16" Height="16" IsIndeterminate="True"
                             IsVisible="{Binding WorkingCopy.IsFetching}" />
                <icons:MaterialIcon Kind="Sync" Width="16" Height="16"
                                    IsVisible="{Binding WorkingCopy.IsFetching, Converter={x:Static conv:ForgeConverters.InvertBool}}" />
                <TextBlock Text="Fetch" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Border Width="1" Height="16" Background="{DynamicResource ForgeOutlineVariantBrush}" Margin="8,0" />
            <Button Classes="Ghost" Command="{Binding WorkingCopy.StashAllChangesCommand}"
                    IsEnabled="{Binding WorkingCopy.IsRemoteBusy, Converter={x:Static conv:ForgeConverters.InvertBool}}"
                    ToolTip.Tip="Stash all changes including untracked files">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <ProgressBar Width="16" Height="16" IsIndeterminate="True"
                             IsVisible="{Binding WorkingCopy.IsStashing}" />
                <icons:MaterialIcon Kind="Archive" Width="16" Height="16"
                                    IsVisible="{Binding WorkingCopy.IsStashing, Converter={x:Static conv:ForgeConverters.InvertBool}}" />
                <TextBlock Text="Stash" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="Ghost" Command="{Binding WorkingCopy.ViewRemoteCommand}"
                    ToolTip.Tip="Open remote in browser">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <icons:MaterialIcon Kind="Web" Width="16" Height="16" />
                <TextBlock Text="View Remote" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="Ghost" Command="{Binding WorkingCopy.RevealRepositoryInFileManagerCommand}"
                    ToolTip.Tip="{Binding WorkingCopy.RevealInFileManagerLabel}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <icons:MaterialIcon Kind="FolderOpen" Width="16" Height="16" />
                <TextBlock Text="{Binding WorkingCopy.RevealInFileManagerLabel}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Border Width="1" Height="16" Background="{DynamicResource ForgeOutlineVariantBrush}" Margin="8,0" />
            <Button Classes="Ghost">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <icons:MaterialIcon Kind="SourceBranch" Width="16" Height="16" />
                <TextBlock Text="{Binding WorkingCopy.CurrentBranch}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
          <Button Grid.Column="1" Classes="IconOnly" Command="{Binding OpenSettingsCommand}"
                  VerticalAlignment="Center" ToolTip.Tip="Settings">
            <icons:MaterialIcon Kind="Settings" Width="18" Height="18" />
          </Button>
        </Grid>
      </Border>

      <!-- Status bar -->
      <Border DockPanel.Dock="Bottom" Height="24" Padding="12,0"
              Background="{DynamicResource ForgeSurfaceContainerBrush}"
              BorderBrush="{DynamicResource ForgeOutlineVariantBrush}"
              BorderThickness="0,1,0,0">
        <TextBlock Text="{Binding StatusText}" FontSize="10"
                   Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}"
                   VerticalAlignment="Center" />
      </Border>

      <!-- Git command console -->
      <Border DockPanel.Dock="Bottom"
              Background="{DynamicResource ForgeSurfaceContainerLowestBrush}"
              BorderBrush="{DynamicResource ForgeOutlineVariantBrush}"
              BorderThickness="0,1,0,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Height="28" Padding="8,0"
                  Background="{DynamicResource ForgeSurfaceContainerBrush}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                <Button Classes="Link" Content="Clear" Command="{Binding GitConsole.ClearCommand}" FontSize="11" />
                <Button Classes="Ghost" Padding="4" Command="{Binding GitConsole.ToggleExpandedCommand}">
                  <icons:MaterialIcon Kind="{Binding GitConsole.IsExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                      Width="14" Height="14" />
                </Button>
              </StackPanel>
              <Button Classes="Ghost" Padding="4,0" HorizontalAlignment="Left"
                      Command="{Binding GitConsole.ToggleExpandedCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <icons:MaterialIcon Kind="Console" Width="14" Height="14" />
                  <TextBlock Text="Git Output" FontSize="11" VerticalAlignment="Center"
                             Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                </StackPanel>
              </Button>
            </DockPanel>
          </Border>
          <Border Height="180" IsVisible="{Binding GitConsole.IsExpanded}" Padding="8,4">
            <ScrollViewer x:Name="GitConsoleScroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding GitConsole.Lines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GitConsoleLine">
                    <TextBlock Text="{Binding Text}"
                               FontFamily="{DynamicResource ForgeCodeFont}"
                               FontSize="11"
                               Foreground="{Binding Kind, Converter={x:Static conv:ForgeConverters.GitConsoleLineBrush}}"
                               TextWrapping="NoWrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </DockPanel>
      </Border>

      <!-- In-progress banner -->
      <Border DockPanel.Dock="Top" Padding="12,8"
              Background="{DynamicResource ForgeBannerBrush}"
              IsVisible="{Binding WorkingCopy.InProgressBanner, Converter={x:Static conv:ForgeConverters.IsNotNullOrEmpty}}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
            <Button Classes="Ghost" Content="Abort" Command="{Binding WorkingCopy.AbortInProgressCommand}" />
            <Button Classes="Ghost" Content="Continue" Command="{Binding WorkingCopy.ContinueInProgressCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding WorkingCopy.InProgressBanner}" VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <!-- Three columns: navigator | splitter | files | splitter | diff -->
      <Grid x:Name="MainColumns">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="260" MinWidth="36" />
          <ColumnDefinition Width="4" />
          <ColumnDefinition Width="300" MinWidth="180" />
          <ColumnDefinition Width="4" />
          <ColumnDefinition Width="*" MinWidth="200" />
        </Grid.ColumnDefinitions>

        <!-- Navigator (collapsed strip) -->
        <Border Grid.Column="0"
                Background="{DynamicResource ForgeSurfaceContainerLowestBrush}"
                BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,1,0"
                IsVisible="{Binding IsNavigatorCollapsed}">
          <Button Classes="Ghost" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                  Margin="0,8,0,0" Padding="4" Click="OnToggleNavigatorCollapsed"
                  ToolTip.Tip="Expand sidebar">
            <icons:MaterialIcon Kind="ChevronRight" Width="18" Height="18" />
          </Button>
        </Border>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource ForgeSurfaceContainerLowestBrush}"
                BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,1,0"
                IsVisible="{Binding IsNavigatorCollapsed, Converter={x:Static conv:ForgeConverters.InvertBool}}">
          <DockPanel>
            <Border DockPanel.Dock="Top" Padding="6,6"
                    BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="Ghost" Padding="4" Margin="2,0,0,0"
                        Click="OnToggleNavigatorCollapsed" ToolTip.Tip="Collapse sidebar">
                  <icons:MaterialIcon Kind="ChevronLeft" Width="16" Height="16" />
                </Button>
                <Button DockPanel.Dock="Right" Classes="Ghost" Padding="4" Margin="2,0,0,0"
                        Click="OnOpenRepository" ToolTip.Tip="Open repository…">
                  <icons:MaterialIcon Kind="FolderOpen" Width="16" Height="16" />
                </Button>
                <Button x:Name="RepoSwitcherButton" Classes="Ghost"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="6,4" ToolTip.Tip="{Binding CurrentRepositoryTooltip}">
                  <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft" Opened="OnRepoSwitcherFlyoutOpened">
                      <Border MinWidth="260" MaxWidth="360" MaxHeight="380" Padding="8">
                        <DockPanel>
                          <TextBox DockPanel.Dock="Top" Classes="Forge"
                                   Text="{Binding RepositoryFilter}"
                                   PlaceholderText="Filter repositories…"
                                   Margin="0,0,0,8" />
                          <TextBlock DockPanel.Dock="Bottom"
                                     Text="{Binding RepositoryCatalogEmptyText}"
                                     FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                                     Margin="4,8,4,0"
                                     IsVisible="{Binding ShowRepositoryCatalogEmpty}" />
                          <TextBlock DockPanel.Dock="Bottom"
                                     Text="Scanning…"
                                     FontSize="11" Opacity="0.7"
                                     Margin="4,8,4,0"
                                     IsVisible="{Binding ShowRepositoryCatalogScanning}" />
                          <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding FilteredRepositories}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RepositoryEntryViewModel">
                                  <Button Classes="Ghost"
                                          Classes.NavSelected="{Binding IsCurrent}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Left"
                                          Padding="8,6" Margin="0,1"
                                          Tag="{Binding Path}"
                                          Click="OnRepositoryEntryClick"
                                          ToolTip.Tip="{Binding Path}">
                                    <StackPanel Spacing="2">
                                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                 TextTrimming="CharacterEllipsis" />
                                      <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding BranchDisplay}"
                                                   IsVisible="{Binding HasBranch}"
                                                   FontSize="11" Opacity="0.75" Margin="8,0,0,0"
                                                   FontFamily="{DynamicResource ForgeCodeFont}" />
                                        <TextBlock Text="{Binding RelativePath}" FontSize="11" Opacity="0.7"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontFamily="{DynamicResource ForgeCodeFont}" />
                                      </DockPanel>
                                    </StackPanel>
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </DockPanel>
                      </Border>
                    </Flyout>
                  </Button.Flyout>
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding CurrentRepositoryName}" FontWeight="SemiBold"
                                 FontSize="12" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding CurrentRepositorySubtitle}" FontSize="10" Opacity="0.7"
                                 TextTrimming="CharacterEllipsis"
                                 FontFamily="{DynamicResource ForgeCodeFont}" />
                    </StackPanel>
                    <icons:MaterialIcon Grid.Column="1" Kind="MenuDown" Width="16" Height="16"
                                        VerticalAlignment="Center" Margin="4,0,0,0" Opacity="0.7" />
                  </Grid>
                </Button>
              </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="8"
                    BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,1,0,0">
              <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                      Command="{Binding OpenSettingsCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <icons:MaterialIcon Kind="Settings" Width="16" Height="16" />
                  <TextBlock Text="Repository Settings" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Border>

            <ScrollViewer>
              <StackPanel Margin="0,8,0,8" Spacing="2">
                <!-- WORKSPACE -->
                <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="12,4" Click="OnToggleWorkspace">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="{Binding WorkingCopy.WorkspaceExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                        Width="14" Height="14" />
                    <icons:MaterialIcon Kind="Monitor" Width="14" Height="14" Opacity="0.7" />
                    <TextBlock Text="WORKSPACE" Classes="SectionLabel" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <StackPanel IsVisible="{Binding WorkingCopy.WorkspaceExpanded}" Spacing="1">
                  <Button Classes="Ghost"
                          Classes.NavSelected="{Binding ShowFileStatusPane}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Padding="28,6,12,6" Command="{Binding SelectWorkspaceFileStatusCommand}">
                    <DockPanel>
                      <Border DockPanel.Dock="Right" Classes="Chip" VerticalAlignment="Center"
                              IsVisible="{Binding WorkingCopy.WorkingCopyChangeCount, Converter={x:Static conv:ForgeConverters.IsPositive}}">
                        <TextBlock Text="{Binding WorkingCopy.WorkingCopyChangeCount}"
                                   FontFamily="{DynamicResource ForgeCodeFont}"
                                   FontSize="{DynamicResource ForgeBadgeFontSize}"
                                   VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <icons:MaterialIcon Kind="FileDocumentOutline" Width="16" Height="16" />
                        <TextBlock Text="File Status" VerticalAlignment="Center"
                                   FontWeight="{Binding ShowFileStatusPane, Converter={x:Static conv:ForgeConverters.SelectedFontWeight}}" />
                      </StackPanel>
                    </DockPanel>
                  </Button>
                  <Button Classes="Ghost"
                          Classes.NavSelected="{Binding ShowHistoryPane}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Padding="28,6,12,6" Command="{Binding SelectWorkspaceHistoryCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <icons:MaterialIcon Kind="History" Width="16" Height="16" />
                      <TextBlock Text="History" VerticalAlignment="Center"
                                 FontWeight="{Binding ShowHistoryPane, Converter={x:Static conv:ForgeConverters.SelectedFontWeight}}" />
                    </StackPanel>
                  </Button>
                </StackPanel>

                <!-- BRANCHES -->
                <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="12,4" Click="OnToggleBranches" Margin="0,8,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="{Binding WorkingCopy.BranchesExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                        Width="14" Height="14" />
                    <icons:MaterialIcon Kind="SourceBranch" Width="14" Height="14" Opacity="0.7" />
                    <TextBlock Text="BRANCHES" Classes="SectionLabel" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding WorkingCopy.Branches}"
                              IsVisible="{Binding WorkingCopy.BranchesExpanded}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:BranchInfo">
                      <Border Padding="28,4,12,4">
                        <Border.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Check Out"
                                      Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).WorkingCopy.CheckoutBranchCommand}"
                                      CommandParameter="{Binding}" />
                          </ContextMenu>
                        </Border.ContextMenu>
                        <DockPanel>
                          <icons:MaterialIcon DockPanel.Dock="Left" Kind="Circle" Width="8" Height="8"
                                              Margin="0,0,8,0" VerticalAlignment="Center"
                                              Foreground="{DynamicResource ForgePrimaryBrush}"
                                              IsVisible="{Binding IsCurrent}" />
                          <icons:MaterialIcon DockPanel.Dock="Right" Kind="Check" Width="14" Height="14"
                                              Foreground="{DynamicResource ForgePrimaryBrush}"
                                              IsVisible="{Binding IsCurrent}" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <icons:MaterialIcon Kind="SourceBranch" Width="16" Height="16" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ForgeOnSurfaceBrush}" />
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- STASHES -->
                <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="12,4" Click="OnToggleStashes" Margin="0,8,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="{Binding WorkingCopy.StashesExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                        Width="14" Height="14" />
                    <icons:MaterialIcon Kind="Archive" Width="14" Height="14" Opacity="0.7" />
                    <TextBlock Text="STASHES" Classes="SectionLabel" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding WorkingCopy.Stashes}"
                              IsVisible="{Binding WorkingCopy.StashesExpanded}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:StashInfo">
                      <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              Padding="28,4,12,4"
                              Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).WorkingCopy.SelectStashCommand}"
                              CommandParameter="{Binding}">
                        <Button.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Apply"
                                      Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).WorkingCopy.ApplyStashCommand}"
                                      CommandParameter="{Binding}" />
                            <MenuItem Header="Delete"
                                      Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).WorkingCopy.DeleteStashCommand}"
                                      CommandParameter="{Binding}" />
                          </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <icons:MaterialIcon Kind="Archive" Width="16" Height="16" />
                          <TextBlock Text="{Binding DisplayTitle}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" MaxWidth="180" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- PULL REQUESTS -->
                <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="12,4" Click="OnTogglePullRequests" Margin="0,8,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="{Binding Review.PullRequestsExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                        Width="14" Height="14" />
                    <icons:MaterialIcon Kind="SourcePull" Width="14" Height="14" Opacity="0.7" />
                    <TextBlock Text="PULL REQUESTS" Classes="SectionLabel" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <StackPanel IsVisible="{Binding Review.PullRequestsExpanded}" Spacing="1">
                  <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Padding="28,4,12,4" Click="OnToggleNeedsMyReview">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <icons:MaterialIcon Kind="{Binding Review.NeedsMyReviewExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                          Width="12" Height="12" />
                      <TextBlock Text="Needs my review" FontSize="12" VerticalAlignment="Center" Opacity="0.85" />
                    </StackPanel>
                  </Button>
                  <ListBox Classes="PrList"
                           ItemsSource="{Binding Review.NeedsMyReview}"
                           IsVisible="{Binding Review.NeedsMyReviewExpanded}"
                           SelectionMode="Single"
                           SelectedItem="{Binding Review.SelectedPullRequest}"
                           SelectionChanged="OnPullRequestSelectionChanged"
                           Margin="36,0,8,4">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="gh:PullRequestSummary">
                        <StackPanel Spacing="2" Margin="0,4">
                          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12" />
                          <TextBlock Text="{Binding NameWithOwner}" FontSize="10" Opacity="0.6" />
                          <TextBlock FontSize="10" Opacity="0.5">
                            <Run Text="created " />
                            <Run Text="{Binding CreatedAt, Mode=OneWay, Converter={x:Static conv:ForgeConverters.RelativeTime}}" />
                          </TextBlock>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Padding="28,4,12,4" Click="OnToggleReviewed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <icons:MaterialIcon Kind="{Binding Review.ReviewedExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                          Width="12" Height="12" />
                      <TextBlock Text="Reviewed" FontSize="12" VerticalAlignment="Center" Opacity="0.85" />
                    </StackPanel>
                  </Button>
                  <ListBox Classes="PrList"
                           ItemsSource="{Binding Review.Reviewed}"
                           IsVisible="{Binding Review.ReviewedExpanded}"
                           SelectionMode="Single"
                           SelectedItem="{Binding Review.SelectedPullRequest}"
                           SelectionChanged="OnPullRequestSelectionChanged"
                           Margin="36,0,8,4">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="gh:PullRequestSummary">
                        <StackPanel Spacing="2" Margin="0,4">
                          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12" />
                          <TextBlock Text="{Binding NameWithOwner}" FontSize="10" Opacity="0.6" />
                          <TextBlock FontSize="10" Opacity="0.5">
                            <Run Text="created " />
                            <Run Text="{Binding CreatedAt, Mode=OneWay, Converter={x:Static conv:ForgeConverters.RelativeTime}}" />
                          </TextBlock>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Padding="28,4,12,4" Click="OnToggleMyPullRequests">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <icons:MaterialIcon Kind="{Binding Review.MyPullRequestsExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                          Width="12" Height="12" />
                      <TextBlock Text="My pull requests" FontSize="12" VerticalAlignment="Center" Opacity="0.85" />
                    </StackPanel>
                  </Button>
                  <ListBox Classes="PrList"
                           ItemsSource="{Binding Review.MyPullRequests}"
                           IsVisible="{Binding Review.MyPullRequestsExpanded}"
                           SelectionMode="Single"
                           SelectedItem="{Binding Review.SelectedPullRequest}"
                           SelectionChanged="OnPullRequestSelectionChanged"
                           Margin="36,0,8,4">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="gh:PullRequestSummary">
                        <StackPanel Spacing="2" Margin="0,4">
                          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12" />
                          <TextBlock Text="{Binding NameWithOwner}" FontSize="10" Opacity="0.6" />
                          <TextBlock FontSize="10" Opacity="0.5">
                            <Run Text="created " />
                            <Run Text="{Binding CreatedAt, Mode=OneWay, Converter={x:Static conv:ForgeConverters.RelativeTime}}" />
                          </TextBlock>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding GitHubAccounts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:GitHubAccountSettings">
                      <Border Padding="28,4,12,4" Margin="0,4,0,0"
                              IsVisible="{Binding NeedsReauth}"
                              Background="{DynamicResource ForgeBannerBrush}">
                        <StackPanel Spacing="4">
                          <TextBlock FontSize="11" TextWrapping="Wrap">
                            <Run Text="{Binding Login, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" on " />
                            <Run Text="{Binding Host, Mode=OneWay}" />
                            <Run Text=" needs re-authentication." />
                          </TextBlock>
                          <Button Classes="Link" Content="Open settings"
                                  Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).OpenSettingsCommand}"
                                  FontSize="11" HorizontalAlignment="Left" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns"
                      Background="{DynamicResource ForgeOutlineVariantBrush}"
                      DragCompleted="OnColumnSplitterDragCompleted" />

        <!-- File Status / Stash -->
        <Border Grid.Column="2" Background="{DynamicResource ForgeBackgroundBrush}"
                BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,1,0"
                ClipToBounds="True"
                IsVisible="{Binding ShowFileStatusPane}">
          <DockPanel>
            <Border DockPanel.Dock="Top" Height="40" Padding="16,0"
                    Background="{DynamicResource ForgeSurfaceContainerLowBrush}"
                    BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1">
              <TextBlock Text="{Binding WorkingCopy.FileListHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Border>

            <Border DockPanel.Dock="Top" Padding="8,6"
                    BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1"
                    IsVisible="{Binding ShowFileStatusPane}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="IconOnly" Width="36" Height="28" Padding="4,2"
                        Margin="6,0,0,0" VerticalAlignment="Center"
                        ToolTip.Tip="File list layout">
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="Flat list"
                                Command="{Binding WorkingCopy.SetFileStatusListLayoutCommand}"
                                CommandParameter="{x:Static core:FileListLayoutMode.Flat}"
                                ToggleType="Radio"
                                IsChecked="{Binding WorkingCopy.IsFileStatusFlatLayout, Mode=OneWay}" />
                      <MenuItem Header="Tree view"
                                Command="{Binding WorkingCopy.SetFileStatusListLayoutCommand}"
                                CommandParameter="{x:Static core:FileListLayoutMode.Tree}"
                                ToggleType="Radio"
                                IsChecked="{Binding WorkingCopy.IsFileStatusTreeLayout, Mode=OneWay}" />
                    </MenuFlyout>
                  </Button.Flyout>
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <icons:MaterialIcon Kind="{Binding WorkingCopy.FileStatusLayoutIcon}" Width="16" Height="16" />
                    <icons:MaterialIcon Kind="MenuDown" Width="12" Height="12" Opacity="0.7" />
                  </StackPanel>
                </Button>
                <Grid>
                  <TextBox Classes="Forge" Text="{Binding WorkingCopy.FileFilter}"
                           PlaceholderText="Filter files…" Padding="8,6,28,6" />
                  <Button Classes="IconOnly" Width="22" Height="22" Padding="2"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                          Command="{Binding WorkingCopy.ClearFileFilterCommand}"
                          IsVisible="{Binding WorkingCopy.HasFileFilter}"
                          ToolTip.Tip="Clear filter">
                    <icons:MaterialIcon Kind="Close" Width="14" Height="14" />
                  </Button>
                </Grid>
              </DockPanel>
            </Border>

            <!-- Commit dock FIRST so fill gets remaining space -->
            <Border DockPanel.Dock="Bottom" Padding="12"
                    Background="{DynamicResource ForgeSurfaceContainerLowestBrush}"
                    BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,1,0,0"
                    IsVisible="{Binding WorkingCopy.ShowCommitDock}">
              <StackPanel Spacing="8">
                <TextBox Classes="Forge" AcceptsReturn="True" Height="80"
                         Text="{Binding WorkingCopy.CommitMessage}"
                         PlaceholderText="Commit message..." />
                <Button Classes="Primary" Content="{Binding WorkingCopy.CommitButtonLabel}"
                        Command="{Binding WorkingCopy.CommitCommand}"
                        IsEnabled="{Binding WorkingCopy.CanCommit}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <CheckBox Content="Amend" IsChecked="{Binding WorkingCopy.AmendCommit}" FontSize="11" />
                  <CheckBox Content="--no-verify" IsChecked="{Binding WorkingCopy.NoVerify}" FontSize="11" />
                  <CheckBox Content="Push" IsChecked="{Binding WorkingCopy.PushAfterCommit}" FontSize="11" />
                </StackPanel>
                <TextBlock Text="{Binding WorkingCopy.HookOutput}" FontSize="10" Opacity="0.7"
                           TextWrapping="Wrap" IsVisible="{Binding WorkingCopy.HookOutput, Converter={x:Static conv:ForgeConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Border>

            <!-- Stash details dock (same slot as commit message on File Status) -->
            <Border DockPanel.Dock="Bottom" Padding="12"
                    Background="{DynamicResource ForgeSurfaceContainerLowestBrush}"
                    BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,1,0,0"
                    IsVisible="{Binding WorkingCopy.ShowStashDetailsDock}">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding WorkingCopy.SelectedStashMessage}"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
                <StackPanel Spacing="2" Margin="0,4,0,0">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="Ref" Width="56" FontSize="11"
                               Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                    <TextBlock Text="{Binding WorkingCopy.SelectedStashRef}" FontSize="11"
                               FontFamily="{DynamicResource ForgeCodeFont}" TextWrapping="Wrap" />
                  </DockPanel>
                  <DockPanel IsVisible="{Binding WorkingCopy.HasSelectedStashBranch}">
                    <TextBlock DockPanel.Dock="Left" Text="Branch" Width="56" FontSize="11"
                               Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                    <TextBlock Text="{Binding WorkingCopy.SelectedStashBranch}" FontSize="11"
                               TextWrapping="Wrap" />
                  </DockPanel>
                </StackPanel>
              </StackPanel>
            </Border>

            <ScrollViewer>
              <StackPanel Spacing="16" Margin="8,8,8,12">
                <!-- Stash files -->
                <StackPanel IsVisible="{Binding WorkingCopy.IsStashMode}">
                  <TextBlock Text="STASHED FILES" Classes="SectionLabel" Margin="8,0,8,4" />
                  <ListBox x:Name="StashFileList"
                           ItemsSource="{Binding WorkingCopy.StashFileEntries}"
                           SelectionMode="Single"
                           SelectionChanged="OnStashFileSelectionChanged"
                           ScrollViewer.VerticalScrollBarVisibility="Disabled"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:FileListEntry">
                        <Panel>
                          <Border Padding="8,4" CornerRadius="4" Margin="{Binding IndentMargin}"
                                  IsVisible="{Binding IsFolder}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <icons:MaterialIcon Kind="{Binding IsExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                                  Width="14" Height="14" Opacity="0.7" />
                              <icons:MaterialIcon Kind="FolderOutline" Width="16" Height="16"
                                                  Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                              <TextBlock Text="{Binding Label}" Classes="MonoPath" VerticalAlignment="Center"
                                         FontWeight="SemiBold" Opacity="0.9" />
                            </StackPanel>
                          </Border>
                          <Border Padding="8,4" CornerRadius="4" Margin="{Binding IndentMargin}"
                                  IsVisible="{Binding IsFile}">
                            <DockPanel>
                              <Border DockPanel.Dock="Right" CornerRadius="2" Padding="4,1" Margin="4,0,0,0"
                                      Background="{Binding File.Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBackground}}">
                                <TextBlock Text="{Binding File.StatusBadge}" FontSize="10" FontWeight="Bold"
                                           Foreground="{Binding File.Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBrush}}" />
                              </Border>
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="FileDocument" Width="16" Height="16"
                                                    Foreground="{Binding File.Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBrush}}" />
                                <TextBlock Text="{Binding Label}" Classes="MonoPath" VerticalAlignment="Center" />
                                <icons:MaterialIcon Kind="CheckCircleOutline" Width="12" Height="12"
                                                    Opacity="0.55" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}"
                                                    IsVisible="{Binding File.HasCachedDiff}"
                                                    ToolTip.Tip="Diff cached" />
                              </StackPanel>
                            </DockPanel>
                          </Border>
                        </Panel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="32" />
                      </Style>
                    </ListBox.Styles>
                  </ListBox>
                </StackPanel>

                <!-- Staged -->
                <StackPanel IsVisible="{Binding WorkingCopy.IsFileStatusMode}">
                  <DockPanel Margin="8,0,8,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                      <Button Classes="Link" Content="Unstage Selected"
                              Command="{Binding WorkingCopy.UnstageSelectedCommand}"
                              IsVisible="{Binding WorkingCopy.HasStagedSelection}" />
                      <Button Classes="Link" Content="Unstage All"
                              Command="{Binding WorkingCopy.UnstageAllCommand}" />
                    </StackPanel>
                    <Button Classes="Ghost" Padding="0" HorizontalAlignment="Left" Click="OnToggleStaged">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="{Binding WorkingCopy.StagedExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                            Width="14" Height="14" />
                        <TextBlock Text="STAGED CHANGES" Classes="SectionLabel" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </DockPanel>
                  <ListBox x:Name="StagedFileList"
                           ItemsSource="{Binding WorkingCopy.StagedFileEntries}"
                           SelectionMode="Multiple"
                           SelectionChanged="OnFileSelectionChanged"
                           PointerPressed="OnFileListPointerPressed"
                           ScrollViewer.VerticalScrollBarVisibility="Disabled"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           IsVisible="{Binding WorkingCopy.StagedExpanded}">
                    <ListBox.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Unstage"
                                  Command="{Binding WorkingCopy.UnstageSelectedCommand}" />
                        <MenuItem Header="Discard"
                                  Command="{Binding WorkingCopy.DiscardSelectedFilesCommand}" />
                        <Separator />
                        <MenuItem Header="{Binding WorkingCopy.RevealInFileManagerLabel}"
                                  Command="{Binding WorkingCopy.RevealSelectedInFileManagerCommand}" />
                      </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:FileListEntry">
                        <Panel>
                          <Border Padding="8,4" CornerRadius="4" Margin="{Binding IndentMargin}"
                                  IsVisible="{Binding IsFolder}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <icons:MaterialIcon Kind="{Binding IsExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                                  Width="14" Height="14" Opacity="0.7" />
                              <icons:MaterialIcon Kind="FolderOutline" Width="16" Height="16"
                                                  Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                              <TextBlock Text="{Binding Label}" Classes="MonoPath" VerticalAlignment="Center"
                                         FontWeight="SemiBold" Opacity="0.9" />
                            </StackPanel>
                          </Border>
                          <Border Classes="FileRow" Padding="8,4" CornerRadius="4" Margin="{Binding IndentMargin}"
                                  IsVisible="{Binding IsFile}">
                            <DockPanel>
                              <Border DockPanel.Dock="Right" CornerRadius="2" Padding="4,1" Margin="4,0,0,0"
                                      Background="{Binding File.Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBackground}}">
                                <TextBlock Text="{Binding File.StatusBadge}" FontSize="10" FontWeight="Bold"
                                           Foreground="{Binding File.Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBrush}}" />
                              </Border>
                              <CheckBox IsChecked="True" Margin="0,0,8,0" VerticalAlignment="Center"
                                        Click="OnFileCheckClick" Tag="{Binding File}" />
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="FileDocument" Width="16" Height="16"
                                                    Foreground="{Binding File.Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBrush}}" />
                                <TextBlock Text="{Binding Label}" Classes="MonoPath" VerticalAlignment="Center" />
                                <icons:MaterialIcon Kind="CheckCircleOutline" Width="12" Height="12"
                                                    Opacity="0.55" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}"
                                                    IsVisible="{Binding File.HasCachedDiff}"
                                                    ToolTip.Tip="Diff cached" />
                              </StackPanel>
                            </DockPanel>
                          </Border>
                        </Panel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="32" />
                      </Style>
                    </ListBox.Styles>
                  </ListBox>
                </StackPanel>

                <!-- Unstaged -->
                <StackPanel IsVisible="{Binding WorkingCopy.IsFileStatusMode}">
                  <DockPanel Margin="8,0,8,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                      <Button Classes="Link" Content="Stage Selected"
                              Command="{Binding WorkingCopy.StageSelectedCommand}"
                              IsVisible="{Binding WorkingCopy.HasUnstagedSelection}" />
                      <Button Classes="Link" Content="Stage All"
                              Command="{Binding WorkingCopy.StageAllCommand}" />
                    </StackPanel>
                    <Button Classes="Ghost" Padding="0" HorizontalAlignment="Left" Click="OnToggleUnstaged">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="{Binding WorkingCopy.UnstagedExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                            Width="14" Height="14" />
                        <TextBlock Text="UNSTAGED CHANGES" Classes="SectionLabel" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </DockPanel>
                  <ListBox x:Name="UnstagedFileList"
                           ItemsSource="{Binding WorkingCopy.UnstagedFileEntries}"
                           SelectionMode="Multiple"
                           SelectionChanged="OnFileSelectionChanged"
                           PointerPressed="OnFileListPointerPressed"
                           ScrollViewer.VerticalScrollBarVisibility="Disabled"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           IsVisible="{Binding WorkingCopy.UnstagedExpanded}">
                    <ListBox.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Stage"
                                  Command="{Binding WorkingCopy.StageSelectedCommand}" />
                        <MenuItem Header="Discard"
                                  Command="{Binding WorkingCopy.DiscardSelectedFilesCommand}" />
                        <Separator />
                        <MenuItem Header="{Binding WorkingCopy.RevealInFileManagerLabel}"
                                  Command="{Binding WorkingCopy.RevealSelectedInFileManagerCommand}" />
                      </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:FileListEntry">
                        <Panel>
                          <Border Padding="8,4" CornerRadius="4" Margin="{Binding IndentMargin}"
                                  IsVisible="{Binding IsFolder}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <icons:MaterialIcon Kind="{Binding IsExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                                  Width="14" Height="14" Opacity="0.7" />
                              <icons:MaterialIcon Kind="FolderOutline" Width="16" Height="16"
                                                  Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                              <TextBlock Text="{Binding Label}" Classes="MonoPath" VerticalAlignment="Center"
                                         FontWeight="SemiBold" Opacity="0.9" />
                            </StackPanel>
                          </Border>
                          <Border Padding="8,4" CornerRadius="4" Margin="{Binding IndentMargin}"
                                  IsVisible="{Binding IsFile}">
                            <DockPanel>
                              <Border DockPanel.Dock="Right" CornerRadius="2" Padding="4,1" Margin="4,0,0,0"
                                      Background="{Binding File.Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBackground}}">
                                <TextBlock Text="{Binding File.StatusBadge}" FontSize="10" FontWeight="Bold"
                                           Foreground="{Binding File.Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBrush}}" />
                              </Border>
                              <CheckBox IsChecked="False" Margin="0,0,8,0" VerticalAlignment="Center"
                                        Click="OnFileCheckClick" Tag="{Binding File}" />
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="FileDocument" Width="16" Height="16"
                                                    Foreground="{Binding File.Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBrush}}" />
                                <TextBlock Text="{Binding Label}" Classes="MonoPath" VerticalAlignment="Center" />
                                <icons:MaterialIcon Kind="CheckCircleOutline" Width="12" Height="12"
                                                    Opacity="0.55" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}"
                                                    IsVisible="{Binding File.HasCachedDiff}"
                                                    ToolTip.Tip="Diff cached" />
                              </StackPanel>
                            </DockPanel>
                          </Border>
                        </Panel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="32" />
                      </Style>
                    </ListBox.Styles>
                  </ListBox>
                </StackPanel>

                <!-- Conflicted -->
                <StackPanel IsVisible="{Binding WorkingCopy.IsFileStatusMode}">
                  <StackPanel IsVisible="{Binding WorkingCopy.HasConflictedFiles}">
                  <TextBlock Text="CONFLICTED" Classes="SectionLabel" Margin="8,0,8,4"
                             Foreground="{DynamicResource ForgeErrorBrush}" />
                  <ListBox x:Name="ConflictedFileList"
                           ItemsSource="{Binding WorkingCopy.ConflictedFileEntries}"
                           SelectionMode="Multiple"
                           SelectionChanged="OnFileSelectionChanged"
                           PointerPressed="OnFileListPointerPressed"
                           ScrollViewer.VerticalScrollBarVisibility="Disabled"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="{Binding WorkingCopy.RevealInFileManagerLabel}"
                                  Command="{Binding WorkingCopy.RevealSelectedInFileManagerCommand}" />
                      </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:FileListEntry">
                        <Panel>
                          <Border Padding="8,4" Margin="{Binding IndentMargin}"
                                  IsVisible="{Binding IsFolder}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <icons:MaterialIcon Kind="{Binding IsExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                                  Width="14" Height="14" Opacity="0.7" />
                              <icons:MaterialIcon Kind="FolderOutline" Width="16" Height="16"
                                                  Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                              <TextBlock Text="{Binding Label}" Classes="MonoPath" VerticalAlignment="Center"
                                         FontWeight="SemiBold" Opacity="0.9" />
                            </StackPanel>
                          </Border>
                          <Border Padding="8,4" Margin="{Binding IndentMargin}"
                                  IsVisible="{Binding IsFile}">
                            <DockPanel>
                              <Border DockPanel.Dock="Right" CornerRadius="2" Padding="4,1"
                                      Background="{DynamicResource ForgeStatusDeletedBadgeBgBrush}">
                                <TextBlock Text="C" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource ForgeErrorBrush}" />
                              </Border>
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Label}" Classes="MonoPath"
                                           Foreground="{DynamicResource ForgeErrorBrush}" />
                                <icons:MaterialIcon Kind="CheckCircleOutline" Width="12" Height="12"
                                                    Opacity="0.55" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}"
                                                    IsVisible="{Binding File.HasCachedDiff}"
                                                    ToolTip.Tip="Diff cached" />
                              </StackPanel>
                            </DockPanel>
                          </Border>
                        </Panel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- Pull request file list -->
        <Border Grid.Column="2" Background="{DynamicResource ForgeBackgroundBrush}"
                BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,1,0"
                ClipToBounds="True"
                IsVisible="{Binding ShowPullRequestPane}">
          <DockPanel>
            <Border DockPanel.Dock="Top" MinHeight="40" Padding="16,8"
                    Background="{DynamicResource ForgeSurfaceContainerLowBrush}"
                    BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1">
              <StackPanel Spacing="4">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="IconOnly" Width="28" Height="28" Padding="4"
                          Command="{Binding Review.OpenPullRequestUrlCommand}"
                          ToolTip.Tip="Open on GitHub">
                    <icons:MaterialIcon Kind="Github" Width="18" Height="18" />
                  </Button>
                  <Button DockPanel.Dock="Right" Classes="IconOnly" Width="24" Height="24" Padding="3"
                          Margin="0,0,4,0"
                          Command="{Binding Review.CancelAiReviewCommand}"
                          IsVisible="{Binding Review.IsAiRunActive}"
                          ToolTip.Tip="Cancel AI review">
                    <icons:MaterialIcon Kind="Close" Width="14" Height="14" />
                  </Button>
                  <Button DockPanel.Dock="Right" Classes="Ghost" Padding="6,3" Margin="0,0,4,0"
                          FontSize="11"
                          Command="{Binding Review.RequestAiReviewCommand}"
                          IsEnabled="{Binding Review.AiButtonEnabled}"
                          ToolTip.Tip="{Binding Review.AiButtonTooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <icons:MaterialIcon Kind="Creation" Width="14" Height="14"
                                          Foreground="{DynamicResource ForgeAiAccentBrush}" />
                      <TextBlock Text="{Binding Review.AiButtonLabel}" />
                    </StackPanel>
                  </Button>
                  <Button DockPanel.Dock="Right" Classes="IconOnly" Width="28" Height="28" Padding="4"
                          Margin="0,0,4,0"
                          Command="{Binding Review.ToggleAiChatCommand}"
                          IsEnabled="{Binding Review.HasAiTriage}"
                          ToolTip.Tip="AI chat">
                    <icons:MaterialIcon Kind="ChatOutline" Width="16" Height="16"
                                        Foreground="{DynamicResource ForgeAiAccentBrush}" />
                  </Button>
                  <TextBlock Text="Pull request files" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding Review.ProgressSummary}" FontSize="10" Opacity="0.75"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border DockPanel.Dock="Top" Padding="8,6"
                    BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="IconOnly" Width="36" Height="28" Padding="4,2"
                        Margin="6,0,0,0" VerticalAlignment="Center"
                        ToolTip.Tip="File list layout">
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="Flat list"
                                Command="{Binding Review.SetPullRequestFileListLayoutCommand}"
                                CommandParameter="{x:Static core:FileListLayoutMode.Flat}"
                                ToggleType="Radio"
                                IsChecked="{Binding Review.IsPullRequestFlatLayout, Mode=OneWay}" />
                      <MenuItem Header="Tree view"
                                Command="{Binding Review.SetPullRequestFileListLayoutCommand}"
                                CommandParameter="{x:Static core:FileListLayoutMode.Tree}"
                                ToggleType="Radio"
                                IsChecked="{Binding Review.IsPullRequestTreeLayout, Mode=OneWay}" />
                      <MenuItem Header="AI suggested order"
                                Command="{Binding Review.SetPullRequestFileListLayoutCommand}"
                                CommandParameter="{x:Static core:FileListLayoutMode.AiSuggested}"
                                ToggleType="Radio"
                                IsVisible="{Binding Review.HasAiTriage}"
                                IsChecked="{Binding Review.IsPullRequestAiSuggestedLayout, Mode=OneWay}" />
                    </MenuFlyout>
                  </Button.Flyout>
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <icons:MaterialIcon Kind="{Binding Review.PullRequestLayoutIcon}" Width="16" Height="16" />
                    <icons:MaterialIcon Kind="MenuDown" Width="12" Height="12" Opacity="0.7" />
                  </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Classes="IconOnly" Width="28" Height="28" Padding="4"
                        Margin="4,0,0,0" VerticalAlignment="Center"
                        ToolTip.Tip="Filter files">
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="All files"
                                Command="{Binding Review.SetFilterViewedCommand}"
                                CommandParameter="{x:Static core:ViewedFilter.All}"
                                ToggleType="Radio"
                                IsChecked="{Binding Review.IsFilterViewedAll, Mode=OneWay}" />
                      <MenuItem Header="Viewed"
                                Command="{Binding Review.SetFilterViewedCommand}"
                                CommandParameter="{x:Static core:ViewedFilter.Viewed}"
                                ToggleType="Radio"
                                IsChecked="{Binding Review.IsFilterViewedOnly, Mode=OneWay}" />
                      <MenuItem Header="Not viewed"
                                Command="{Binding Review.SetFilterViewedCommand}"
                                CommandParameter="{x:Static core:ViewedFilter.NotViewed}"
                                ToggleType="Radio"
                                IsChecked="{Binding Review.IsFilterNotViewed, Mode=OneWay}" />
                      <Separator />
                      <MenuItem Header="Stale"
                                Command="{Binding Review.ToggleFilterStaleCommand}"
                                ToggleType="CheckBox"
                                IsChecked="{Binding Review.FilterStale, Mode=OneWay}" />
                      <MenuItem Header="Commented"
                                Command="{Binding Review.ToggleFilterCommentedCommand}"
                                ToggleType="CheckBox"
                                IsChecked="{Binding Review.FilterCommented, Mode=OneWay}" />
                      <MenuItem Header="Unresolved"
                                Command="{Binding Review.ToggleFilterUnresolvedCommand}"
                                ToggleType="CheckBox"
                                IsChecked="{Binding Review.FilterUnresolved, Mode=OneWay}" />
                      <MenuItem Header="Review carefully (AI)"
                                Command="{Binding Review.ToggleFilterReviewCarefullyCommand}"
                                ToggleType="CheckBox"
                                IsVisible="{Binding Review.HasAiTriage}"
                                IsChecked="{Binding Review.FilterReviewCarefully, Mode=OneWay}" />
                      <MenuItem Header="Show dismissed AI annotations"
                                Command="{Binding Review.ToggleAiShowDismissedAnnotationsCommand}"
                                ToggleType="CheckBox"
                                IsVisible="{Binding Review.HasAiTriage}"
                                IsChecked="{Binding Review.AiShowDismissedAnnotations, Mode=OneWay}" />
                    </MenuFlyout>
                  </Button.Flyout>
                  <Panel>
                    <icons:MaterialIcon Kind="FilterVariant" Width="16" Height="16" />
                    <Ellipse Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-1,-1,0"
                             Fill="{DynamicResource ForgePrimaryBrush}"
                             IsVisible="{Binding Review.HasActivePrFilters}" />
                  </Panel>
                </Button>
                <Grid>
                  <TextBox x:Name="PrFileFilterBox" Classes="Forge" Text="{Binding Review.FileFilter}"
                           PlaceholderText="Filter files…" Padding="8,6,28,6" />
                  <Button Classes="IconOnly" Width="22" Height="22" Padding="2"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                          Command="{Binding Review.ClearFileFilterCommand}"
                          IsVisible="{Binding Review.HasFileFilter}"
                          ToolTip.Tip="Clear filter">
                    <icons:MaterialIcon Kind="Close" Width="14" Height="14" />
                  </Button>
                </Grid>
              </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" Padding="12" MaxHeight="180"
                    Background="{DynamicResource ForgeSurfaceContainerLowestBrush}"
                    BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,1,0,0">
              <StackPanel Spacing="6">
                <TextBlock Text="Local notes" FontSize="11" FontWeight="SemiBold" />
                <TextBox Text="{Binding Review.LocalNotes}" AcceptsReturn="True"
                         MinHeight="56" FontSize="11"
                         PlaceholderText="Private notes (never synced)" />
                <TextBlock Text="Viewed state is local-only on this GitHub instance."
                           FontSize="10" Opacity="0.7"
                           IsVisible="{Binding Review.ViewedIsLocalOnly}" />
                <TextBlock Text="Offline — changes will sync when connected."
                           FontSize="10" Foreground="{DynamicResource ForgeStatusDeletedBrush}"
                           IsVisible="{Binding Review.IsOffline}" />
              </StackPanel>
            </Border>
            <ScrollViewer>
              <StackPanel>
                <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="12,8" Command="{Binding Review.SelectConversationCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="ForumOutline" Width="16" Height="16" />
                    <TextBlock Text="Conversation" FontWeight="{Binding Review.IsConversationSelected, Converter={x:Static conv:ForgeConverters.SelectedFontWeight}}" />
                  </StackPanel>
                </Button>
                <ListBox x:Name="PrFileList"
                         ItemsSource="{Binding Review.PrFileEntries}"
                         SelectedItem="{Binding Review.SelectedPrFileEntry}"
                         SelectionMode="Single"
                         Margin="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileListEntry">
                      <Panel>
                        <Border Padding="8,4" Margin="{Binding IndentMargin}"
                                IsVisible="{Binding IsFolder}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:MaterialIcon Kind="{Binding IsExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                                Width="14" Height="14" Opacity="0.7" />
                            <icons:MaterialIcon Kind="FolderOutline" Width="16" Height="16"
                                                Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                            <TextBlock Text="{Binding Label}" Classes="MonoPath" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Opacity="0.9" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Border>
                        <Border Padding="8,4" Margin="{Binding IndentMargin}"
                                IsVisible="{Binding IsFile}">
                          <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                              <icons:MaterialIcon Kind="Eye" Width="12" Height="12" Opacity="0.6"
                                                  IsVisible="{Binding File.IsViewed}" ToolTip.Tip="Viewed" />
                              <Border CornerRadius="2" Padding="4,1" Margin="4,0,0,0"
                                      Background="{DynamicResource ForgePrimaryContainerBrush}"
                                      IsVisible="{Binding File.UnresolvedThreadCount, Converter={x:Static conv:ForgeConverters.IsPositive}}">
                                <TextBlock Text="{Binding File.UnresolvedThreadCount}" FontSize="10" FontWeight="Bold" />
                              </Border>
                              <TextBlock Text="{Binding File.AiPriorityStars, Converter={x:Static conv:ForgeConverters.AiStarsDisplay}}"
                                         FontSize="10" VerticalAlignment="Center"
                                         Foreground="{DynamicResource ForgeAiAccentBrush}"
                                         IsVisible="{Binding File.HasAiStars}"
                                         ToolTip.Tip="{Binding File.AiGuidanceTooltip}" />
                              <Border CornerRadius="2" Padding="4,1"
                                      Background="{Binding File.Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBackground}}">
                                <TextBlock Text="{Binding File.StatusBadge}" FontSize="10" FontWeight="Bold"
                                           Foreground="{Binding File.Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBrush}}" />
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Label}" Classes="MonoPath PrFileLabel"
                                       Classes.Unviewed="{Binding File.IsViewed, Converter={x:Static conv:ForgeConverters.InvertBool}}"
                                       Classes.AiSkip="{Binding File.IsAiSkip}"
                                       TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                        </Border>
                      </Panel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="3" Width="4" ResizeDirection="Columns"
                      Background="{DynamicResource ForgeOutlineVariantBrush}"
                      DragCompleted="OnColumnSplitterDragCompleted"
                      IsVisible="{Binding ShowMainFileDiffSplitter}" />

        <!-- Diff pane (File Status / Stash) -->
        <DockPanel Grid.Column="4" Background="{DynamicResource ForgeSurfaceContainerLowestBrush}"
                   IsVisible="{Binding ShowFileStatusPane}">
          <Border DockPanel.Dock="Top" MinHeight="52" Padding="12,6"
                  Background="{DynamicResource ForgeSurfaceContainerLowBrush}"
                  BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Classes="IconOnly"
                        Command="{Binding WorkingCopy.ForceRefreshDiffCommand}"
                        ToolTip.Tip="Refresh diff"
                        IsVisible="{Binding WorkingCopy.SelectedFile, Converter={x:Static conv:ForgeConverters.IsNotNull}}">
                  <icons:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                </Button>
                <Button Classes="ReviewAction"
                        Classes.Pressed="{Binding WorkingCopy.ShowFullFile}"
                        Command="{Binding WorkingCopy.ToggleShowFullFileCommand}"
                        ToolTip.Tip="{Binding WorkingCopy.FullFileToggleTooltip}">
                  <icons:MaterialIcon Kind="FileDocumentOutline" Width="18" Height="18" />
                </Button>
                <Button Classes="ReviewAction"
                        Classes.Pressed="{Binding WorkingCopy.ShowMarkdownPreview}"
                        Command="{Binding WorkingCopy.ToggleShowMarkdownPreviewCommand}"
                        IsVisible="{Binding WorkingCopy.CanShowMarkdownPreview}"
                        ToolTip.Tip="Rendered markdown">
                  <icons:MaterialIcon Kind="LanguageMarkdown" Width="18" Height="18" />
                </Button>
                <Border Width="1" Height="22" Margin="2,0"
                        Background="{DynamicResource ForgeOutlineVariantBrush}" />
                <Button Classes="IconOnly" ToolTip.Tip="Diff options">
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="Combined review"
                                Command="{Binding WorkingCopy.ToggleCombinedReviewCommand}"
                                ToggleType="CheckBox"
                                IsChecked="{Binding WorkingCopy.IsCombinedReviewMode, Mode=OneWay}" />
                      <MenuItem Header="Ignore whitespace"
                                Command="{Binding WorkingCopy.ToggleIgnoreWhitespaceCommand}"
                                ToggleType="CheckBox"
                                IsChecked="{Binding WorkingCopy.IgnoreWhitespace, Mode=OneWay}" />
                      <MenuItem Header="Context"
                                IsEnabled="{Binding WorkingCopy.ShowFullFile, Converter={x:Static conv:ForgeConverters.InvertBool}}">
                        <MenuItem Header="1"
                                  Command="{Binding WorkingCopy.SetContextLinesCommand}"
                                  CommandParameter="1"
                                  ToggleType="Radio"
                                  IsChecked="{Binding WorkingCopy.IsContextLines1, Mode=OneWay}" />
                        <MenuItem Header="3"
                                  Command="{Binding WorkingCopy.SetContextLinesCommand}"
                                  CommandParameter="3"
                                  ToggleType="Radio"
                                  IsChecked="{Binding WorkingCopy.IsContextLines3, Mode=OneWay}" />
                        <MenuItem Header="5"
                                  Command="{Binding WorkingCopy.SetContextLinesCommand}"
                                  CommandParameter="5"
                                  ToggleType="Radio"
                                  IsChecked="{Binding WorkingCopy.IsContextLines5, Mode=OneWay}" />
                        <MenuItem Header="10"
                                  Command="{Binding WorkingCopy.SetContextLinesCommand}"
                                  CommandParameter="10"
                                  ToggleType="Radio"
                                  IsChecked="{Binding WorkingCopy.IsContextLines10, Mode=OneWay}" />
                        <MenuItem Header="25"
                                  Command="{Binding WorkingCopy.SetContextLinesCommand}"
                                  CommandParameter="25"
                                  ToggleType="Radio"
                                  IsChecked="{Binding WorkingCopy.IsContextLines25, Mode=OneWay}" />
                      </MenuItem>
                      <Separator />
                      <MenuItem Header="Unified"
                                Command="{Binding WorkingCopy.SetViewModeCommand}"
                                CommandParameter="{x:Static core:DiffViewMode.Unified}"
                                ToggleType="Radio"
                                IsChecked="{Binding WorkingCopy.IsUnifiedView, Mode=OneWay}" />
                      <MenuItem Header="Side by side"
                                Command="{Binding WorkingCopy.SetViewModeCommand}"
                                CommandParameter="{x:Static core:DiffViewMode.SideBySide}"
                                ToggleType="Radio"
                                IsChecked="{Binding WorkingCopy.IsSideBySideView, Mode=OneWay}" />
                      <Separator />
                      <MenuItem Header="Discard file(s)"
                                Command="{Binding WorkingCopy.DiscardSelectedFilesCommand}" />
                      <MenuItem Header="{Binding WorkingCopy.RevealInFileManagerLabel}"
                                Command="{Binding WorkingCopy.RevealSelectedInFileManagerCommand}" />
                    </MenuFlyout>
                  </Button.Flyout>
                  <icons:MaterialIcon Kind="DotsHorizontal" Width="18" Height="18" />
                </Button>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                          IsVisible="{Binding WorkingCopy.SelectedFile, Converter={x:Static conv:ForgeConverters.IsNotNull}}">
                <icons:MaterialIcon Kind="FileDocument" Width="18" Height="18"
                                    VerticalAlignment="Top" Margin="0,2,0,0"
                                    Foreground="{DynamicResource ForgeStatusAddedBrush}" />
                <StackPanel Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding WorkingCopy.SelectedFile.Path}" FontWeight="SemiBold"
                               Classes="MonoPath" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding WorkingCopy.SelectedFileAbsolutePath}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Text="{Binding WorkingCopy.SelectedAddedLines, Converter={x:Static conv:ForgeConverters.PlusPrefix}}"
                                 FontSize="10" Foreground="{DynamicResource ForgeStatusAddedBrush}" />
                      <TextBlock Text="{Binding WorkingCopy.SelectedRemovedLines, Converter={x:Static conv:ForgeConverters.MinusPrefix}}"
                                 FontSize="10" Foreground="{DynamicResource ForgeStatusDeletedBrush}" />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Text="{Binding WorkingCopy.DiffFreshnessText}"
                             FontSize="10"
                             Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}"
                             IsVisible="{Binding WorkingCopy.DiffFreshnessText, Converter={x:Static conv:ForgeConverters.IsNotNull}}" />
                </StackPanel>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border DockPanel.Dock="Top"
                  IsVisible="{Binding WorkingCopy.ViewMode, Converter={x:Static conv:ForgeConverters.IsSideBySide}}"
                  Height="24" Background="{DynamicResource ForgeSurfaceContainerBrush}"
                  BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,*">
              <TextBlock Grid.Column="0" Text="PREVIOUS VERSION" FontSize="10" FontWeight="Bold"
                         Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}"
                         VerticalAlignment="Center" Margin="12,0" />
              <Border Grid.Column="1" BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="1,0,0,0">
                <TextBlock Text="NEW VERSION" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource ForgePrimaryBrush}"
                           VerticalAlignment="Center" Margin="12,0" />
              </Border>
            </Grid>
          </Border>

          <Border DockPanel.Dock="Bottom" Height="24" Padding="16,0"
                  Background="{DynamicResource ForgeSurfaceContainerBrush}"
                  BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource ForgeStatusAddedBrush}" />
              <TextBlock Text="{Binding WorkingCopy.DiffFooterText}" FontSize="10"
                         Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
            </StackPanel>
          </Border>

          <Panel ClipToBounds="True">
            <controls:DiffViewer Rows="{Binding WorkingCopy.DiffRows}"
                                 ViewMode="{Binding WorkingCopy.ViewMode}"
                                 EmptyMessage="{Binding WorkingCopy.DiffEmptyMessage}"
                                 CanStageLines="{Binding WorkingCopy.CanStageLines}"
                                 CanUnstageLines="{Binding WorkingCopy.CanUnstageLines}"
                                 CanDiscardLines="{Binding WorkingCopy.CanDiscardLines}"
                                 LeftSyntaxTokens="{Binding WorkingCopy.LeftSyntaxTokens}"
                                 RightSyntaxTokens="{Binding WorkingCopy.RightSyntaxTokens}"
                                 RowHeight="20"
                                 IsVisible="{Binding WorkingCopy.ShowDiffViewer}" />

            <controls:MarkdownFilePreview Markdown="{Binding WorkingCopy.MarkdownPreviewText}"
                                          EmptyMessage="{Binding WorkingCopy.MarkdownPreviewEmptyMessage}"
                                          CanAddLineComments="False"
                                          IsVisible="{Binding WorkingCopy.ShowMarkdownPreviewPane}" />

            <!-- Changed image: before | after -->
            <Grid IsVisible="{Binding WorkingCopy.HasImageBefore}"
                  ColumnDefinitions="*,4,*"
                  Background="{DynamicResource ForgeSurfaceContainerLowestBrush}">
              <DockPanel Grid.Column="0" Margin="12">
                <TextBlock DockPanel.Dock="Top" Text="Before" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" Margin="0,0,0,8" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <Image Source="{Binding WorkingCopy.ImageBefore}" Stretch="Uniform"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         MaxWidth="1200" MaxHeight="1200" />
                </ScrollViewer>
              </DockPanel>
              <Border Grid.Column="1" Background="{DynamicResource ForgeOutlineVariantBrush}" />
              <DockPanel Grid.Column="2" Margin="12">
                <TextBlock DockPanel.Dock="Top" Text="After" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" Margin="0,0,0,8" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <Image Source="{Binding WorkingCopy.ImageAfter}" Stretch="Uniform"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         MaxWidth="1200" MaxHeight="1200" />
                </ScrollViewer>
              </DockPanel>
            </Grid>

            <!-- Single image (added / untracked / no before) -->
            <ScrollViewer IsVisible="{Binding WorkingCopy.IsSingleImagePreview}"
                          Background="{DynamicResource ForgeSurfaceContainerLowestBrush}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Padding="12">
              <Image Source="{Binding WorkingCopy.ImageAfter}" Stretch="Uniform"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     MaxWidth="1200" MaxHeight="1200" />
            </ScrollViewer>

            <Border Background="{DynamicResource ForgeSettingsScrimBrush}"
                    IsVisible="{Binding WorkingCopy.IsLoadingDiff}">
              <ProgressBar Width="36" Height="36" IsIndeterminate="True"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding WorkingCopy.DiffOverlayMessage}"
                       IsVisible="{Binding WorkingCopy.DiffOverlayMessage, Converter={x:Static conv:ForgeConverters.IsNotNullOrEmpty}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
          </Panel>
        </DockPanel>

        <!-- Diff pane (Pull request) -->
        <DockPanel Grid.Column="4" Background="{DynamicResource ForgeSurfaceContainerLowestBrush}"
                   IsVisible="{Binding ShowPullRequestPane}">
          <Border DockPanel.Dock="Top" Padding="12,8"
                  Background="{DynamicResource ForgeBannerBrush}"
                  IsVisible="{Binding Review.HeadHasMoved}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="Ghost" Content="Re-run AI review" FontSize="11"
                      Command="{Binding Review.ConfirmIncrementalRereviewCommand}"
                      IsVisible="{Binding Review.HasAiTriage}" />
              <TextBlock Text="{Binding Review.HeadMovedBanner}" TextWrapping="Wrap" FontSize="12"
                         VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Top" MinHeight="52" Padding="12,6"
                  Background="{DynamicResource ForgeSurfaceContainerLowBrush}"
                  BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Classes="ReviewAction"
                        Command="{Binding Review.BeginFileCommentCommand}"
                        IsEnabled="{Binding Review.SelectedFile, Converter={x:Static conv:ForgeConverters.IsNotNull}}"
                        ToolTip.Tip="Add a file comment">
                  <icons:MaterialIcon Kind="CommentPlusOutline" Width="18" Height="18" />
                </Button>
                <Button Classes="ReviewAction"
                        Command="{Binding Review.UnmarkSelectedViewedCommand}"
                        IsEnabled="{Binding Review.SelectedFile.IsViewed}"
                        ToolTip.Tip="Mark as not viewed">
                  <icons:MaterialIcon Kind="EyeOffOutline" Width="18" Height="18" />
                </Button>
                <Button Classes="ReviewAction"
                        Classes.Pressed="{Binding Review.ShowFullFile}"
                        Command="{Binding Review.ToggleShowFullFileCommand}"
                        ToolTip.Tip="{Binding Review.FullFileToggleTooltip}">
                  <icons:MaterialIcon Kind="FileDocumentOutline" Width="18" Height="18" />
                </Button>
                <Button Classes="ReviewAction"
                        Classes.Pressed="{Binding Review.ShowMarkdownPreview}"
                        Command="{Binding Review.ToggleShowMarkdownPreviewCommand}"
                        IsVisible="{Binding Review.CanShowMarkdownPreview}"
                        ToolTip.Tip="Rendered markdown">
                  <icons:MaterialIcon Kind="LanguageMarkdown" Width="18" Height="18" />
                </Button>
                <Border Width="1" Height="22" Margin="2,0"
                        Background="{DynamicResource ForgeOutlineVariantBrush}" />
                <ItemsControl ItemsSource="{Binding Review.Reviewers}"
                              IsVisible="{Binding Review.HasReviewers}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReviewerStatusItem">
                      <Panel Width="28" Height="28" ToolTip.Tip="{Binding Tooltip}">
                        <Border Width="24" Height="24" CornerRadius="12"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{DynamicResource ForgeSurfaceContainerHighBrush}"
                                ClipToBounds="True">
                          <Panel>
                            <TextBlock Text="{Binding Initials}" FontSize="9" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}"
                                       IsVisible="{Binding HasAvatar, Converter={x:Static conv:ForgeConverters.InvertBool}}" />
                            <Image Source="{Binding Avatar}" Stretch="UniformToFill"
                                   IsVisible="{Binding HasAvatar}" />
                          </Panel>
                        </Border>
                        <Border Width="12" Height="12" CornerRadius="6"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-1,-1,0"
                                IsVisible="{Binding ShowApprovedBadge}"
                                Background="{DynamicResource ForgeStatusAddedBrush}">
                          <icons:MaterialIcon Kind="Check" Width="8" Height="8"
                                              Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Width="12" Height="12" CornerRadius="6"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-1,-1,0"
                                IsVisible="{Binding ShowChangesRequestedBadge}"
                                Background="{DynamicResource ForgeStatusRequestChangesBrush}">
                          <icons:MaterialIcon Kind="Minus" Width="8" Height="8"
                                              Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Classes="ReviewAction"
                        Command="{Binding Review.SubmitCommentReviewCommand}"
                        IsEnabled="{Binding Review.CanSubmitPendingComments}"
                        ToolTip.Tip="{Binding Review.PendingCommentsTooltip}">
                  <Panel>
                    <icons:MaterialIcon Kind="MessageOutline" Width="18" Height="18" />
                    <Border MinWidth="14" Height="14" CornerRadius="7" Padding="3,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="10,-6,-6,0"
                            Background="{DynamicResource ForgePrimaryBrush}"
                            IsVisible="{Binding Review.HasPendingComments}">
                      <TextBlock Text="{Binding Review.PendingCommentCount}" FontSize="9" FontWeight="Bold"
                                 Foreground="{DynamicResource ForgeOnPrimaryBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </Panel>
                </Button>

                <Button Classes="ReviewAction RequestChanges"
                        Classes.Pressed="{Binding Review.HasRequestedChanges}"
                        Command="{Binding Review.SubmitRequestChangesCommand}"
                        IsEnabled="{Binding Review.CanSubmitVerdict}"
                        ToolTip.Tip="{Binding Review.RequestChangesTooltip}">
                  <icons:MaterialIcon Kind="MinusCircle" Width="18" Height="18" />
                </Button>

                <Button Classes="ReviewAction Approve"
                        Classes.Pressed="{Binding Review.HasApproved}"
                        Command="{Binding Review.SubmitApproveCommand}"
                        IsEnabled="{Binding Review.CanSubmitVerdict}"
                        ToolTip.Tip="{Binding Review.ApproveTooltip}">
                  <icons:MaterialIcon Kind="CheckCircle" Width="18" Height="18" />
                </Button>

                <Button Classes="IconOnly" ToolTip.Tip="Diff options">
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="Ignore whitespace"
                                Command="{Binding Review.ToggleIgnoreWhitespaceCommand}"
                                ToggleType="CheckBox"
                                IsChecked="{Binding Review.IgnoreWhitespace, Mode=OneWay}" />
                      <Separator />
                      <MenuItem Header="Unified"
                                Command="{Binding Review.SetViewModeCommand}"
                                CommandParameter="{x:Static core:DiffViewMode.Unified}"
                                ToggleType="Radio"
                                IsChecked="{Binding Review.IsUnifiedView, Mode=OneWay}" />
                      <MenuItem Header="Side by side"
                                Command="{Binding Review.SetViewModeCommand}"
                                CommandParameter="{x:Static core:DiffViewMode.SideBySide}"
                                ToggleType="Radio"
                                IsChecked="{Binding Review.IsSideBySideView, Mode=OneWay}" />
                    </MenuFlyout>
                  </Button.Flyout>
                  <icons:MaterialIcon Kind="DotsHorizontal" Width="18" Height="18" />
                </Button>
              </StackPanel>
              <!-- Fill remaining width so path TextTrimming gets a finite measure and cannot paint over actions -->
              <Panel ClipToBounds="True">
                <TextBlock Text="Conversation" FontWeight="SemiBold" VerticalAlignment="Center"
                           IsVisible="{Binding Review.IsConversationSelected}" />
                <Panel IsVisible="{Binding Review.SelectedFile, Converter={x:Static conv:ForgeConverters.IsNotNull}}">
                  <TextBlock Text="{Binding Review.SelectedFile.Path}" FontWeight="SemiBold"
                             Classes="MonoPath" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center"
                             ToolTip.Tip="{Binding Review.SelectedFile.Path}" />
                </Panel>
              </Panel>
            </DockPanel>
          </Border>
          <Panel ClipToBounds="True">
            <ScrollViewer IsVisible="{Binding Review.IsConversationSelected}">
              <StackPanel Spacing="16" Margin="16">
                <!-- AI review -->
                <Border Background="{DynamicResource ForgeSurfaceContainerBrush}"
                        CornerRadius="8" Padding="12"
                        IsVisible="{Binding Review.HasAiTriage}">
                  <StackPanel Spacing="10">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Classes="Ghost" FontSize="11"
                              Content="Re-run"
                              IsVisible="{Binding Review.CanRerunAiReview}"
                              Command="{Binding Review.RerunAiReviewCommand}" />
                      <Button DockPanel.Dock="Right" Classes="Ghost" FontSize="11" Margin="0,0,4,0"
                              Content="Resume"
                              IsVisible="{Binding Review.CanResumeAiReview}"
                              Command="{Binding Review.ResumeAiReviewCommand}" />
                      <icons:MaterialIcon DockPanel.Dock="Right" Width="16" Height="16" Margin="0,0,8,0"
                                          Kind="{Binding Review.AiReviewSectionExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                          Opacity="0.7" />
                      <Button Classes="Ghost" Padding="0" HorizontalAlignment="Left"
                              Command="{Binding Review.ToggleAiReviewSectionCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <icons:MaterialIcon Kind="Creation" Width="14" Height="14"
                                              Foreground="{DynamicResource ForgeAiAccentBrush}" />
                          <TextBlock Text="AI REVIEW" Classes="PanelHeader" Opacity="0.7" />
                          <Border CornerRadius="2" Padding="6,2"
                                  Background="{Binding Review.AiTriage.Risk, Converter={x:Static conv:ForgeConverters.AiRiskBadgeBackground}}">
                            <TextBlock Text="{Binding Review.AiRiskBadgeText}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{Binding Review.AiTriage.Risk, Converter={x:Static conv:ForgeConverters.AiRiskBadgeBrush}}" />
                          </Border>
                          <TextBlock Text="{Binding Review.AiReviewFinishedUtc, Converter={x:Static conv:ForgeConverters.RelativeTime}}"
                                     FontSize="11" Opacity="0.6" VerticalAlignment="Center"
                                     IsVisible="{Binding Review.AiReviewFinishedUtc, Converter={x:Static conv:ForgeConverters.IsNotNull}}" />
                        </StackPanel>
                      </Button>
                    </DockPanel>
                    <StackPanel Spacing="10" IsVisible="{Binding Review.AiReviewSectionExpanded}">
                      <controls:MarkdownView Markdown="{Binding Review.AiTriage.Summary}" />
                      <SelectableTextBlock Text="{Binding Review.AiMeasuredFactsText}"
                                 FontSize="11" Opacity="0.7"
                                 IsVisible="{Binding Review.AiMeasuredFactsText, Converter={x:Static conv:ForgeConverters.IsNotNull}}" />
                      <StackPanel Spacing="6"
                                  IsVisible="{Binding Review.HasAiImportantFiles}">
                        <TextBlock Text="IMPORTANT FILES" Classes="PanelHeader" Opacity="0.7" FontSize="11" />
                        <ItemsControl ItemsSource="{Binding Review.AiImportantFiles}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AiImportantFileItem">
                              <Button Classes="Ghost" Padding="4,4" HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Left"
                                      Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).Review.SelectAiImportantFileCommand}"
                                      CommandParameter="{Binding Path}">
                                <DockPanel>
                                  <TextBlock DockPanel.Dock="Left" Text="{Binding Path}" Classes="MonoPath"
                                             FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0"
                                             TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                  <TextBlock Text="{Binding Label}" FontSize="11" TextWrapping="NoWrap"
                                             TextTrimming="CharacterEllipsis"
                                             Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                                </DockPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Description -->
                <Border Background="{DynamicResource ForgeSurfaceContainerBrush}"
                        CornerRadius="8" Padding="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="DESCRIPTION" Classes="PanelHeader" Opacity="0.7" />
                    <TextBlock Text="{Binding Review.PullRequestTitle}" FontSize="16" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Review.PullRequestSubtitle}" FontSize="12"
                               Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}"
                               TextWrapping="Wrap" />
                    <controls:MarkdownView Markdown="{Binding Review.PullRequestBody}" />
                  </StackPanel>
                </Border>

                <!-- Status -->
                <Border Background="{DynamicResource ForgeSurfaceContainerBrush}"
                        CornerRadius="8" Padding="12">
                  <StackPanel Spacing="10">
                    <TextBlock Text="STATUS" Classes="PanelHeader" Opacity="0.7" />
                    <TextBlock Text="{Binding Review.ConversationThreadSummary}" FontSize="12"
                               Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}"
                               IsVisible="{Binding Review.ConversationThreadSummary, Converter={x:Static conv:ForgeConverters.IsNotNullOrEmpty}}" />
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Text="Decision" Width="72" FontSize="12"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                      <Border HorizontalAlignment="Left" CornerRadius="2" Padding="6,2"
                              Background="{Binding Review.ReviewDecision, Converter={x:Static conv:ForgeConverters.CheckStateBadgeBackground}}">
                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                   Text="{Binding Review.ReviewDecision, Mode=OneWay, Converter={x:Static conv:ForgeConverters.NullOrEmptyDisplay}}"
                                   Foreground="{Binding Review.ReviewDecision, Converter={x:Static conv:ForgeConverters.CheckStateBadgeBrush}}" />
                      </Border>
                    </DockPanel>
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Text="Checks" Width="72" FontSize="12"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                      <Border HorizontalAlignment="Left" CornerRadius="2" Padding="6,2"
                              Background="{Binding Review.CheckRollupState, Converter={x:Static conv:ForgeConverters.CheckStateBadgeBackground}}">
                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                   Text="{Binding Review.CheckRollupState, Mode=OneWay, Converter={x:Static conv:ForgeConverters.NullOrEmptyDisplay}}"
                                   Foreground="{Binding Review.CheckRollupState, Converter={x:Static conv:ForgeConverters.CheckStateBadgeBrush}}" />
                      </Border>
                    </DockPanel>
                    <TextBlock Text="{Binding Review.MergeStateSummary}" FontSize="12"
                               Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}"
                               IsVisible="{Binding Review.MergeStateSummary, Converter={x:Static conv:ForgeConverters.IsNotNullOrEmpty}}" />
                    <ItemsControl ItemsSource="{Binding Review.StatusChecks}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="gh:StatusCheckItem">
                          <DockPanel Margin="0,2">
                            <Border DockPanel.Dock="Right" CornerRadius="2" Padding="6,2" Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="{Binding State, Converter={x:Static conv:ForgeConverters.CheckStateBadgeBackground}}">
                              <TextBlock FontSize="10" FontWeight="SemiBold"
                                         Text="{Binding State, Mode=OneWay, Converter={x:Static conv:ForgeConverters.NullOrEmptyDisplay}}"
                                         Foreground="{Binding State, Converter={x:Static conv:ForgeConverters.CheckStateBadgeBrush}}" />
                            </Border>
                            <Button Classes="Link" Padding="0" HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).Review.OpenUrlCommand}"
                                    CommandParameter="{Binding Url}"
                                    IsVisible="{Binding Url, Converter={x:Static conv:ForgeConverters.IsNotNullOrEmpty}}">
                              <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" />
                            </Button>
                            <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding Url, Converter={x:Static conv:ForgeConverters.IsNullOrEmpty}}" />
                          </DockPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- Timeline -->
                <Border Background="{DynamicResource ForgeSurfaceContainerBrush}"
                        CornerRadius="8" Padding="12">
                  <StackPanel Spacing="10">
                    <TextBlock Text="TIMELINE" Classes="PanelHeader" Opacity="0.7" />
                    <ItemsControl ItemsSource="{Binding Review.Timeline}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="gh:PullRequestTimelineEntry">
                          <Border Margin="0,0,0,8" Padding="10"
                                  Background="{DynamicResource ForgeSurfaceContainerLowBrush}"
                                  CornerRadius="6"
                                  BorderBrush="{DynamicResource ForgeOutlineVariantBrush}"
                                  BorderThickness="1">
                            <StackPanel Spacing="6">
                              <DockPanel>
                                <TextBlock DockPanel.Dock="Right" FontSize="11" Opacity="0.6"
                                           VerticalAlignment="Center"
                                           Text="{Binding CreatedAt, Mode=OneWay, Converter={x:Static conv:ForgeConverters.RelativeTime}}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <TextBlock Text="{Binding AuthorLogin, Mode=OneWay}" FontSize="12"
                                             FontWeight="SemiBold" VerticalAlignment="Center" />
                                  <Border Classes="Chip" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Kind, Mode=OneWay}" FontSize="10" />
                                  </Border>
                                  <Border CornerRadius="2" Padding="6,2" VerticalAlignment="Center"
                                          IsVisible="{Binding ReviewState, Converter={x:Static conv:ForgeConverters.IsNotNullOrEmpty}}"
                                          Background="{Binding ReviewState, Converter={x:Static conv:ForgeConverters.CheckStateBadgeBackground}}">
                                    <TextBlock FontSize="10" FontWeight="SemiBold"
                                               Text="{Binding ReviewState, Mode=OneWay}"
                                               Foreground="{Binding ReviewState, Converter={x:Static conv:ForgeConverters.CheckStateBadgeBrush}}" />
                                  </Border>
                                </StackPanel>
                              </DockPanel>
                              <controls:MarkdownView Markdown="{Binding Body}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
            <Grid x:Name="PrDiffChatGrid"
                  IsVisible="{Binding Review.IsConversationSelected, Converter={x:Static conv:ForgeConverters.InvertBool}}">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="100" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="0" MinHeight="0" MaxHeight="560" />
              </Grid.RowDefinitions>
              <DockPanel Grid.Row="0">
              <Border DockPanel.Dock="Top" Padding="10" MaxHeight="220"
                      Background="{DynamicResource ForgeSurfaceContainerBrush}"
                      BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1"
                      IsVisible="{Binding Review.ShowAiFileBand}">
                <DockPanel>
                  <Button DockPanel.Dock="Top" Classes="Ghost" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left" Padding="0,0,0,6"
                          Command="{Binding Review.ToggleAiFileBandCommand}">
                    <DockPanel>
                      <icons:MaterialIcon DockPanel.Dock="Right" Width="16" Height="16"
                                          Kind="{Binding Review.AiFileBandChevron}"
                                          Opacity="0.7" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="Creation" Width="14" Height="14"
                                            Foreground="{DynamicResource ForgeAiAccentBrush}" />
                        <TextBlock Text="AI GUIDANCE" Classes="PanelHeader" Opacity="0.7"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Review.SelectedFile.AiPriorityStars, Converter={x:Static conv:ForgeConverters.AiStarsDisplay}}"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForgeAiAccentBrush}"
                                   IsVisible="{Binding Review.SelectedFile.HasAiStars}" />
                      </StackPanel>
                    </DockPanel>
                  </Button>
                  <ScrollViewer MaxHeight="180" IsVisible="{Binding Review.AiFileBandExpanded}">
                    <StackPanel Spacing="6">
                      <SelectableTextBlock Text="{Binding Review.SelectedFileAiGuidance}" FontSize="12"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding Review.SelectedFileAiGuidance, Converter={x:Static conv:ForgeConverters.IsNotNullOrEmpty}}" />
                      <SelectableTextBlock Text="{Binding Review.AiFileSummary.Purpose}" FontSize="12" TextWrapping="Wrap"
                                 IsVisible="{Binding Review.HasAiFileSummary}" />
                      <SelectableTextBlock Text="{Binding Review.AiFileSummary.InterestingChanges}" FontSize="12"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding Review.HasAiFileSummary}"
                                 Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                      <SelectableTextBlock Text="{Binding Review.AiFileSummary.ReviewFocus}" FontSize="12" FontStyle="Italic"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding Review.HasAiFileSummary}"
                                 Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                      <DockPanel Margin="0,6,0,0" IsVisible="{Binding Review.HasAiFileSummary}">
                        <Button DockPanel.Dock="Right" Classes="Ghost" Content="Ask" FontSize="11" Margin="6,0,0,0"
                                Command="{Binding Review.AskFileQuestionCommand}" />
                        <TextBox Text="{Binding Review.AiFileQuestion}" FontSize="12"
                                 PlaceholderText="Ask a question about this file…" />
                      </DockPanel>
                      <controls:MarkdownView Markdown="{Binding Review.AiFileAnswer}"
                                             IsVisible="{Binding Review.HasAiFileAnswer}" />
                    </StackPanel>
                  </ScrollViewer>
                </DockPanel>
              </Border>
              <Border DockPanel.Dock="Bottom" MaxHeight="180" Padding="8"
                      Background="{DynamicResource ForgeSurfaceContainerBrush}"
                      BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,1,0,0"
                      IsVisible="{Binding Review.FileLevelThreads.Count, Converter={x:Static conv:ForgeConverters.IsPositive}}">
                <DockPanel>
                  <Button DockPanel.Dock="Top" Classes="Ghost" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left" Padding="0,0,0,4"
                          Command="{Binding Review.ToggleFileCommentsSectionCommand}">
                    <DockPanel>
                      <icons:MaterialIcon DockPanel.Dock="Right" Width="16" Height="16"
                                          Kind="{Binding Review.FileCommentsSectionChevron}"
                                          Opacity="0.7" />
                      <TextBlock Text="{Binding Review.FileCommentsSectionHeader}" FontWeight="SemiBold"
                                 VerticalAlignment="Center" />
                    </DockPanel>
                  </Button>
                  <ScrollViewer IsVisible="{Binding Review.IsFileCommentsSectionExpanded}">
                    <ItemsControl ItemsSource="{Binding Review.FileLevelThreads}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="review:ReviewThread">
                          <Border Padding="0,4" BorderBrush="{DynamicResource ForgeOutlineVariantBrush}"
                                  BorderThickness="0,0,0,1"
                                  PointerPressed="OnFileOrUnplaceableThreadPressed"
                                  Tag="{Binding}">
                            <StackPanel Spacing="4">
                              <ItemsControl ItemsSource="{Binding Comments}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="review:ReviewComment">
                                    <controls:MarkdownView Markdown="{Binding Body}" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Border>
              <Border DockPanel.Dock="Bottom" MaxHeight="180" Padding="8"
                      Background="{DynamicResource ForgeSurfaceContainerBrush}"
                      BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,1,0,0"
                      IsVisible="{Binding Review.UnplaceableThreads.Count, Converter={x:Static conv:ForgeConverters.IsPositive}}">
                <DockPanel>
                  <Button DockPanel.Dock="Top" Classes="Ghost" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left" Padding="0,0,0,4"
                          Command="{Binding Review.ToggleUnplaceableSectionCommand}">
                    <DockPanel>
                      <icons:MaterialIcon DockPanel.Dock="Right" Width="16" Height="16"
                                          Kind="{Binding Review.UnplaceableSectionChevron}"
                                          Opacity="0.7" />
                      <TextBlock Text="{Binding Review.UnplaceableSectionHeader}" FontWeight="SemiBold"
                                 VerticalAlignment="Center" />
                    </DockPanel>
                  </Button>
                  <ScrollViewer IsVisible="{Binding Review.IsUnplaceableSectionExpanded}">
                    <ItemsControl ItemsSource="{Binding Review.UnplaceableThreads}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="review:ReviewThread">
                          <Border Padding="0,4" BorderBrush="{DynamicResource ForgeOutlineVariantBrush}"
                                  BorderThickness="0,0,0,1"
                                  PointerPressed="OnFileOrUnplaceableThreadPressed"
                                  Tag="{Binding}">
                            <StackPanel Spacing="4">
                              <TextBlock Text="{Binding DisplayContext}" FontFamily="{DynamicResource ForgeCodeFont}"
                                         FontSize="11" TextWrapping="Wrap"
                                         IsVisible="{Binding DisplayContext, Converter={x:Static conv:ForgeConverters.IsNotNullOrEmpty}}" />
                              <ItemsControl ItemsSource="{Binding Comments}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="review:ReviewComment">
                                    <controls:MarkdownView Markdown="{Binding Body}" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Border>
              <Border DockPanel.Dock="Right" Width="280" Padding="8"
                      Background="{DynamicResource ForgeSurfaceContainerLowBrush}"
                      BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="1,0,0,0"
                      IsVisible="{Binding Review.ShowSideThreadPanel}">
                <DockPanel>
                  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Classes="Ghost" Content="Close" FontSize="11"
                            Command="{Binding Review.ClearExpandedThreadCommand}" />
                    <TextBlock Text="Thread" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </DockPanel>
                  <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0"
                              IsVisible="{Binding Review.IsEditingComment}">
                    <TextBox x:Name="SideThreadEditBox"
                             Text="{Binding Review.NewCommentBody}"
                             AcceptsReturn="True"
                             MinHeight="40"
                             PlaceholderText="{Binding Review.DraftPlaceholder}"
                             TextChanged="OnCommentDraftTextChanged"
                             KeyDown="OnCommentDraftKeyDown" />
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Classes="Primary"
                              Content="{Binding Review.DraftPrimaryActionLabel}"
                              Command="{Binding Review.AddCommentCommand}" />
                      <Button Classes="Ghost" Content="Cancel" FontSize="11"
                              Command="{Binding Review.ClearDraftCommentAnchorCommand}" />
                    </DockPanel>
                  </StackPanel>
                  <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0"
                              IsVisible="{Binding Review.CanReplyToSelectedThread}">
                    <TextBox x:Name="SideThreadReplyBox"
                             Text="{Binding Review.ReplyBody}"
                             AcceptsReturn="True"
                             MinHeight="40"
                             PlaceholderText="Reply…"
                             TextChanged="OnCommentDraftTextChanged"
                             KeyDown="OnCommentDraftKeyDown" />
                    <Button Classes="Primary" Content="Reply" HorizontalAlignment="Right"
                            Command="{Binding Review.ReplyToThreadCommand}" />
                  </StackPanel>
                  <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Review.SelectedThread.Comments}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="review:ReviewComment">
                          <StackPanel Spacing="4" Margin="0,0,0,8">
                            <DockPanel>
                              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4"
                                          IsVisible="{Binding ViewerDidAuthor}">
                                <Button Classes="Ghost" Content="Edit" FontSize="10" Padding="4,0"
                                        IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).Review.CanMutateSelectedThreadComments}"
                                        Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).Review.BeginEditCommentCommand}"
                                        CommandParameter="{Binding}" />
                                <Button Classes="Ghost" Content="Delete" FontSize="10" Padding="4,0"
                                        IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).Review.CanMutateSelectedThreadComments}"
                                        Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).Review.DeleteCommentCommand}"
                                        CommandParameter="{Binding}" />
                              </StackPanel>
                              <TextBlock FontSize="11" Opacity="0.7">
                                <Run Text="{Binding AuthorLogin, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text=" · " />
                                <Run Text="{Binding CreatedAt, Mode=OneWay}" />
                              </TextBlock>
                            </DockPanel>
                            <controls:MarkdownView Markdown="{Binding Body}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Border>
              <Panel ClipToBounds="True">
                <controls:DiffViewer x:Name="PrDiffViewer"
                                     Rows="{Binding Review.DiffRows}"
                                     ViewMode="{Binding Review.ViewMode}"
                                     EmptyMessage="{Binding Review.DiffEmptyMessage}"
                                     Annotations="{Binding Review.DiffAnnotations}"
                                     SelectedAnnotation="{Binding Review.SelectedAnnotation, Mode=TwoWay}"
                                     LeftSyntaxTokens="{Binding Review.LeftSyntaxTokens}"
                                     RightSyntaxTokens="{Binding Review.RightSyntaxTokens}"
                                     CanAddLineComments="True"
                                     AddLineCommentCommand="{Binding Review.BeginLineCommentCommand}"
                                     CanStageLines="False"
                                     CanUnstageLines="False"
                                     CanDiscardLines="False"
                                     RowHeight="20"
                                     IsVisible="{Binding Review.ShowDiffViewer}" />
                <controls:MarkdownFilePreview x:Name="PrMarkdownPreview"
                                              Markdown="{Binding Review.MarkdownPreviewText}"
                                              EmptyMessage="{Binding Review.MarkdownPreviewEmptyMessage}"
                                              Annotations="{Binding Review.DiffAnnotations}"
                                              SelectedAnnotation="{Binding Review.SelectedAnnotation, Mode=TwoWay}"
                                              CanAddLineComments="True"
                                              AddLineCommentCommand="{Binding Review.BeginLineCommentCommand}"
                                              IsVisible="{Binding Review.ShowMarkdownPreviewPane}" />
                <Canvas IsVisible="{Binding Review.HasDraftCommentAnchor}">
                  <Border x:Name="InlineCommentDraft"
                          Width="520" MaxWidth="640"
                          Padding="12"
                          Background="{DynamicResource ForgeSurfaceContainerHighestBrush}"
                          BorderBrush="{DynamicResource ForgeOutlineVariantBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          BoxShadow="0 4 16 0 #40000000">
                    <StackPanel Spacing="8">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="Ghost" Content="Cancel" FontSize="11"
                                Command="{Binding Review.ClearDraftCommentAnchorCommand}" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding Review.DraftCommentTargetLabel}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForgePrimaryBrush}"
                                   VerticalAlignment="Center" TextWrapping="NoWrap" />
                      </DockPanel>
                      <TextBox x:Name="InlineCommentDraftBox"
                               Text="{Binding Review.NewCommentBody}"
                               AcceptsReturn="True"
                               MinHeight="72"
                               PlaceholderText="{Binding Review.DraftPlaceholder}"
                               TextChanged="OnCommentDraftTextChanged"
                               KeyDown="OnCommentDraftKeyDown" />
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                          <Button Classes="Ghost" Content="Add a suggestion" FontSize="11"
                                  Command="{Binding Review.InsertSuggestionCommand}" />
                          <Button Classes="Primary" Content="{Binding Review.DraftPrimaryActionLabel}"
                                  Command="{Binding Review.AddCommentCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <Button Classes="Ghost" Content="Explain" FontSize="10" Padding="4,0"
                                  Command="{Binding Review.RunAiInlineActionCommand}"
                                  CommandParameter="explain"
                                  ToolTip.Tip="Ask AI to explain the selected lines" />
                          <Button Classes="Ghost" Content="Review" FontSize="10" Padding="4,0"
                                  Command="{Binding Review.RunAiInlineActionCommand}"
                                  CommandParameter="review"
                                  ToolTip.Tip="Ask AI to review the selected lines" />
                          <Button Classes="Ghost" Content="Find bugs" FontSize="10" Padding="4,0"
                                  Command="{Binding Review.RunAiInlineActionCommand}"
                                  CommandParameter="find_bugs"
                                  ToolTip.Tip="Ask AI to look for bugs in the selected lines" />
                          <Button Classes="Ghost" Content="Suggest tests" FontSize="10" Padding="4,0"
                                  Command="{Binding Review.RunAiInlineActionCommand}"
                                  CommandParameter="suggest_tests"
                                  ToolTip.Tip="Ask AI to suggest tests for the selected lines" />
                        </StackPanel>
                      </DockPanel>
                    </StackPanel>
                  </Border>
                </Canvas>
                <Canvas IsVisible="{Binding Review.HasExpandedAiAnnotation}">
                  <Border x:Name="InlineAiAnnotationCard"
                          Width="520" MaxWidth="640"
                          Padding="12"
                          Background="{DynamicResource ForgeSurfaceContainerHighestBrush}"
                          BorderBrush="{DynamicResource ForgeAiAccentBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          BoxShadow="0 4 16 0 #40000000">
                    <StackPanel Spacing="8">
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                          <Button Classes="Ghost" Content="Insert comment" FontSize="11"
                                  Command="{Binding Review.InsertAiAnnotationAsCommentCommand}"
                                  CommandParameter="{Binding Review.SelectedAiAnnotation.Result}" />
                          <Button Classes="Ghost" Content="Dismiss" FontSize="11"
                                  Command="{Binding Review.DismissAiAnnotationCommand}"
                                  CommandParameter="{Binding Review.SelectedAiAnnotation.Result}" />
                          <Button Classes="Ghost" Content="Close" FontSize="11"
                                  Command="{Binding Review.ClearExpandedThreadCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <icons:MaterialIcon Kind="Creation" Width="14" Height="14"
                                              Foreground="{DynamicResource ForgeAiAccentBrush}" />
                          <TextBlock Text="AI annotation" FontSize="11" FontWeight="SemiBold"
                                     Foreground="{DynamicResource ForgeAiAccentBrush}" />
                          <Border CornerRadius="2" Padding="6,1"
                                  Background="{DynamicResource ForgeAiAccentBadgeBgBrush}">
                            <TextBlock FontSize="10" FontWeight="SemiBold"
                                       Text="{Binding Review.SelectedAiAnnotation.Result.Severity}"
                                       Foreground="{DynamicResource ForgeAiAccentBrush}" />
                          </Border>
                        </StackPanel>
                      </DockPanel>
                      <controls:MarkdownView Markdown="{Binding Review.SelectedAiAnnotation.Result.Body}" />
                    </StackPanel>
                  </Border>
                </Canvas>
                <Canvas IsVisible="{Binding Review.HasExpandedInlineThread}">
                  <Border x:Name="InlineThreadCard"
                          Width="520" MaxWidth="640"
                          Padding="12"
                          Background="{DynamicResource ForgeSurfaceContainerHighestBrush}"
                          BorderBrush="{DynamicResource ForgePrimaryBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          BoxShadow="0 4 16 0 #40000000">
                    <DockPanel>
                      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                          <Button Classes="Ghost" Content="Open in sidebar" FontSize="11"
                                  Command="{Binding Review.OpenSelectedThreadInSidebarCommand}" />
                          <Button Classes="Ghost" Content="Close" FontSize="11"
                                  Command="{Binding Review.ClearExpandedThreadCommand}" />
                        </StackPanel>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                          <TextBlock Text="Thread" FontSize="11" FontWeight="SemiBold"
                                     Foreground="{DynamicResource ForgePrimaryBrush}" />
                          <TextBlock Text="Not yet synced to GitHub" FontSize="10" Opacity="0.65"
                                     IsVisible="{Binding Review.IsSelectedThreadPendingSync}" />
                        </StackPanel>
                      </DockPanel>
                      <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0"
                                  IsVisible="{Binding Review.CanReplyToSelectedThread}">
                        <TextBox x:Name="InlineThreadReplyBox"
                                 Text="{Binding Review.ReplyBody}"
                                 AcceptsReturn="True"
                                 MinHeight="48"
                                 PlaceholderText="Reply…"
                                 TextChanged="OnCommentDraftTextChanged"
                                 KeyDown="OnCommentDraftKeyDown" />
                        <Button Classes="Primary" Content="Reply" HorizontalAlignment="Right"
                                Command="{Binding Review.ReplyToThreadCommand}" />
                      </StackPanel>
                      <ScrollViewer MaxHeight="220">
                        <ItemsControl ItemsSource="{Binding Review.SelectedThread.Comments}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="review:ReviewComment">
                              <StackPanel Spacing="4" Margin="0,0,0,10">
                                <DockPanel>
                                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4"
                                              IsVisible="{Binding ViewerDidAuthor}">
                                    <Button Classes="Ghost" Content="Edit" FontSize="10" Padding="4,0"
                                            IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).Review.CanMutateSelectedThreadComments}"
                                            Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).Review.BeginEditCommentCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Classes="Ghost" Content="Delete" FontSize="10" Padding="4,0"
                                            IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).Review.CanMutateSelectedThreadComments}"
                                            Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).Review.DeleteCommentCommand}"
                                            CommandParameter="{Binding}" />
                                  </StackPanel>
                                  <TextBlock FontSize="11" Opacity="0.7">
                                    <Run Text="{Binding AuthorLogin, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding CreatedAt, Mode=OneWay}" />
                                  </TextBlock>
                                </DockPanel>
                                <controls:MarkdownView Markdown="{Binding Body}" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </DockPanel>
                  </Border>
                </Canvas>
                <Popup x:Name="CommentMentionPopup"
                       IsLightDismissEnabled="True"
                       Placement="AnchorAndGravity"
                       Closed="OnMentionPopupClosed">
                  <Border Background="{DynamicResource ForgeSurfaceContainerHighestBrush}"
                          BorderBrush="{DynamicResource ForgeOutlineVariantBrush}"
                          BorderThickness="1"
                          CornerRadius="6"
                          Padding="4"
                          MinWidth="220"
                          MaxHeight="200"
                          BoxShadow="0 4 12 0 #40000000">
                    <ListBox ItemsSource="{Binding Review.MentionCandidates}"
                             SelectedIndex="{Binding Review.SelectedMentionIndex}"
                             MaxHeight="192">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="gh:MentionableUser">
                          <Border Padding="8,6" PointerPressed="OnMentionCandidatePressed">
                            <TextBlock FontSize="12">
                              <Run Text="@" /><Run Text="{Binding Login}" />
                            </TextBlock>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Border>
                </Popup>
              </Panel>
            </DockPanel>
              <GridSplitter Grid.Row="1" Height="4" ResizeDirection="Rows"
                            Background="{DynamicResource ForgeOutlineVariantBrush}"
                            IsVisible="{Binding Review.ShowAiChat}" />
              <Border Grid.Row="2" Padding="10"
                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                      Background="{DynamicResource ForgeSurfaceContainerBrush}"
                      BorderBrush="{DynamicResource ForgeAiAccentBrush}" BorderThickness="0,1,0,0"
                      IsVisible="{Binding Review.ShowAiChat}">
                <Grid RowDefinitions="Auto,*,Auto,Auto">
                  <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                      <Button Classes="Ghost" Content="Clear" FontSize="11"
                              Command="{Binding Review.ClearAiChatCommand}"
                              IsEnabled="{Binding Review.CanClearAiChat}"
                              ToolTip.Tip="Clear chat history and start a new conversation" />
                      <Button Classes="Ghost" Content="Close" FontSize="11"
                              Command="{Binding Review.ToggleAiChatCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <icons:MaterialIcon Kind="ChatOutline" Width="14" Height="14"
                                            Foreground="{DynamicResource ForgeAiAccentBrush}" />
                        <TextBlock Text="AI CHAT" Classes="PanelHeader" Opacity="0.7" />
                      </StackPanel>
                      <TextBlock Text="{Binding Review.AiChatSelectedFileLabel}" FontSize="10"
                                 Opacity="0.55" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DockPanel>
                  <ScrollViewer x:Name="AiChatScrollViewer" Grid.Row="1"
                                VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Review.AiChatMessages}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ai:AiChatMessage">
                          <Border Margin="0,0,0,8" Padding="8" CornerRadius="6"
                                  Background="{DynamicResource ForgeSurfaceContainerHighBrush}">
                            <StackPanel Spacing="4">
                              <TextBlock Text="{Binding Role}" FontSize="10" FontWeight="SemiBold"
                                         Foreground="{DynamicResource ForgeAiAccentBrush}" />
                              <controls:MarkdownView Markdown="{Binding Content}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                              Margin="0,6,0,0" VerticalAlignment="Center"
                              IsVisible="{Binding Review.IsAiChatBusy}">
                    <ProgressBar Width="72" Height="3" IsIndeterminate="True"
                                 VerticalAlignment="Center" />
                    <TextBlock Text="Thinking…" FontSize="11" Opacity="0.7"
                               VerticalAlignment="Center" />
                  </StackPanel>
                  <DockPanel Grid.Row="3" Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Classes="Primary" Content="Send" Margin="6,0,0,0"
                            Command="{Binding Review.SendAiChatCommand}"
                            IsEnabled="{Binding Review.CanSendAiChat}" />
                    <TextBox Text="{Binding Review.AiChatInput}" FontSize="12"
                             PlaceholderText="{Binding Review.AiChatPlaceholder}"
                             KeyDown="OnAiChatKeyDown" />
                  </DockPanel>
                </Grid>
              </Border>
            </Grid>
            <Border Background="{DynamicResource ForgeSettingsScrimBrush}"
                    IsVisible="{Binding Review.IsLoadingDiff}">
              <ProgressBar Width="36" Height="36" IsIndeterminate="True"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Panel>
        </DockPanel>

        <!-- Full PR pane loading overlay (file list + diff) -->
        <Border Grid.Column="2" Grid.ColumnSpan="3"
                Background="{DynamicResource ForgeSettingsScrimBrush}"
                ZIndex="40"
                IsVisible="{Binding Review.IsOpeningPullRequest}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <ProgressBar Width="36" Height="36" IsIndeterminate="True"
                         HorizontalAlignment="Center" />
            <TextBlock Text="Loading pull request…" FontSize="13"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource ForgeOnSurfaceBrush}" />
          </StackPanel>
        </Border>

        <!-- History mode: commit list on top; files + details + diff below -->
        <Grid Grid.Column="2" Grid.ColumnSpan="3"
              IsVisible="{Binding ShowHistoryPane}"
              RowDefinitions="*,4,*"
              Background="{DynamicResource ForgeBackgroundBrush}">

          <!-- Commit list -->
          <DockPanel Grid.Row="0" MinHeight="160">
            <Border DockPanel.Dock="Top" Height="40" Padding="16,0"
                    Background="{DynamicResource ForgeSurfaceContainerLowBrush}"
                    BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1">
              <DockPanel>
                <TextBlock Text="Refreshing…"
                           DockPanel.Dock="Right"
                           FontSize="10" VerticalAlignment="Center"
                           Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}"
                           IsVisible="{Binding WorkingCopy.IsHistoryRefreshing}" />
                <TextBlock Text="History" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top" Padding="8,6"
                    BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1">
              <Grid>
                <TextBox Classes="Forge" Text="{Binding WorkingCopy.HistorySearchText}"
                         PlaceholderText="Search commits…" Padding="8,6,28,6" />
                <Button Classes="IconOnly" Width="22" Height="22" Padding="2"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                        Command="{Binding WorkingCopy.ClearHistorySearchCommand}"
                        IsVisible="{Binding WorkingCopy.HasHistorySearch}"
                        ToolTip.Tip="Clear search">
                  <icons:MaterialIcon Kind="Close" Width="14" Height="14" />
                </Button>
              </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="8,6"
                    BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,1,0,0"
                    IsVisible="{Binding WorkingCopy.HasMoreHistory}">
              <Button Classes="Ghost" Content="Load more"
                      Command="{Binding WorkingCopy.LoadMoreHistoryCommand}"
                      HorizontalAlignment="Center"
                      IsEnabled="{Binding WorkingCopy.CanLoadMoreHistory}" />
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="8"
                    IsVisible="{Binding WorkingCopy.IsHistoryLoading}">
              <ProgressBar Height="3" IsIndeterminate="True" />
            </Border>

            <!-- Column headers -->
            <Border DockPanel.Dock="Top" Padding="12,6"
                    Background="{DynamicResource ForgeSurfaceContainerBrush}"
                    BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,90,140,120">
                <TextBlock Grid.Column="0" Text="Description" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                <TextBlock Grid.Column="1" Text="Commit" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                <TextBlock Grid.Column="2" Text="Author" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                <TextBlock Grid.Column="3" Text="Date" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
              </Grid>
            </Border>

            <ListBox x:Name="HistoryCommitList"
                     ItemsSource="{Binding WorkingCopy.HistoryCommits}"
                     SelectionMode="Single"
                     SelectionChanged="OnHistoryCommitSelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:CommitInfo">
                  <Border Padding="12,6">
                    <Grid ColumnDefinitions="*,90,140,120">
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <ItemsControl ItemsSource="{Binding Decorations}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <Border Background="{DynamicResource ForgePrimaryContainerBrush}"
                                      CornerRadius="3" Padding="5,1">
                                <TextBlock Text="{Binding}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForgeOnSurfaceBrush}" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding ShortOid}"
                                 FontFamily="{DynamicResource ForgeCodeFont}" FontSize="12"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                      <TextBlock Grid.Column="2" Text="{Binding AuthorName}" TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3"
                                 Text="{Binding AuthorDate, Converter={x:Static conv:ForgeConverters.CommitDateDisplay}}"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" FontSize="12" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="MinHeight" Value="32" />
                </Style>
              </ListBox.Styles>
            </ListBox>
          </DockPanel>

          <GridSplitter Grid.Row="1" Height="4" ResizeDirection="Rows"
                        Background="{DynamicResource ForgeOutlineVariantBrush}" />

          <!-- Files + details | Diff -->
          <Grid Grid.Row="2" ColumnDefinitions="300,4,*" MinHeight="180">
            <Border Grid.Column="0" Background="{DynamicResource ForgeBackgroundBrush}"
                    BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,1,0"
                    ClipToBounds="True">
              <DockPanel>
                <Border DockPanel.Dock="Top" Height="40" Padding="16,0"
                        Background="{DynamicResource ForgeSurfaceContainerLowBrush}"
                        BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1">
                  <TextBlock Text="Files" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Border>

                <Border DockPanel.Dock="Top" Padding="8,6"
                        BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="IconOnly" Width="36" Height="28" Padding="4,2"
                            Margin="6,0,0,0" VerticalAlignment="Center"
                            ToolTip.Tip="File list layout">
                      <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                          <MenuItem Header="Flat list"
                                    Command="{Binding WorkingCopy.SetHistoryFileListLayoutCommand}"
                                    CommandParameter="{x:Static core:FileListLayoutMode.Flat}"
                                    ToggleType="Radio"
                                    IsChecked="{Binding WorkingCopy.IsHistoryFlatLayout, Mode=OneWay}" />
                          <MenuItem Header="Tree view"
                                    Command="{Binding WorkingCopy.SetHistoryFileListLayoutCommand}"
                                    CommandParameter="{x:Static core:FileListLayoutMode.Tree}"
                                    ToggleType="Radio"
                                    IsChecked="{Binding WorkingCopy.IsHistoryTreeLayout, Mode=OneWay}" />
                        </MenuFlyout>
                      </Button.Flyout>
                      <StackPanel Orientation="Horizontal" Spacing="2">
                        <icons:MaterialIcon Kind="{Binding WorkingCopy.HistoryLayoutIcon}" Width="16" Height="16" />
                        <icons:MaterialIcon Kind="MenuDown" Width="12" Height="12" Opacity="0.7" />
                      </StackPanel>
                    </Button>
                    <Grid>
                      <TextBox Classes="Forge" Text="{Binding WorkingCopy.HistoryFileFilter}"
                               PlaceholderText="Filter files…" Padding="8,6,28,6" />
                      <Button Classes="IconOnly" Width="22" Height="22" Padding="2"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                              Command="{Binding WorkingCopy.ClearHistoryFileFilterCommand}"
                              IsVisible="{Binding WorkingCopy.HasHistoryFileFilter}"
                              ToolTip.Tip="Clear filter">
                        <icons:MaterialIcon Kind="Close" Width="14" Height="14" />
                      </Button>
                    </Grid>
                  </DockPanel>
                </Border>

                <!-- Commit details dock (same slot as commit message on File Status) -->
                <Border DockPanel.Dock="Bottom" Padding="12"
                        Background="{DynamicResource ForgeSurfaceContainerLowestBrush}"
                        BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,1,0,0"
                        IsVisible="{Binding WorkingCopy.ShowCommitDetailsDock}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding WorkingCopy.SelectedCommitSubject}"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding WorkingCopy.SelectedCommitBody}"
                               FontSize="12" Opacity="0.8" TextWrapping="Wrap"
                               IsVisible="{Binding WorkingCopy.HasSelectedCommitBody}" />
                    <StackPanel Spacing="2" Margin="0,4,0,0">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Commit" Width="56" FontSize="11"
                                   Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                        <TextBlock Text="{Binding WorkingCopy.SelectedCommitOid}" FontSize="11"
                                   FontFamily="{DynamicResource ForgeCodeFont}" TextWrapping="Wrap" />
                      </DockPanel>
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Author" Width="56" FontSize="11"
                                   Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                        <TextBlock Text="{Binding WorkingCopy.SelectedCommitAuthor}" FontSize="11"
                                   TextWrapping="Wrap" />
                      </DockPanel>
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Date" Width="56" FontSize="11"
                                   Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                        <TextBlock Text="{Binding WorkingCopy.SelectedCommitDate}" FontSize="11"
                                   TextWrapping="Wrap" />
                      </DockPanel>
                      <DockPanel IsVisible="{Binding WorkingCopy.SelectedCommitDecorations, Converter={x:Static conv:ForgeConverters.IsNotNullOrEmpty}}">
                        <TextBlock DockPanel.Dock="Left" Text="Labels" Width="56" FontSize="11"
                                   Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                        <TextBlock Text="{Binding WorkingCopy.SelectedCommitDecorations}" FontSize="11"
                                   TextWrapping="Wrap" />
                      </DockPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <ListBox x:Name="HistoryFileList"
                         ItemsSource="{Binding WorkingCopy.HistoryFileEntries}"
                         SelectionMode="Single"
                         SelectionChanged="OnHistoryFileSelectionChanged"
                         Margin="8,8,8,12">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileListEntry">
                      <Panel>
                        <Border Padding="8,4" CornerRadius="4" Margin="{Binding IndentMargin}"
                                IsVisible="{Binding IsFolder}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:MaterialIcon Kind="{Binding IsExpanded, Converter={x:Static conv:ForgeConverters.ChevronKind}}"
                                                Width="14" Height="14" Opacity="0.7" />
                            <icons:MaterialIcon Kind="FolderOutline" Width="16" Height="16"
                                                Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                            <TextBlock Text="{Binding Label}" Classes="MonoPath" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Opacity="0.9" />
                          </StackPanel>
                        </Border>
                        <Border Padding="8,4" CornerRadius="4" Margin="{Binding IndentMargin}"
                                IsVisible="{Binding IsFile}">
                          <DockPanel>
                            <Border DockPanel.Dock="Right" CornerRadius="2" Padding="4,1" Margin="4,0,0,0"
                                    Background="{Binding File.Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBackground}}">
                              <TextBlock Text="{Binding File.StatusBadge}" FontSize="10" FontWeight="Bold"
                                         Foreground="{Binding File.Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBrush}}" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <icons:MaterialIcon Kind="FileDocument" Width="16" Height="16"
                                                  Foreground="{Binding File.Kind, Converter={x:Static conv:ForgeConverters.StatusBadgeBrush}}" />
                              <TextBlock Text="{Binding Label}" Classes="MonoPath" VerticalAlignment="Center"
                                         ToolTip.Tip="{Binding File.Path.Value}" />
                              <icons:MaterialIcon Kind="CheckCircleOutline" Width="12" Height="12"
                                                  Opacity="0.55" VerticalAlignment="Center"
                                                  Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}"
                                                  IsVisible="{Binding File.HasCachedDiff}"
                                                  ToolTip.Tip="Diff cached" />
                            </StackPanel>
                          </DockPanel>
                        </Border>
                      </Panel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="Padding" Value="0" />
                      <Setter Property="MinHeight" Value="32" />
                    </Style>
                  </ListBox.Styles>
                </ListBox>
              </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns"
                          Background="{DynamicResource ForgeOutlineVariantBrush}" />

            <!-- Diff (same bindings as File Status pane) -->
            <DockPanel Grid.Column="2" Background="{DynamicResource ForgeSurfaceContainerLowestBrush}">
              <Border DockPanel.Dock="Top" MinHeight="52" Padding="12,6"
                      Background="{DynamicResource ForgeSurfaceContainerLowBrush}"
                      BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="IconOnly"
                            Command="{Binding WorkingCopy.ForceRefreshDiffCommand}"
                            ToolTip.Tip="Refresh diff"
                            IsVisible="{Binding WorkingCopy.SelectedFile, Converter={x:Static conv:ForgeConverters.IsNotNull}}">
                      <icons:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                    </Button>
                    <Button Classes="ReviewAction"
                            Classes.Pressed="{Binding WorkingCopy.ShowFullFile}"
                            Command="{Binding WorkingCopy.ToggleShowFullFileCommand}"
                            ToolTip.Tip="{Binding WorkingCopy.FullFileToggleTooltip}">
                      <icons:MaterialIcon Kind="FileDocumentOutline" Width="18" Height="18" />
                    </Button>
                    <Button Classes="ReviewAction"
                            Classes.Pressed="{Binding WorkingCopy.ShowMarkdownPreview}"
                            Command="{Binding WorkingCopy.ToggleShowMarkdownPreviewCommand}"
                            IsVisible="{Binding WorkingCopy.CanShowMarkdownPreview}"
                            ToolTip.Tip="Rendered markdown">
                      <icons:MaterialIcon Kind="LanguageMarkdown" Width="18" Height="18" />
                    </Button>
                    <Border Width="1" Height="22" Margin="2,0"
                            Background="{DynamicResource ForgeOutlineVariantBrush}" />
                    <Button Classes="IconOnly" ToolTip.Tip="Diff options">
                      <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                          <MenuItem Header="Ignore whitespace"
                                    Command="{Binding WorkingCopy.ToggleIgnoreWhitespaceCommand}"
                                    ToggleType="CheckBox"
                                    IsChecked="{Binding WorkingCopy.IgnoreWhitespace, Mode=OneWay}" />
                          <MenuItem Header="Context"
                                    IsEnabled="{Binding WorkingCopy.ShowFullFile, Converter={x:Static conv:ForgeConverters.InvertBool}}">
                            <MenuItem Header="1"
                                      Command="{Binding WorkingCopy.SetContextLinesCommand}"
                                      CommandParameter="1"
                                      ToggleType="Radio"
                                      IsChecked="{Binding WorkingCopy.IsContextLines1, Mode=OneWay}" />
                            <MenuItem Header="3"
                                      Command="{Binding WorkingCopy.SetContextLinesCommand}"
                                      CommandParameter="3"
                                      ToggleType="Radio"
                                      IsChecked="{Binding WorkingCopy.IsContextLines3, Mode=OneWay}" />
                            <MenuItem Header="5"
                                      Command="{Binding WorkingCopy.SetContextLinesCommand}"
                                      CommandParameter="5"
                                      ToggleType="Radio"
                                      IsChecked="{Binding WorkingCopy.IsContextLines5, Mode=OneWay}" />
                            <MenuItem Header="10"
                                      Command="{Binding WorkingCopy.SetContextLinesCommand}"
                                      CommandParameter="10"
                                      ToggleType="Radio"
                                      IsChecked="{Binding WorkingCopy.IsContextLines10, Mode=OneWay}" />
                            <MenuItem Header="25"
                                      Command="{Binding WorkingCopy.SetContextLinesCommand}"
                                      CommandParameter="25"
                                      ToggleType="Radio"
                                      IsChecked="{Binding WorkingCopy.IsContextLines25, Mode=OneWay}" />
                          </MenuItem>
                          <Separator />
                          <MenuItem Header="Unified"
                                    Command="{Binding WorkingCopy.SetViewModeCommand}"
                                    CommandParameter="{x:Static core:DiffViewMode.Unified}"
                                    ToggleType="Radio"
                                    IsChecked="{Binding WorkingCopy.IsUnifiedView, Mode=OneWay}" />
                          <MenuItem Header="Side by side"
                                    Command="{Binding WorkingCopy.SetViewModeCommand}"
                                    CommandParameter="{x:Static core:DiffViewMode.SideBySide}"
                                    ToggleType="Radio"
                                    IsChecked="{Binding WorkingCopy.IsSideBySideView, Mode=OneWay}" />
                          <Separator />
                          <MenuItem Header="{Binding WorkingCopy.RevealInFileManagerLabel}"
                                    Command="{Binding WorkingCopy.RevealSelectedInFileManagerCommand}" />
                        </MenuFlyout>
                      </Button.Flyout>
                      <icons:MaterialIcon Kind="DotsHorizontal" Width="18" Height="18" />
                    </Button>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                              IsVisible="{Binding WorkingCopy.SelectedFile, Converter={x:Static conv:ForgeConverters.IsNotNull}}">
                    <icons:MaterialIcon Kind="FileDocument" Width="18" Height="18"
                                        VerticalAlignment="Top" Margin="0,2,0,0"
                                        Foreground="{DynamicResource ForgeStatusAddedBrush}" />
                    <StackPanel Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding WorkingCopy.SelectedFile.Path}" FontWeight="SemiBold"
                                   Classes="MonoPath" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding WorkingCopy.SelectedFileAbsolutePath}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <TextBlock Text="{Binding WorkingCopy.SelectedAddedLines, Converter={x:Static conv:ForgeConverters.PlusPrefix}}"
                                     FontSize="10" Foreground="{DynamicResource ForgeStatusAddedBrush}" />
                          <TextBlock Text="{Binding WorkingCopy.SelectedRemovedLines, Converter={x:Static conv:ForgeConverters.MinusPrefix}}"
                                     FontSize="10" Foreground="{DynamicResource ForgeStatusDeletedBrush}" />
                        </StackPanel>
                      </StackPanel>
                      <TextBlock Text="{Binding WorkingCopy.DiffFreshnessText}"
                                 FontSize="10"
                                 Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}"
                                 IsVisible="{Binding WorkingCopy.DiffFreshnessText, Converter={x:Static conv:ForgeConverters.IsNotNull}}" />
                    </StackPanel>
                  </StackPanel>
                </DockPanel>
              </Border>

              <Border DockPanel.Dock="Top"
                      IsVisible="{Binding WorkingCopy.ViewMode, Converter={x:Static conv:ForgeConverters.IsSideBySide}}"
                      Height="24" Background="{DynamicResource ForgeSurfaceContainerBrush}"
                      BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,*">
                  <TextBlock Grid.Column="0" Text="PREVIOUS VERSION" FontSize="10" FontWeight="Bold"
                             Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}"
                             VerticalAlignment="Center" Margin="12,0" />
                  <Border Grid.Column="1" BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="1,0,0,0">
                    <TextBlock Text="NEW VERSION" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource ForgePrimaryBrush}"
                               VerticalAlignment="Center" Margin="12,0" />
                  </Border>
                </Grid>
              </Border>

              <Border DockPanel.Dock="Bottom" Height="24" Padding="16,0"
                      Background="{DynamicResource ForgeSurfaceContainerBrush}"
                      BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Ellipse Width="8" Height="8" Fill="{DynamicResource ForgeStatusAddedBrush}" />
                  <TextBlock Text="{Binding WorkingCopy.DiffFooterText}" FontSize="10"
                             Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                </StackPanel>
              </Border>

              <Panel ClipToBounds="True">
                <controls:DiffViewer Rows="{Binding WorkingCopy.DiffRows}"
                                     ViewMode="{Binding WorkingCopy.ViewMode}"
                                     EmptyMessage="{Binding WorkingCopy.DiffEmptyMessage}"
                                     CanStageLines="False"
                                     CanUnstageLines="False"
                                     CanDiscardLines="False"
                                     LeftSyntaxTokens="{Binding WorkingCopy.LeftSyntaxTokens}"
                                     RightSyntaxTokens="{Binding WorkingCopy.RightSyntaxTokens}"
                                     RowHeight="20"
                                     IsVisible="{Binding WorkingCopy.ShowDiffViewer}" />
                <controls:MarkdownFilePreview Markdown="{Binding WorkingCopy.MarkdownPreviewText}"
                                              EmptyMessage="{Binding WorkingCopy.MarkdownPreviewEmptyMessage}"
                                              CanAddLineComments="False"
                                              IsVisible="{Binding WorkingCopy.ShowMarkdownPreviewPane}" />
                <Border Background="{DynamicResource ForgeSettingsScrimBrush}"
                        IsVisible="{Binding WorkingCopy.IsLoadingDiff}">
                  <ProgressBar Width="36" Height="36" IsIndeterminate="True"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding WorkingCopy.DiffOverlayMessage}"
                           IsVisible="{Binding WorkingCopy.DiffOverlayMessage, Converter={x:Static conv:ForgeConverters.IsNotNullOrEmpty}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="14" Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
              </Panel>
            </DockPanel>
          </Grid>
        </Grid>
      </Grid>
    </DockPanel>

    <!-- Notifications overlay (does not affect layout) -->
    <ItemsControl ItemsSource="{Binding Notifications.Notifications}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="12,0,12,36" MaxWidth="360" ZIndex="100">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="svc:AppNotification">
          <Border Background="{DynamicResource ForgeSurfaceContainerHighBrush}"
                  BorderBrush="{DynamicResource ForgeOutlineVariantBrush}"
                  BorderThickness="1" Padding="12,8" Margin="0,0,0,4" CornerRadius="4">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="IconOnly" Width="22" Height="22" Padding="2"
                      ToolTip.Tip="Dismiss"
                      Click="OnNotificationDismiss" Tag="{Binding}" Margin="4,0,0,0">
                <icons:MaterialIcon Kind="Close" Width="14" Height="14" />
              </Button>
              <Button DockPanel.Dock="Right" Classes="IconOnly" Width="22" Height="22" Padding="2"
                      ToolTip.Tip="Copy error"
                      IsVisible="{Binding IsError}"
                      Click="OnNotificationCopy" Tag="{Binding}" Margin="4,0,0,0">
                <icons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
              </Button>
              <Button DockPanel.Dock="Right" Classes="Link"
                      Content="{Binding ActionLabel}"
                      IsVisible="{Binding ActionLabel, Converter={x:Static conv:ForgeConverters.IsNotNullOrEmpty}}"
                      Click="OnNotificationAction" Tag="{Binding}" Margin="8,0,0,0" />
              <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                         Foreground="{DynamicResource ForgeOnSurfaceBrush}" FontSize="12"
                         VerticalAlignment="Center" />
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Settings overlay -->
    <Border IsVisible="{Binding ShowSettings}" Background="{DynamicResource ForgeSettingsScrimBrush}" ZIndex="200">
      <Border Width="780" HorizontalAlignment="Right" Background="{DynamicResource ForgeSurfaceContainerLowBrush}"
              BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="1,0,0,0">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="20,16,20,12">
            <Button DockPanel.Dock="Right" Classes="IconOnly" Command="{Binding CloseSettingsCommand}">
              <icons:MaterialIcon Kind="Close" Width="18" Height="18" />
            </Button>
            <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>

          <Grid ColumnDefinitions="180,*" Margin="12,0,12,16">
            <!-- Category sidebar -->
            <Border Grid.Column="0" Margin="0,0,12,0"
                    Background="{DynamicResource ForgeSurfaceContainerBrush}"
                    CornerRadius="8" Padding="6">
              <ListBox ItemsSource="{Binding SettingsCategories}"
                       SelectedItem="{Binding SelectedSettingsCategory}"
                       Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" Margin="8,6" FontSize="13" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>

            <!-- Category content -->
            <Border Grid.Column="1" Background="{DynamicResource ForgeSurfaceContainerBrush}"
                    CornerRadius="8" Padding="16">
              <Panel>
                <!-- General -->
                <ScrollViewer IsVisible="{Binding IsSettingsGeneral}" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                      <TextBlock Text="DEVELOPMENT" Classes="PanelHeader" Opacity="0.7" />
                      <TextBox Classes="Forge" Text="{Binding DevelopmentFolder}"
                               PlaceholderText="Development folder path" />
                      <TextBlock Text="Local clones are discovered under this folder when opening pull requests."
                                 FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                      <TextBlock Text="THEME" Classes="PanelHeader" Opacity="0.7" />
                      <ComboBox SelectedItem="{Binding Theme}" HorizontalAlignment="Stretch">
                        <x:String>System</x:String>
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                      </ComboBox>
                    </StackPanel>
                    <Button Classes="Ghost" Content="Open Repository…" Click="OnOpenRepository"
                            HorizontalAlignment="Left" />
                  </StackPanel>
                </ScrollViewer>

                <!-- Accounts -->
                <Grid IsVisible="{Binding IsSettingsAccounts}" ColumnDefinitions="220,*" ColumnSpacing="12">
                  <DockPanel Grid.Column="0">
                    <Button DockPanel.Dock="Bottom" Classes="Primary" Content="Add Account"
                            Command="{Binding BeginAddGitHubAccountCommand}"
                            HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                    <Panel>
                      <TextBlock Text="No accounts yet.&#x0a;Add a GitHub account to review pull requests."
                                 IsVisible="{Binding HasGitHubAccounts, Converter={x:Static conv:ForgeConverters.InvertBool}}"
                                 TextWrapping="Wrap" FontSize="12" Opacity="0.65"
                                 VerticalAlignment="Center" HorizontalAlignment="Center"
                                 TextAlignment="Center" Margin="8" />
                      <ListBox ItemsSource="{Binding GitHubAccounts}"
                               SelectedItem="{Binding SelectedGitHubAccount}"
                               IsVisible="{Binding HasGitHubAccounts}"
                               Background="Transparent">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="core:GitHubAccountSettings">
                            <StackPanel Spacing="2" Margin="6,4">
                              <TextBlock Text="{Binding Login}" FontWeight="SemiBold" FontSize="13" />
                              <TextBlock Text="{Binding Host}" FontSize="11" Opacity="0.65" />
                            </StackPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </Panel>
                  </DockPanel>

                  <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
                    <Panel>
                      <!-- Add form -->
                      <StackPanel Spacing="10" IsVisible="{Binding ShowAddAccountForm}">
                        <TextBlock Text="Add GitHub Account" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Paste a personal access token. It is stored in the OS keychain; only the account identity is saved in settings."
                                   FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
                        <TextBox Classes="Forge" Text="{Binding NewGitHubHost}" PlaceholderText="Host (github.com)" />
                        <TextBox Classes="Forge" Text="{Binding NewGitHubToken}" PasswordChar="•"
                                 PlaceholderText="Personal access token" />
                        <Button Classes="Primary" Content="Add GitHub account"
                                Command="{Binding AddGitHubAccountCommand}" HorizontalAlignment="Left" />

                        <StackPanel Spacing="4" Margin="0,16,0,0">
                          <TextBlock Text="ENTERPRISE HOSTS" Classes="PanelHeader" Opacity="0.7" />
                          <TextBox Classes="Forge" Text="{Binding NewEnterpriseHost}"
                                   PlaceholderText="https://github.example.com" />
                          <Button Classes="Ghost" Content="Add enterprise host"
                                  Command="{Binding AddEnterpriseHostCommand}" HorizontalAlignment="Left" />
                          <ItemsControl ItemsSource="{Binding EnterpriseHostUrls}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <DockPanel Margin="0,2">
                                  <Button DockPanel.Dock="Right" Classes="Ghost" Content="Remove"
                                          Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).RemoveEnterpriseHostCommand}"
                                          CommandParameter="{Binding}" FontSize="11" />
                                  <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" />
                                </DockPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </StackPanel>

                      <!-- Selected account detail -->
                      <StackPanel Spacing="10" IsVisible="{Binding ShowAccountDetail}">
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Classes="Ghost" Content="Remove"
                                  Command="{Binding RemoveGitHubAccountCommand}"
                                  CommandParameter="{Binding SelectedGitHubAccount}" />
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding SelectedGitHubAccount.Login}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedGitHubAccount.Host}" FontSize="12" Opacity="0.65" />
                          </StackPanel>
                        </DockPanel>

                        <Border Padding="10" Background="{DynamicResource ForgeBannerBrush}" CornerRadius="6"
                                IsVisible="{Binding SelectedGitHubAccount.NeedsReauth}">
                          <StackPanel Spacing="6">
                            <TextBlock Text="Token expired — paste a new token to re-authenticate." FontSize="11" />
                            <TextBox Classes="Forge" Text="{Binding ReauthToken}"
                                     PasswordChar="•" PlaceholderText="New personal access token" />
                            <Button Classes="Primary" Content="Re-authenticate"
                                    Command="{Binding ReauthGitHubAccountCommand}"
                                    CommandParameter="{Binding SelectedGitHubAccount}"
                                    HorizontalAlignment="Left" />
                          </StackPanel>
                        </Border>

                        <Border Padding="10" CornerRadius="6"
                                Background="{DynamicResource ForgeSurfaceContainerLowBrush}"
                                IsVisible="{Binding SelectedGitHubAccount.NeedsReauth, Converter={x:Static conv:ForgeConverters.InvertBool}}">
                          <TextBlock Text="This account is authenticated. Tokens stay in the OS keychain."
                                     FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Spacing="4" Margin="0,12,0,0">
                          <TextBlock Text="ENTERPRISE HOSTS" Classes="PanelHeader" Opacity="0.7" />
                          <TextBox Classes="Forge" Text="{Binding NewEnterpriseHost}"
                                   PlaceholderText="https://github.example.com" />
                          <Button Classes="Ghost" Content="Add enterprise host"
                                  Command="{Binding AddEnterpriseHostCommand}" HorizontalAlignment="Left" />
                          <ItemsControl ItemsSource="{Binding EnterpriseHostUrls}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <DockPanel Margin="0,2">
                                  <Button DockPanel.Dock="Right" Classes="Ghost" Content="Remove"
                                          Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).RemoveEnterpriseHostCommand}"
                                          CommandParameter="{Binding}" FontSize="11" />
                                  <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" />
                                </DockPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </StackPanel>
                    </Panel>
                  </ScrollViewer>
                </Grid>

                <!-- Diff -->
                <ScrollViewer IsVisible="{Binding IsSettingsDiff}" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                      <TextBlock Text="DEFAULT DIFF MODE" Classes="PanelHeader" Opacity="0.7" />
                      <ComboBox SelectedItem="{Binding DefaultDiffMode}" HorizontalAlignment="Stretch">
                        <core:DiffViewMode>SideBySide</core:DiffViewMode>
                        <core:DiffViewMode>Unified</core:DiffViewMode>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Spacing="4">
                      <TextBlock Text="DIFF OPTIONS" Classes="PanelHeader" Opacity="0.7" />
                      <CheckBox Content="Ignore whitespace changes"
                                IsChecked="{Binding WorkingCopy.IgnoreWhitespace}" />
                      <StackPanel Orientation="Horizontal" Spacing="8"
                                  IsEnabled="{Binding WorkingCopy.ShowFullFile, Converter={x:Static conv:ForgeConverters.InvertBool}}">
                        <TextBlock Text="Context lines" VerticalAlignment="Center" FontSize="12" />
                        <ComboBox ItemsSource="{Binding WorkingCopy.ContextLineOptions}"
                                  SelectedIndex="{Binding WorkingCopy.ContextLinesIndex}"
                                  MinWidth="72" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>

                <!-- Git -->
                <ScrollViewer IsVisible="{Binding IsSettingsGit}" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="8">
                    <TextBlock Text="GIT" Classes="PanelHeader" Opacity="0.7" />
                    <TextBlock Text="{Binding Diagnostics.GitPath, StringFormat=Path: {0}}" FontSize="12"
                               FontFamily="{DynamicResource ForgeCodeFont}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Diagnostics.GitVersion, StringFormat=Version: {0}}" FontSize="12" />
                  </StackPanel>
                </ScrollViewer>

                <!-- AI -->
                <ScrollViewer IsVisible="{Binding IsSettingsAi}" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="12">
                    <TextBlock Text="AI" Classes="PanelHeader" Opacity="0.7" />
                    <CheckBox Content="Enable AI assistance" IsChecked="{Binding AiAssistanceEnabled}" />
                    <StackPanel Spacing="12" IsEnabled="{Binding AiAssistanceEnabled}">
                      <Border Background="{DynamicResource ForgeSurfaceContainerBrush}" CornerRadius="6" Padding="10"
                              IsVisible="{Binding AiDisclosureAcknowledged, Converter={x:Static conv:ForgeConverters.InvertBool}}">
                        <StackPanel Spacing="6">
                          <TextBlock Text="AI review sends PR file contents to GitHub Copilot for analysis. Review and acknowledge before enabling."
                                     FontSize="12" TextWrapping="Wrap" />
                          <CheckBox Content="I understand and acknowledge" IsChecked="{Binding AiDisclosureAcknowledged}" />
                        </StackPanel>
                      </Border>

                      <CheckBox Content="Use dedicated Copilot token (separate from GitHub account)"
                                IsChecked="{Binding AiUseDedicatedCopilotToken}" />

                      <StackPanel Spacing="4">
                        <TextBlock Text="Model override" FontSize="12" Opacity="0.7" />
                        <ComboBox ItemsSource="{Binding AiAvailableModels}"
                                  SelectedItem="{Binding AiModelOverride}"
                                  HorizontalAlignment="Stretch" />
                      </StackPanel>

                      <StackPanel Spacing="4">
                        <TextBlock Text="Reasoning effort" FontSize="12" Opacity="0.7" />
                        <ComboBox ItemsSource="{Binding AiReasoningEffortOptions}"
                                  SelectedItem="{Binding AiReasoningEffort}"
                                  HorizontalAlignment="Stretch" />
                      </StackPanel>

                      <StackPanel Spacing="4">
                        <TextBlock Text="Review rules / instructions" FontSize="12" Opacity="0.7" />
                        <TextBox Text="{Binding AiReviewRules}" AcceptsReturn="True" MinHeight="80"
                                 TextWrapping="Wrap" />
                      </StackPanel>

                      <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Spacing="4">
                          <TextBlock Text="Turn budget" FontSize="12" Opacity="0.7" />
                          <NumericUpDown Value="{Binding AiTurnBudget}" Minimum="1" Width="120" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                          <TextBlock Text="Turn timeout (s)" FontSize="12" Opacity="0.7" />
                          <NumericUpDown Value="{Binding AiTurnTimeoutSeconds}" Minimum="1" Width="120" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                          <TextBlock Text="Run timeout (s)" FontSize="12" Opacity="0.7" />
                          <NumericUpDown Value="{Binding AiRunTimeoutSeconds}" Minimum="1" Width="120" />
                        </StackPanel>
                      </StackPanel>

                      <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Spacing="4">
                          <TextBlock Text="Export retention (days)" FontSize="12" Opacity="0.7" />
                          <NumericUpDown Value="{Binding AiExportRetentionDays}" Minimum="1" Width="120" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                          <TextBlock Text="Large PR file threshold" FontSize="12" Opacity="0.7" />
                          <NumericUpDown Value="{Binding AiLargePrFileThreshold}" Minimum="1" Width="120" />
                        </StackPanel>
                      </StackPanel>

                      <StackPanel Spacing="4">
                        <TextBlock Text="Path denylist (one glob per line)" FontSize="12" Opacity="0.7" />
                        <TextBox Text="{Binding AiPathDenylistText}" AcceptsReturn="True" MinHeight="60"
                                 TextWrapping="Wrap" FontFamily="{DynamicResource ForgeCodeFont}" />
                      </StackPanel>

                      <StackPanel Spacing="4">
                        <TextBlock Text="Excluded repositories (one owner/repo per line)" FontSize="12" Opacity="0.7" />
                        <TextBox Text="{Binding AiExcludedRepositoriesText}" AcceptsReturn="True" MinHeight="60"
                                 TextWrapping="Wrap" FontFamily="{DynamicResource ForgeCodeFont}" />
                      </StackPanel>

                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Test connection" Command="{Binding TestAiConnectionCommand}"
                                IsEnabled="{Binding IsTestingAiConnection, Converter={x:Static conv:ForgeConverters.InvertBool}}" />
                        <Button Content="Refresh models" Command="{Binding RefreshAiModelsCommand}"
                                IsEnabled="{Binding IsRefreshingAiModels, Converter={x:Static conv:ForgeConverters.InvertBool}}" />
                      </StackPanel>
                      <TextBlock Text="{Binding AiConnectionTestResult}" FontSize="12" TextWrapping="Wrap"
                                 IsVisible="{Binding AiConnectionTestResult, Converter={x:Static conv:ForgeConverters.IsNotNullOrEmpty}}" />

                      <Border Height="1" Background="{DynamicResource ForgeOutlineVariantBrush}" Margin="0,4" />

                      <Button Content="Clear all AI data" Classes="Ghost" HorizontalAlignment="Left"
                              Command="{Binding ClearAiDataCommand}"
                              IsEnabled="{Binding IsClearingAiData, Converter={x:Static conv:ForgeConverters.InvertBool}}" />
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>

                <!-- Diagnostics -->
                <ScrollViewer IsVisible="{Binding IsSettingsDiagnostics}" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="12">
                    <TextBlock Text="DIAGNOSTICS" Classes="PanelHeader" Opacity="0.7" />
                    <CheckBox Content="Simulate slow Git (1–5s delay)"
                              IsChecked="{Binding SimulateSlowGit}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="Diff prefetch concurrency" VerticalAlignment="Center" FontSize="12" />
                      <ComboBox ItemsSource="{Binding DiffPrefetchConcurrencyOptions}"
                                SelectedIndex="{Binding DiffPrefetchConcurrencyIndex}"
                                MinWidth="56" />
                    </StackPanel>
                    <TextBlock Text="{Binding Diagnostics.Summary}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                    <ItemsControl ItemsSource="{Binding Diagnostics.LastTimings}" MaxHeight="220">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding}" FontSize="10"
                                     FontFamily="{DynamicResource ForgeCodeFont}"
                                     Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </Panel>
            </Border>
          </Grid>
        </DockPanel>
      </Border>
    </Border>

    <!-- AI instructions dialog -->
    <Border IsVisible="{Binding Review.ShowAiInstructionsDialog}"
            Background="{DynamicResource ForgeSettingsScrimBrush}" ZIndex="210">
      <Border Width="480" MaxHeight="360" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource ForgeSurfaceContainerLowBrush}"
              BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="1"
              CornerRadius="10" Padding="16">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <icons:MaterialIcon Kind="Creation" Width="18" Height="18"
                                Foreground="{DynamicResource ForgeAiAccentBrush}" />
            <TextBlock Text="Start AI review" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                      HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Classes="Ghost" Command="{Binding Review.CancelAiInstructionsCommand}" />
            <Button Content="Start review" Classes="Primary" Command="{Binding Review.ConfirmStartAiReviewCommand}" />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Text="Optional instructions for this review (focus areas, concerns, etc.)"
                       FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
            <TextBox Text="{Binding Review.AiAdHocInstructions}" AcceptsReturn="True" MinHeight="100"
                     TextWrapping="Wrap" PlaceholderText="e.g. Pay close attention to the auth changes…" />
          </StackPanel>
        </DockPanel>
      </Border>
    </Border>

    <!-- AI progress / status overlay (dismissible; does not cancel the background run) -->
    <Border IsVisible="{Binding Review.ShowAiProgressDialog}"
            Background="{DynamicResource ForgeSettingsScrimBrush}" ZIndex="211">
      <Border Width="440" MaxHeight="420" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource ForgeSurfaceContainerLowBrush}"
              BorderBrush="{DynamicResource ForgeOutlineVariantBrush}" BorderThickness="1"
              CornerRadius="10" Padding="20">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Classes="IconOnly" Width="24" Height="24" Padding="3"
                    ToolTip.Tip="Close (review continues in the background)"
                    Command="{Binding Review.DismissAiProgressDialogCommand}">
              <icons:MaterialIcon Kind="Close" Width="14" Height="14" />
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <icons:MaterialIcon Kind="Creation" Width="18" Height="18"
                                  Foreground="{DynamicResource ForgeAiAccentBrush}" />
              <TextBlock Text="{Binding Review.AiStatusDialogTitle}" FontSize="14" FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </StackPanel>
          </DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                      HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel review" Classes="Ghost"
                    IsVisible="{Binding Review.IsAiRunActive}"
                    Command="{Binding Review.CancelAiReviewCommand}" />
            <Button Content="Close" Classes="Primary"
                    Command="{Binding Review.DismissAiProgressDialogCommand}" />
          </StackPanel>
          <StackPanel Spacing="10">
            <ProgressBar IsIndeterminate="True" Height="4"
                         IsVisible="{Binding Review.IsAiRunActive}" />
            <SelectableTextBlock Text="{Binding Review.AiProgressText}" FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
            <SelectableTextBlock Text="{Binding Review.AiLastError}" FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding Review.AiLastError, Converter={x:Static conv:ForgeConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource ForgeErrorBrush}" />
            <Border IsVisible="{Binding Review.HasAiDiagnostics}"
                    Background="{DynamicResource ForgeSurfaceContainerBrush}"
                    CornerRadius="6" Padding="10" Margin="0,4,0,0">
              <SelectableTextBlock Text="{Binding Review.AiDiagnosticsText}" FontSize="11"
                         FontFamily="Menlo, Consolas, monospace"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource ForgeOnSurfaceVariantBrush}" />
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>
    </Border>
  </Panel>
</Window>
